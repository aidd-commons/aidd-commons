---
import AssayResultExplorer from "../../components/AssayResultExplorer.astro";
import LabExplorer from "../../components/LabExplorer.astro";
import SiteShell from "../../components/SiteShell.astro";
import { buildLabDiscovery } from "../../lib/lab-discovery.js";
import { siteOverview } from "../../lib/site-overview.js";
const labs = buildLabDiscovery(siteOverview.labs.guides);
---

<SiteShell title="Labs" description="Choose an AIDD exercise, inspection, fresh local computation or completed evaluation by its inputs and execution mode.">
  <section class="page-header" aria-labelledby="labs-title">
    <p class="eyebrow">Practise · inspect · reproduce</p>
    <h1 id="labs-title" class="page-heading">Labs</h1>
    <p class="page-intro">Start with your question and the inputs you have. Each guide names its execution mode, inputs and boundaries before its commands; completed evaluations stay separate from fresh exercise outputs.</p>
    <nav class="labs-entry-links" aria-label="Laboratory entry routes">
      <a data-lab-language href="/zh-cn/labs/">中文实验索引</a>
      <a href="/learn/foundations/first-session/">Your first session →</a>
      <a href="#browse-labs-title">Find a laboratory guide</a>
    </nav>
  </section>
  <AssayResultExplorer />
  <LabExplorer labs={labs} chinese={false} />
</SiteShell>

<style>
  .labs-entry-links { display: flex; flex-wrap: wrap; gap: 0 1.25rem; font-size: .85rem; }
  .labs-entry-links a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
