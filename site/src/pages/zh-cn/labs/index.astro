---
import AssayResultExplorer from "../../../components/AssayResultExplorer.astro";
import LabExplorer from "../../../components/LabExplorer.astro";
import SiteShell from "../../../components/SiteShell.astro";
import { buildLabDiscovery } from "../../../lib/lab-discovery.js";
import { siteOverview } from "../../../lib/site-overview.js";
const labs = buildLabDiscovery(siteOverview.labs.guides);
---

<SiteShell lang="zh-CN" title="实验室" description="按执行模式和输入选择 AIDD 练习、材料检查、独立重算或已完成评估。">
  <section class="page-header" aria-labelledby="labs-title">
    <p class="eyebrow">实践 · 检查 · 本地重算</p>
    <h1 id="labs-title" class="page-heading">实验室</h1>
    <p class="page-intro">从你要回答的问题与已有的输入开始。每份指南先说明执行模式、输入与边界，再给出命令；已有冻结评估与新的练习结果分开。</p>
    <nav class="labs-entry-links" aria-label="实验指南入口">
      <a data-lab-language href="/labs/">English canonical index</a>
      <a href="/zh-cn/learn/foundations/first-session/">第一次学习 →</a>
      <a href="#browse-labs-title">查找实验指南</a>
    </nav>
  </section>
  <AssayResultExplorer chinese />
  <LabExplorer labs={labs} chinese={true} />
</SiteShell>

<style>
  .labs-entry-links { display: flex; flex-wrap: wrap; gap: 0 1.25rem; font-size: .85rem; }
  .labs-entry-links a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
