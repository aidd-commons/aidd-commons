---
import FigureDetail from '../../../../components/FigureDetail.astro';
import SiteShell from '../../../../components/SiteShell.astro';
import manifest from '../../../../data/atlas-figures.json';
export function getStaticPaths(){return manifest.library.map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;
---
<SiteShell title={`图 ${entry.reportNumber}：${entry.title}`} description={entry.alt} lang="zh-CN"><FigureDetail id={entry.id} chinese/></SiteShell>
