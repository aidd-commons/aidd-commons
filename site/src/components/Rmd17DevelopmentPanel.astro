---
import developmentSummary from "../../../labs/rmd17_system_state/development-summary.json";
import { validateRmd17DevelopmentSummary } from "../lib/rmd17-development-summary.js";
import ScientificPlot from "./ScientificPlot.astro";

const summary = validateRmd17DevelopmentSummary(developmentSummary);
const developmentSystemIds = Object.keys(summary.development_evaluation);
const systemCards = Object.entries(summary.systems);
const lockedSystems = Object.entries(summary.locked_evaluations);
const partitionOrder = ["train", "validation", "evaluation"];
const partitions = partitionOrder.map((name) => ({
  name,
  count: summary.split.partitions[name],
}));
const totalPartitionFrames = partitions.reduce(
  (total, partition) => total + partition.count,
  0,
);
const metricRows = developmentSystemIds.map((systemId) => ({
  systemId,
  ...summary.development_evaluation[systemId],
}));
const selectedValidation =
  summary.selection.validation_grid.find(
    (entry) => entry.alpha === summary.selection.selected_alpha,
  );
const ordinaryBinCount = summary.features.bins_per_channel - 1;
const overflowBinCount = summary.features.bins_per_channel - ordinaryBinCount;
if (selectedValidation === undefined) {
  throw new Error("Selected rMD17 alpha is absent from the validation grid");
}
if (totalPartitionFrames !== summary.split.selected_frames) {
  throw new Error("rMD17 partition counts do not match selected_frames");
}
const observedRidgeImprovement = metricRows.every(
  (row) => row.ridge.mae < row.train_mean.mae,
);
const pretestStatus =
  summary.artifact_type === "reviewed-development-summary"
    ? "Development pretest passed"
    : "Development pretest status unavailable";
const formatMetric = (value: number) => value.toFixed(3);
const formatGap = (value: number) => value.toLocaleString("en-US");
const formatSystemStatus = (systemId: string, status: string) =>
  summary.locked_evaluations[systemId] === status
    ? status
    : status.replaceAll("_", " ");
const claimRows = [
  {
    boundary: "Observed",
    claim: observedRidgeImprovement
      ? "Ridge has lower within-system evaluation MAE than the train mean for both development systems."
      : "The reviewed development summary does not support a Ridge improvement claim for every development system.",
    scope: `Descriptive development evidence only (n=${developmentSystemIds.length}).`,
  },
  {
    boundary: "Absent at development freeze",
    claim: "The historical development summary contains no benzene or uracil metrics; their completed scores are reported in the companion lab.",
    scope: lockedSystems
      .map(([systemId, status]) => `${systemId}: ${status}`)
      .join(" · "),
  },
  {
    boundary: "Unsupported",
    claim: "Cross-system generalization, a molecule-wide ranking, and a SOTA claim are not established here.",
    scope: "The public development slice does not identify an independent external comparison.",
  },
];
---

<section
  class="rmd17-panel"
  aria-labelledby="rmd17-panel-title"
  data-rmd17-development-panel
>
  <header class="rmd17-panel__header">
    <div>
      <p class="rmd17-panel__eyebrow">Reviewed development evidence</p>
      <h2 id="rmd17-panel-title">rMD17 development evidence</h2>
      <p>
        A system-state baseline keeps molecule-specific feature spaces separate.
        One validation rule selects a shared regularisation value; it does not
        create a shared molecular model.
      </p>
    </div>
    <ul class="rmd17-panel__status" aria-label="Status at development freeze">
      <li class="rmd17-panel__status-item rmd17-panel__status-item--observed">
        <span aria-hidden="true">●</span>{pretestStatus}
      </li>
      <li class="rmd17-panel__status-item rmd17-panel__status-item--boundary">
        <span aria-hidden="true">●</span>{lockedSystems.length} evaluations were absent at development freeze
      </li>
    </ul>
  </header>

  <div class="rmd17-panel__body">
    <section aria-labelledby="rmd17-systems-title">
      <div class="rmd17-panel__section-heading">
        <p>01 / System states</p>
        <h3 id="rmd17-systems-title">Named systems across development and locked surfaces</h3>
      </div>
      <ul class="rmd17-panel__system-grid" aria-label="System evaluation states">
        {
          systemCards.map(([systemId, status]) => (
            <li>
              <strong>{systemId}</strong>
              <span>{formatSystemStatus(systemId, status)}</span>
              <p>
                {developmentSystemIds.includes(systemId)
                  ? "Within-system development evaluation is complete."
                  : "Historical pre-evaluation state; completed scores are reported in the companion lab."}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="rmd17-split-title">
      <div class="rmd17-panel__section-heading">
        <p>02 / Ordered development split</p>
        <h3 id="rmd17-split-title">Training, validation, then evaluation</h3>
      </div>
      <ol class="rmd17-panel__timeline">
        {
          partitions.map((partition, index) => (
            <li style={`flex: ${partition.count}`}>
              <span>Stage {index + 1}</span>
              <strong>{partition.count.toLocaleString("en-US")}</strong>
              <span>{partition.name}</span>
            </li>
          ))
        }
      </ol>
      <p class="rmd17-panel__note">
        {totalPartitionFrames.toLocaleString("en-US")} selected frames per development system are ordered by original index.
        This preserves an ordering cue but does not remove time correlation or create independent samples.
      </p>
    </section>

    <section aria-labelledby="rmd17-features-title">
      <div class="rmd17-panel__section-heading">
        <p>03 / State to pair histogram</p>
        <h3 id="rmd17-features-title">Feature construction stays inside each system</h3>
      </div>
      <ol class="rmd17-panel__construction">
        <li>
          <span>State</span>
          <strong>nuclear charges + coordinates</strong>
        </li>
        <li>
          <span>Pairs</span>
          <strong>{summary.features.construction}</strong>
        </li>
        <li>
          <span>Histogram</span>
          <strong>
            {ordinaryBinCount} ordinary bins using {summary.features.distance_bin_width_angstrom} Å widths + {overflowBinCount} overflow bin
          </strong>
        </li>
      </ol>
      <ul class="rmd17-panel__feature-grid" aria-label="Per-system feature layouts">
        {
          Object.entries(summary.features.by_system).map(([systemId, feature]) => (
            <li>
              <h4>{systemId}</h4>
              <p>
                <strong>{feature.channel_count}</strong> pair channels · <strong>{feature.feature_dimension}</strong> features
              </p>
              <code>{feature.element_pair_channels.join(" · ")}</code>
              <div class="rmd17-panel__channel-layout" role="img" aria-label={`${systemId}: ${feature.channel_count} channels, each with ${ordinaryBinCount} ordinary bins and ${overflowBinCount} overflow bin; layout only, no bin heights shown`}>
                {feature.element_pair_channels.map(channel => <div><span>{channel}</span><i style={`--bin-count:${summary.features.bins_per_channel}`}><b /></i></div>)}
              </div>
            </li>
          ))
        }
      </ul>
      <p class="rmd17-panel__note">Each lane is a channel layout, not observed histogram heights. Fine divisions denote {ordinaryBinCount} ordinary bins; the outlined terminal bin retains overflow. The channel count changes with the system's element composition.</p>
    </section>

    <section aria-labelledby="rmd17-selection-title">
      <div class="rmd17-panel__section-heading">
        <p>04 / Validation-selected regularisation</p>
        <h3 id="rmd17-selection-title">Shared alpha, independently fit system models</h3>
      </div>
      <div class="rmd17-panel__selection-callout">
        <span>Selected alpha</span>
        <strong>alpha {summary.selection.selected_alpha}</strong>
        <p>
          Validation MAE scalars are aggregated for selection. Coefficients,
          scalers, and feature dimensions remain system-specific.
        </p>
      </div>
      <ScientificPlot title="rMD17: complete frozen validation grid" xLabel="log10(alpha) · −3 to 3 means 0.001 to 1000" yLabel="Validation MAE · kcal/mol · lower is better" xMin={-3} xMax={3} xTicks={[-3,-2,-1,0,1,2,3]} yMin={2.5} yMax={3.2} yTicks={[2.5,2.7,2.9,3.1,3.2]} showTable={false} series={[{name:"Median validation MAE",color:"var(--atlas-teal-deep)",marker:0,points:summary.selection.validation_grid.map(entry=>({x:Math.log10(entry.alpha),y:entry.median_validation_mae,label:entry.alpha===summary.selection.selected_alpha?"selected":undefined}))},...developmentSystemIds.map((systemId,index)=>({name:systemId,color:"var(--atlas-muted)",marker:index+1,dashed:true,points:summary.selection.validation_grid.map(entry=>({x:Math.log10(entry.alpha),y:entry.per_system_validation_mae[systemId]}))}))]} />
      <p class="rmd17-panel__note">The point-and-line axis spans 2.5–3.2 kcal/mol. All frozen alpha values and both development systems are shown; the median combines system-level validation scalars.</p>
      <details class="rmd17-panel__grid-table"><summary>Exact frozen validation grid</summary><div class="rmd17-panel__table-wrap" role="region" aria-label="Every rMD17 validation alpha and system score" tabindex="0"><table><caption>MAE in kcal/mol; no settings or systems omitted.</caption><thead><tr><th scope="col">Alpha</th>{developmentSystemIds.map(system=><th scope="col">{system}</th>)}<th scope="col">Median</th></tr></thead><tbody>{summary.selection.validation_grid.map(entry=><tr><th scope="row">{entry.alpha}</th>{developmentSystemIds.map(system=><td>{entry.per_system_validation_mae[system].toFixed(6)}</td>)}<td>{entry.median_validation_mae.toFixed(6)}</td></tr>)}</tbody></table></div></details>
      <div
        class="rmd17-panel__table-wrap"
        role="region"
        aria-label="Development model evaluation metrics"
        tabindex="0"
      >
        <table>
          <caption>Within-system development evaluation; errors and target ranges in kcal/mol. Lower error is better.</caption>
          <thead>
            <tr>
              <th scope="col">System</th>
              <th scope="col">Target range</th>
              <th scope="col">Train mean MAE</th>
              <th scope="col">Train mean RMSE</th>
              <th scope="col">Ridge MAE</th>
              <th scope="col">Ridge RMSE</th>
            </tr>
          </thead>
          <tbody>
            {
              metricRows.map((row) => (
                <tr>
                  <th scope="row">{row.systemId}</th>
                  <td>{formatMetric(row.ridge.target_range)}</td>
                  <td>{formatMetric(row.train_mean.mae)}</td>
                  <td>{formatMetric(row.train_mean.rmse)}</td>
                  <td>{formatMetric(row.ridge.mae)}</td>
                  <td>{formatMetric(row.ridge.rmse)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <ul class="rmd17-panel__aggregate-grid" aria-label="Aggregate development MAE">
        {
          Object.entries(summary.aggregates).map(([modelName, aggregate]) => (
            <li>
              <span>{modelName.replaceAll("_", " ")}</span>
              <strong>Median MAE {formatMetric(aggregate.median_mae)}</strong>
              <p>MAE range {formatMetric(aggregate.mae_range)}</p>
            </li>
          ))
        }
      </ul>
      <p class="rmd17-panel__note">
        Selected-alpha validation MAE: {Object.entries(selectedValidation.per_system_validation_mae)
          .map(([systemId, value]) => `${systemId} ${formatMetric(value)}`)
          .join(" · ")}
        .
      </p>
    </section>

    <section aria-labelledby="rmd17-ordering-title">
      <div class="rmd17-panel__section-heading">
        <p>05 / Aggregate ordering diagnostics</p>
        <h3 id="rmd17-ordering-title">Original-index spacing is summarized, not released as membership</h3>
      </div>
      <ul class="rmd17-panel__diagnostics" aria-label="Aggregate original-index gap diagnostics">
        {
          Object.entries(summary.split.ordering_diagnostics_by_system).map(
            ([systemId, diagnostics]) => (
              <li>
                <h4>{systemId}</h4>
                <p>
                  <strong>{diagnostics.strictly_increasing ? "Strictly increasing" : "Ordering check failed"}</strong>
                </p>
                <dl>
                  <div>
                    <dt>Adjacent gap</dt>
                    <dd>
                      min {formatGap(diagnostics.adjacent_original_index_gap.minimum)} · median {formatGap(diagnostics.adjacent_original_index_gap.median)} · max {formatGap(diagnostics.adjacent_original_index_gap.maximum)}
                    </dd>
                  </div>
                  <div>
                    <dt>Partition boundary gap</dt>
                    <dd>
                      train→validation {formatGap(diagnostics.partition_boundary_gap.train_to_validation)} · validation→evaluation {formatGap(diagnostics.partition_boundary_gap.validation_to_evaluation)}
                    </dd>
                  </div>
                </dl>
              </li>
            ),
          )
        }
      </ul>
    </section>

    <section aria-labelledby="rmd17-boundary-title">
      <div class="rmd17-panel__section-heading">
        <p>06 / Claim boundary</p>
        <h3 id="rmd17-boundary-title">Development observations and limits</h3>
      </div>
      <div
        class="rmd17-panel__table-wrap"
        role="region"
        aria-label="Claim boundary matrix"
        tabindex="0"
      >
        <table>
          <thead>
            <tr>
              <th scope="col">Evidence state</th>
              <th scope="col">Claim boundary</th>
              <th scope="col">Scope</th>
            </tr>
          </thead>
          <tbody>
            {
              claimRows.map((row) => (
                <tr>
                  <th scope="row">{row.boundary}</th>
                  <td>{row.claim}</td>
                  <td>{row.scope}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <ul class="rmd17-panel__lock-list" aria-label="Locked statuses at development freeze">
        {
          lockedSystems.map(([systemId, status]) => (
            <li>
              <span>{systemId}</span>
              <code>{status}</code>
            </li>
          ))
        }
      </ul>
      <p class="rmd17-panel__note">
        These statuses belong to the preserved development snapshot.
        <a href="/labs/rmd17-system-state-energy-baselines/#rmd17-locked-title">Both completed evaluations</a> are reported separately.
        Public source access does not permit selective rerunning or retuning this protocol.
      </p>
    </section>
  </div>
  <p class="rmd17-panel__source">Source: {developmentSummary.protocol_id} · reviewed {developmentSummary.reviewed_on} · <a href={`https://doi.org/${developmentSummary.source.doi}`}>rMD17 version {developmentSummary.source.version}</a>, {developmentSummary.source.licence}. This panel preserves the development snapshot.</p>
</section>

<style>
  .rmd17-panel{min-width:0;margin-block:2rem 3rem;padding-block:1.5rem;border-block:1px solid var(--atlas-rule-strong);background:var(--atlas-panel);color:var(--atlas-ink)}
  .rmd17-panel__header{display:grid;grid-template-columns:minmax(0,1fr) minmax(10rem,.6fr);gap:1.5rem;border-bottom:1px solid var(--atlas-rule);padding-bottom:1.3rem}.rmd17-panel__eyebrow,.rmd17-panel__section-heading>p{font-size:.75rem;color:var(--atlas-teal-deep);font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin:0 0 .45rem}.rmd17-panel h2{margin:0;font-size:clamp(1.6rem,3vw,2.2rem);line-height:1.15;font-weight:600}.rmd17-panel__header>div>p:last-child{font-size:.9rem;color:var(--atlas-muted)}.rmd17-panel h3{font-size:1rem;line-height:1.4;margin:0}.rmd17-panel h4{font-size:.9rem;margin:.2rem 0}
  .rmd17-panel__status,.rmd17-panel__system-grid,.rmd17-panel__feature-grid,.rmd17-panel__aggregate-grid,.rmd17-panel__diagnostics,.rmd17-panel__lock-list{list-style:none;padding:0;margin:0}.rmd17-panel__status{display:grid;gap:.65rem}.rmd17-panel__status-item{font-size:.78rem;line-height:1.5;border-left:2px solid var(--atlas-teal-deep);padding:.45rem 0 .45rem .7rem}.rmd17-panel__status-item--boundary{border-left:2px dashed var(--atlas-emphasis)}.rmd17-panel__status-item>span{display:none}
  .rmd17-panel__body{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 1.5rem}.rmd17-panel__body>section{min-width:0;padding-block:1.3rem;border-bottom:1px solid var(--atlas-rule)}.rmd17-panel__body>section:nth-child(n+3){grid-column:1/-1}.rmd17-panel__section-heading{margin-bottom:1rem}
  .rmd17-panel__system-grid,.rmd17-panel__feature-grid,.rmd17-panel__aggregate-grid,.rmd17-panel__diagnostics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem}.rmd17-panel__system-grid li,.rmd17-panel__feature-grid li,.rmd17-panel__aggregate-grid li,.rmd17-panel__diagnostics li{min-width:0;border-top:2px solid var(--atlas-rule-strong);padding-top:.75rem}.rmd17-panel__system-grid strong,.rmd17-panel__system-grid span,.rmd17-panel__aggregate-grid span,.rmd17-panel__aggregate-grid strong{display:block}.rmd17-panel__system-grid strong{font-size:.95rem}.rmd17-panel__system-grid span{font-family:var(--sl-font-mono,monospace);font-size:.75rem;overflow-wrap:anywhere;color:var(--atlas-teal-deep);margin:.3rem 0}.rmd17-panel__system-grid p,.rmd17-panel__feature-grid p,.rmd17-panel__aggregate-grid p{font-size:.78rem;line-height:1.6;margin:.4rem 0;color:var(--atlas-muted)}.rmd17-panel__aggregate-grid span{font-size:.75rem;color:var(--atlas-muted)}.rmd17-panel__aggregate-grid strong{font-size:1rem;margin-top:.3rem;font-weight:600;font-variant-numeric:tabular-nums}
  .rmd17-panel__timeline{display:flex;gap:2px;list-style:none;padding:0;margin:1.2rem 0}.rmd17-panel__timeline li{min-width:0;padding-top:.65rem;border-top:12px solid var(--atlas-teal-deep);display:grid;gap:.2rem}.rmd17-panel__timeline li:nth-child(2){border-top-color:color-mix(in srgb,var(--atlas-teal) 40%,var(--atlas-panel))}.rmd17-panel__timeline li:nth-child(3){border-top-color:var(--atlas-muted);border-top-style:double}.rmd17-panel__timeline span{font-size:.75rem;color:var(--atlas-muted);overflow-wrap:anywhere}.rmd17-panel__timeline strong{font-size:1.4rem;line-height:1.3;font-weight:600;font-variant-numeric:tabular-nums}
  .rmd17-panel__construction{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;list-style:none;padding:0;margin:1rem 0}.rmd17-panel__construction li{min-width:0;border-top:2px solid var(--atlas-teal-deep);padding:.65rem 0;display:grid;gap:.4rem}.rmd17-panel__construction span{font-size:.75rem;color:var(--atlas-muted)}.rmd17-panel__construction strong{font-size:.85rem;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.rmd17-panel__feature-grid code{font-size:.75rem;line-height:1.6;display:block;overflow-wrap:anywhere;color:var(--atlas-muted)}
  .rmd17-panel__channel-layout{display:grid;gap:.45rem;margin-top:1rem}.rmd17-panel__channel-layout>div{display:grid;grid-template-columns:4rem minmax(0,1fr);gap:.5rem;align-items:center}.rmd17-panel__channel-layout span{font-size:.75rem;font-family:var(--sl-font-mono,monospace)}.rmd17-panel__channel-layout i{height:.7rem;position:relative;border:1px solid var(--atlas-rule-strong);background:repeating-linear-gradient(to right,transparent 0,transparent calc(100% / var(--bin-count) - 1px),var(--atlas-rule) calc(100% / var(--bin-count) - 1px),var(--atlas-rule) calc(100% / var(--bin-count)))}.rmd17-panel__channel-layout b{display:block;position:absolute;width:calc(100% / var(--bin-count));min-width:0;height:100%;right:0;background:var(--atlas-panel);border-left:2px solid var(--atlas-emphasis)}
  .rmd17-panel__selection-callout{display:grid;grid-template-columns:auto auto minmax(0,1fr);align-items:center;gap:.8rem;margin-block:1rem;padding:.75rem 0;border-block:1px solid var(--atlas-rule)}.rmd17-panel__selection-callout span{font-size:.75rem;color:var(--atlas-muted)}.rmd17-panel__selection-callout strong{font-size:1.2rem;font-weight:600;font-variant-numeric:tabular-nums}.rmd17-panel__selection-callout p{font-size:.8rem;margin:0;color:var(--atlas-muted)}
  .rmd17-panel__table-wrap{max-width:100%;overflow-x:auto}.rmd17-panel table{display:table;width:100%;font-size:.78rem;font-variant-numeric:tabular-nums}.rmd17-panel th,.rmd17-panel td{padding:.6rem;text-align:left;vertical-align:top;min-width:5rem}.rmd17-panel caption{font-size:.78rem;text-align:left;color:var(--atlas-muted);padding-block:.8rem}.rmd17-panel__note,.rmd17-panel__source{font-size:.78rem;color:var(--atlas-muted);line-height:1.6}.rmd17-panel__source{overflow-wrap:anywhere;margin-bottom:0}.rmd17-panel summary{min-height:44px;cursor:pointer;padding-block:.65rem;font-size:.8rem;font-weight:600}.rmd17-panel__grid-table{margin-bottom:.75rem}
  .rmd17-panel__diagnostics p{font-size:.8rem}.rmd17-panel__diagnostics dl{display:grid;gap:.65rem;margin-top:.7rem}.rmd17-panel__diagnostics dt{font-size:.75rem;color:var(--atlas-muted)}.rmd17-panel__diagnostics dd{font-size:.8rem;margin:.25rem 0 0;font-variant-numeric:tabular-nums;line-height:1.6}.rmd17-panel__lock-list{display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:1rem}.rmd17-panel__lock-list li{font-size:.8rem;display:flex;gap:.75rem;border-top:1px dashed var(--atlas-emphasis);padding-top:.5rem}.rmd17-panel__table-wrap:focus-visible,.rmd17-panel summary:focus-visible{outline:3px solid var(--atlas-teal-deep);outline-offset:3px}
  @media(max-width:48rem){.rmd17-panel__header,.rmd17-panel__body{grid-template-columns:minmax(0,1fr)}.rmd17-panel__body>section:nth-child(n+3){grid-column:auto}.rmd17-panel__status{grid-template-columns:repeat(2,minmax(0,1fr))}.rmd17-panel__selection-callout{grid-template-columns:auto auto}.rmd17-panel__selection-callout p{grid-column:1/-1}}
  @media(max-width:30rem){.rmd17-panel__construction,.rmd17-panel__feature-grid,.rmd17-panel__diagnostics,.rmd17-panel__status{grid-template-columns:minmax(0,1fr)}.rmd17-panel__system-grid{gap:.75rem}.rmd17-panel__channel-layout>div{grid-template-columns:4rem minmax(0,1fr)}}
</style>
