---
interface Props {count:number;duration:number;chinese?:boolean;checkpoints?:number[]}
const {count,duration,chinese=false,checkpoints}=Astro.props;
---
<div class="figure-steps" data-figure-steps data-count={count} data-duration={duration} data-checkpoints={checkpoints?JSON.stringify(checkpoints):undefined} data-chinese={String(chinese)}>
 <p>{chinese?`可选分步演示 · ${count} 步 / ${duration} 秒。只高亮已有对象或保留检查点。`:`Optional walkthrough · ${count} steps / ${duration} s. Highlights existing objects or retained checkpoints only.`}</p>
 <div class="figure-steps__controls" data-step-controls hidden>
  <button type="button" data-step-play>{chinese?'播放':'Play'}</button><button type="button" data-step-previous aria-label={chinese?'上一步':'Previous step'}>←</button><output data-step-status aria-live="polite">1 / {count}</output><button type="button" data-step-next aria-label={chinese?'下一步':'Next step'}>→</button><button type="button" data-step-reset>{chinese?'重置':'Reset'}</button>
  <label><span>{chinese?'步骤':'Step'}</span><input type="range" min="0" max={count-1} value="0" step="1" data-step-range/></label>
 </div><p class="figure-steps__note" data-step-note></p>
</div>
<script>
import {walkthroughState,retainedCheckpointAtStep} from "../lib/figure-steps";
function initializeFigureSteps(){document.querySelectorAll<HTMLElement>('[data-figure-steps]').forEach(root=>{
 if(root.dataset.ready)return;root.dataset.ready='true';const detail=root.closest<HTMLElement>('[data-figure-detail]')!;const zh=root.dataset.chinese==='true',count=Number(root.dataset.count),duration=Number(root.dataset.duration),range=root.querySelector<HTMLInputElement>('[data-step-range]')!,play=root.querySelector<HTMLButtonElement>('[data-step-play]')!,note=root.querySelector<HTMLElement>('[data-step-note]')!;let index=0,startedAt=0,startIndex=0,timer:ReturnType<typeof setInterval>|undefined;const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 function pause(){if(timer)clearInterval(timer);timer=undefined;play.textContent=zh?'播放':'Play';play.setAttribute('aria-pressed','false');}
 function select(next:number){index=Math.max(0,Math.min(count-1,next));range.value=String(index);root.querySelector<HTMLOutputElement>('[data-step-status]')!.textContent=`${index+1} / ${count}`;detail.querySelectorAll<HTMLElement>('[data-figure-step-item]').forEach(el=>{const active=Number(el.dataset.figureStepItem)===index;el.classList.toggle('is-current-step',active);if(active)el.setAttribute('aria-current','step');else el.removeAttribute('aria-current');});const checkpoints=JSON.parse(root.dataset.checkpoints??'[]') as number[];if(checkpoints.length)detail.querySelectorAll<HTMLElement>('[data-science-plot]').forEach(plot=>{const currentGroup=plot.closest<HTMLElement>('[data-figure-group]');if(currentGroup?.hidden)return;const series=JSON.parse(plot.dataset.plotSeries??'[]') as {points:{x:number}[]}[];const x=retainedCheckpointAtStep(series,index);if(x!==undefined)plot.dispatchEvent(new CustomEvent('science-plot-select-x',{detail:{x}}));});root.dispatchEvent(new CustomEvent('figure-step-select',{bubbles:true,detail:{index}}));}
 play.addEventListener('click',()=>{if(timer){pause();return;}if(reduced.matches)return;if(index===count-1)select(0);play.textContent=zh?'暂停':'Pause';play.setAttribute('aria-pressed','true');startedAt=performance.now();startIndex=index;timer=setInterval(()=>{const state=walkthroughState(startIndex*duration/count+(performance.now()-startedAt)/1000,count,duration);select(state.index);if(state.finished)pause();},100);});
 root.querySelector('[data-step-previous]')!.addEventListener('click',()=>{pause();select(index-1);});root.querySelector('[data-step-next]')!.addEventListener('click',()=>{pause();select(index+1);});root.querySelector('[data-step-reset]')!.addEventListener('click',()=>{pause();select(0);});range.addEventListener('input',()=>{pause();select(Number(range.value));});function preference(){pause();play.disabled=reduced.matches;note.textContent=reduced.matches?(zh?'已开启减少动态效果；使用手动步骤控件。':'Reduced motion is enabled; use the manual step controls.'):(zh?'离开视口或切换标签页后自动暂停。':'Automatically pauses offscreen or when this tab is hidden.');}reduced.addEventListener('change',preference);document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();});new IntersectionObserver(entries=>{if(!entries[0].isIntersecting)pause();},{threshold:.1}).observe(root);root.querySelector<HTMLElement>('[data-step-controls]')!.hidden=false;preference();select(0);
 });}
initializeFigureSteps();document.addEventListener('astro:page-load',initializeFigureSteps);
</script>
<style>
.figure-steps{padding:.75rem 0;border-block:1px solid var(--atlas-rule);margin:1rem 0}.figure-steps p{font-size:.83rem;line-height:1.6;margin:.25rem 0}.figure-steps__controls{display:flex;align-items:center;flex-wrap:wrap;gap:.4rem;margin-top:.6rem}.figure-steps button{min-height:44px;min-width:44px;border:1px solid var(--atlas-rule);border-radius:3px;padding:.4rem .65rem;background:var(--atlas-panel);color:var(--atlas-ink);cursor:pointer}.figure-steps button:disabled{opacity:.55;cursor:default}.figure-steps output{min-width:4rem;text-align:center;font-variant-numeric:tabular-nums}.figure-steps label{display:flex;align-items:center;gap:.5rem;flex:1 1 10rem;font-size:.8rem}.figure-steps label span{white-space:nowrap;flex-shrink:0}.figure-steps input{min-height:44px;width:100%;accent-color:var(--atlas-teal-deep)}.figure-steps__note{color:var(--atlas-muted)}
</style>
