---
interface Props { chinese?: boolean; }
const { chinese = Astro.url.pathname.includes("/zh-cn/") } = Astro.props;
const steps = [
  { number: "01", icon: "molecule", title: chinese ? "先确定实体" : "Resolve the entity", short: chinese ? "化学对象" : "Chemical object", body: chinese ? "parent、盐、混合物、质子化状态、互变异构体、立体异构体、构象与复合物是不同的科学对象。" : "Parent, salt, mixture, protomer, tautomer, stereoisomer, conformer, or complex are different scientific objects." },
  { number: "02", icon: "assay", title: chinese ? "明确端点依赖" : "Name endpoint dependence", short: chinese ? "测量语境" : "Measurement context", body: chinese ? "测量是否依赖连接关系、局部基序、立体化学、几何、环境或构象集合？" : "Ask whether the measurement can depend on connectivity, local motifs, stereochemistry, geometry, environment, or an ensemble." },
  { number: "03", icon: "model", title: chinese ? "选择信息损失最小的基线" : "Choose the least lossy baseline", short: chinese ? "保留相关区别" : "Preserve relevant distinctions", body: chinese ? "从能保留端点相关变量的最低成本表示开始。" : "Begin with the lowest-cost representation that preserves the variables the endpoint can use." },
  { number: "04", icon: "data", title: chinese ? "固定匹配的比较" : "Freeze a matched comparison", short: chinese ? "比较边界" : "Comparison boundary", body: chinese ? "改变表示或编码器前，固定实体、标签、划分、预处理与指标。" : "Hold entities, labels, splits, preprocessing, and metrics fixed before changing the representation or encoder." },
] as const;
const families = [
  { short: "ID", label: chinese ? "注册库关联" : "registry linkage", kind: "record" },
  { short: "DESC", label: chinese ? "全局标量" : "global scalars", kind: "scalars" },
  { short: "FP", label: chinese ? "局部环境" : "local environments", kind: "bits" },
  { short: "2D", label: chinese ? "连接图" : "connectivity graph", kind: "graph" },
  { short: "SEQ", label: chinese ? "序列化语法" : "serialized syntax", kind: "tokens" },
  { short: "3D", label: chinese ? "状态与几何" : "state and geometry", kind: "space" },
];
// These dependency hypotheses are the adjacent canonical lesson's worked choices.
const scenarios = [
  {id:"identity", title:chinese?"注册库关联":"Registry linkage", family:"ID", needs:chinese?"结构记录与合适的标识符；先解决实体。":"A structure record and suitable identifier; resolve the entity first."},
  {id:"global",title:chinese?"大小、极性与柔性趋势":"Size, polarity and flexibility",family:"DESC",needs:chinese?"小型、明确定义的描述符向量。":"A small, declared descriptor vector."},
  {id:"local",title:chinese?"局部结构–活性关系":"Local structure–activity",family:"FP 2D",needs:chinese?"从圆形指纹或局部图表示开始。":"Begin with circular fingerprints or a local graph representation."},
  {id:"quantum",title:chinese?"量子能量或力":"Quantum energy or force",family:"3D",needs:chinese?"坐标、元素、状态与物理对称性。":"Coordinates, elements, state and physical symmetries."},
  {id:"complex",title:chinese?"蛋白质–配体几何":"Protein–ligand geometry",family:"3D",needs:chinese?"配体状态、构象或姿势、靶标构建与相互作用语境。":"Ligand state, conformer or pose, target construct and interaction context."},
];
---

<section class="representation-decision-map not-content" aria-labelledby="representation-map-title" data-representation-map lang={chinese ? "zh-CN" : "en"}>
  <header><p class="representation-decision-map__eyebrow">{chinese ? "从对象到比较" : "Object → endpoint → comparison"}</p><h2 id="representation-map-title">{chinese ? "表示是一系列科学选择" : "Representation is a chain of scientific choices"}</h2><p>{chinese ? "先问哪些区别必须为这个端点与决策保留下来，再选择编码。" : "Ask which distinctions must survive for this endpoint and decision before choosing an encoding."}</p></header>
  <ol class="representation-decision-map__steps">
    {steps.map((step) => <li><span class="representation-decision-map__number">{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}
  </ol>
  <div class="representation-choice-workbench" data-representation-workbench>
    <div class="representation-choice-workbench__question"><h3>{chinese?"端点需要什么信息？":"What information can the endpoint use?"}</h3><p>{chinese?"选择依赖假设，检查最低成本的起点。表示家族不是性能排名。":"Select a dependency hypothesis to inspect a starting view. Families are not a performance ranking."}</p></div>
    <ol class="representation-choice-workbench__scenarios">
      {scenarios.map((scenario,index)=><li><button type="button" data-representation-scenario={scenario.id} data-families={scenario.family} aria-pressed={index===0?"true":"false"} disabled><span>{String(index+1).padStart(2,"0")}</span><strong>{scenario.title}</strong><span aria-hidden="true">→</span></button><p data-representation-explanation={scenario.id}>{scenario.needs}</p></li>)}
    </ol>
    <div class="representation-choice-workbench__views"><p>{chinese?"六种计算视图":"Six computational views"}</p><ul aria-label={chinese?"表示家族":"Representation families"}>{families.map(family=><li data-representation-family={family.short}><strong>{family.short}</strong><span>{family.label}</span></li>)}</ul><p class="representation-choice-workbench__readout" data-representation-readout role="status" hidden></p><p>{chinese?"SEQ 表达序列化语法。编码选择不能补回遗漏的 assay 语境；单一构象也不是构象集合。":"SEQ expresses serialized syntax. An encoding cannot restore omitted assay context; one conformer is not an ensemble."}</p></div>
  </div>
  <div class="representation-decision-map__matched" aria-label={chinese ? "匹配比较的共同边界" : "Shared boundary for a matched comparison"}><span class="representation-decision-map__fixed">{chinese ? "保持固定" : "Hold fixed"}</span><p>{chinese ? "实体 · 标签 · 划分 · 预处理 · 指标" : "Entities · labels · splits · preprocessing · metrics"}</p><span class="representation-decision-map__vary">{chinese ? "改变表示 / 编码器" : "Vary representation / encoder"}</span></div>
  <p class="representation-decision-map__note">{chinese ? "箭头表示决策顺序；相关视图是本章的依赖假设起点，不是计算得到的特征或性能排名。" : "Arrows show decision order. Highlighted views are starting points for this chapter’s dependency hypotheses, not computed features or a performance ranking."}</p>
</section>

<script>
  function initializeRepresentationChoices(){
    document.querySelectorAll<HTMLElement>("[data-representation-workbench]").forEach(root=>{
      if(root.dataset.ready)return;root.dataset.ready="true";
      const buttons=[...root.querySelectorAll<HTMLButtonElement>("[data-representation-scenario]")];
      const status=root.querySelector<HTMLElement>("[data-representation-readout]")!;
      function select(button:HTMLButtonElement){
        buttons.forEach(item=>item.setAttribute("aria-pressed",String(item===button)));
        const wanted=new Set((button.dataset.families??"").split(" "));
        root.querySelectorAll<HTMLElement>("[data-representation-family]").forEach(family=>family.classList.toggle("is-relevant",wanted.has(family.dataset.representationFamily!)));
        const text=root.querySelector<HTMLElement>(`[data-representation-explanation="${button.dataset.representationScenario}"]`)?.textContent??"";
        status.textContent=text;
      }
      buttons.forEach(button=>{button.disabled=false;button.addEventListener("click",()=>select(button));});
      status.hidden=false;select(buttons[0]);
    });
  }
  initializeRepresentationChoices();document.addEventListener("astro:page-load",initializeRepresentationChoices);
</script>
<style>
  .representation-decision-map { margin-block: 2rem; border-block: 1px solid var(--atlas-rule-strong); color: var(--atlas-ink); background: var(--atlas-panel); }
  .representation-decision-map header { padding: 1.25rem 0 1rem; }
  .representation-decision-map__eyebrow { margin: 0 0 .45rem; color: var(--atlas-teal-deep); font-size: .75rem; font-weight: 650; letter-spacing: .04em; }
  .representation-decision-map h2 { margin: 0; font-size: clamp(1.35rem, 3vw, 1.9rem); font-weight: 650; line-height: 1.25; letter-spacing: -.025em; }
  .representation-decision-map header > p:last-child { margin: .65rem 0 0; color: var(--atlas-muted); font-size: .88rem; line-height: 1.6; }
  .representation-decision-map__steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.2rem; margin: 0; padding: 0; list-style: none; }
  .representation-decision-map__steps li { position: relative; display: flex; flex-direction: column; min-width: 0; padding: .75rem 0; border-top: 1px solid var(--atlas-rule); }
  .representation-decision-map__number { font: .75rem var(--atlas-font-mono); color: var(--atlas-teal-deep); }
  .representation-decision-map__steps h3 { margin: .35rem 0 .6rem; font-size: .88rem; line-height: 1.4; min-height: 0; }
  .representation-decision-map__steps p { margin: .5rem 0 0; color: var(--atlas-muted); font-size: .78rem; line-height: 1.6; }
  .representation-decision-map__matched { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .4rem .8rem; align-items: center; padding: .8rem 0; border-block: 1px solid var(--atlas-rule); }
  .representation-decision-map__matched p { margin: 0; font-size: .78rem; line-height: 1.6; }
  .representation-decision-map__fixed { padding: .25rem .4rem; border: 1px solid var(--atlas-rule-strong); font-size: .75rem; font-weight: 650; }
  .representation-decision-map__vary { grid-column: 2; padding-left: .65rem; border-left: 2px dashed var(--atlas-teal); color: var(--atlas-teal-deep); font-size: .75rem; }
  .representation-decision-map__note { margin: .75rem 0; color: var(--atlas-muted); font-size: .75rem; line-height: 1.6; }
  .representation-choice-workbench{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 1.5rem;margin-block:1rem;border-top:1px solid var(--atlas-rule)}.representation-choice-workbench__question{grid-column:1/-1;padding-block:1rem}.representation-choice-workbench__question h3{font-size:1.05rem;margin:0}.representation-choice-workbench__question p,.representation-choice-workbench__views>p{font-size:.78rem;line-height:1.6;color:var(--atlas-muted);margin:.4rem 0}.representation-choice-workbench__scenarios{list-style:none;padding:0;margin:0}.representation-choice-workbench__scenarios li{border-top:1px solid var(--atlas-rule)}.representation-choice-workbench__scenarios button{display:grid;grid-template-columns:1.5rem minmax(0,1fr) auto;gap:.5rem;align-items:center;text-align:left;width:100%;min-height:48px;font:inherit;font-size:.8rem;border:0;background:transparent;padding:.6rem 0;color:var(--atlas-ink);cursor:pointer}.representation-choice-workbench__scenarios button>span:first-child{font:.75rem var(--atlas-font-mono);color:var(--atlas-muted)}.representation-choice-workbench__scenarios button>strong{font-weight:600}.representation-choice-workbench__scenarios button[aria-pressed="true"]{color:var(--atlas-teal-deep)}.representation-choice-workbench__scenarios button:disabled{cursor:default;color:var(--atlas-ink)}.representation-choice-workbench__scenarios button:focus-visible{outline:3px solid var(--atlas-teal-deep);outline-offset:2px}.representation-choice-workbench__scenarios li>p{font-size:.78rem;line-height:1.6;color:var(--atlas-muted);margin:0 0 .7rem 2rem}.representation-choice-workbench[data-ready] .representation-choice-workbench__scenarios li>p{display:none}.representation-choice-workbench__views ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;list-style:none;padding:0;margin:.8rem 0}.representation-choice-workbench__views li{padding:.65rem .5rem;border:1px solid var(--atlas-rule);min-width:0;display:grid;gap:.3rem}.representation-choice-workbench__views li strong{font:.85rem var(--atlas-font-mono)}.representation-choice-workbench__views li>span{font-size:.75rem;color:var(--atlas-muted);line-height:1.4}.representation-choice-workbench__views li.is-relevant{border-color:var(--atlas-teal-deep);box-shadow:inset 0 3px var(--atlas-teal-deep);background:color-mix(in srgb,var(--atlas-teal) 7%,var(--atlas-panel))}.representation-choice-workbench__readout{padding:.8rem 0;border-block:1px solid var(--atlas-rule);color:var(--atlas-ink)!important;min-height:4.2rem}.representation-choice-workbench [hidden]{display:none!important}
  @media(max-width:38rem){.representation-choice-workbench{grid-template-columns:minmax(0,1fr);gap:1rem}.representation-choice-workbench__question{grid-column:auto}.representation-choice-workbench__views ul{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media (max-width: 48rem) { .representation-decision-map__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem 1.5rem; } .representation-decision-map__steps h3 { min-height: 0; } .representation-decision-map__arrow { top: 7rem; } .representation-decision-map__steps li:nth-child(2) .representation-decision-map__arrow { display: none; } }
  @media(max-width:30rem){.representation-decision-map__steps{grid-template-columns:1fr;gap:.5rem}.representation-decision-map__steps li{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.2rem .5rem}.representation-decision-map__steps h3{margin:0}.representation-decision-map__steps p{grid-column:2;margin:0}.representation-decision-map__matched{grid-template-columns:minmax(0,1fr)}.representation-decision-map__vary{grid-column:auto}}

</style>
