---
interface EvidenceRow {
  label: string;
  value: number;
  key: string;
  note?: string;
}
interface Props {
  title: string;
  description?: string;
  rows: EvidenceRow[];
  maximum: number;
  units: string;
  digits?: number;
  assay?: string;
  chinese?: boolean;
}
const { title, description, rows, maximum, units, digits = 3, assay = "", chinese = false } = Astro.props;
const ticks = [0, .25, .5, .75, 1];
const tick = (value: number) => Number(value.toPrecision(3)).toString();
---

<figure class="evidence-bars">
  <figcaption><strong>{title}</strong>{description && <span>{description}</span>}</figcaption>
  <div class="evidence-bars__marks" role="img" aria-label={`${title}. ${chinese ? "误差，越低越好。精确数值见相邻表格。" : "Error, lower is better. Exact values are in the adjacent table."} ${units}.`}>
    {rows.map((row, index) => (
      <div class="evidence-bars__row" data-model={row.key}>
        <span class="evidence-bars__label"><i class={`evidence-bars__symbol symbol-${index % 3}`} aria-hidden="true" />{row.label}{row.note && <small>{row.note}</small>}</span>
        <div class="evidence-bars__track">
          <span class:list={["evidence-bars__bar", `symbol-${index % 3}`]} data-bar data-assay={assay} data-model={row.key} data-value={row.value} style={`width:${row.value / maximum * 100}%`}><i /></span>
        </div>
        <output data-score data-assay={assay} data-model={row.key} title={String(row.value)}>{row.value.toFixed(digits)}</output>
      </div>
    ))}
    <div class="evidence-bars__axis" aria-hidden="true">{ticks.map((fraction, index) => <span data-axis-tick={index} style={`left:${fraction * 100}%`}>{tick(maximum * fraction)}</span>)}</div>
  </div>
  <p class="evidence-bars__unit">{units} · {chinese ? "越低越好" : "lower is better"}</p>
</figure>

<style>
  .evidence-bars{margin:0;min-width:0;color:var(--atlas-ink);--label-width:9rem;--score-width:3.6rem;--bar-color:var(--atlas-muted)}
  figcaption{display:grid;gap:.25rem;margin:0 0 1rem;font-size:.9rem;line-height:1.4}
  figcaption span{font-size:.78rem;color:var(--atlas-muted);font-weight:400}
  .evidence-bars__row{display:grid;grid-template-columns:var(--label-width) minmax(0,1fr) var(--score-width);align-items:center;gap:.65rem;min-height:2.65rem;font-size:.78rem}
  .evidence-bars__label{display:flex;align-items:center;flex-wrap:wrap;gap:.45rem;line-height:1.3}
  .evidence-bars__label small{flex-basis:100%;font-size:.75rem;color:var(--atlas-muted)}
  .evidence-bars__track{height:1.4rem;position:relative;border-left:1px solid var(--atlas-rule-strong);background:repeating-linear-gradient(to right,transparent 0,transparent calc(25% - 1px),var(--atlas-rule) calc(25% - 1px),var(--atlas-rule) 25%)}
  .evidence-bars__bar{position:absolute;top:calc(50% - 2px);height:4px;background:var(--bar-color);min-width:0}
  .evidence-bars__bar i{position:absolute;right:0;top:50%;width:.6rem;height:.6rem;transform:translate(50%,-50%);border:1px solid var(--atlas-panel);background:var(--bar-color);border-radius:50%}
  .evidence-bars__row:nth-child(2){--bar-color:var(--atlas-teal-deep)}
  .evidence-bars__row:nth-child(3){--bar-color:var(--atlas-emphasis)}
  .evidence-bars__symbol{display:inline-block;flex:0 0 .55rem;width:.55rem;height:.55rem;background:var(--bar-color);border-radius:50%}
  .symbol-1 i,.evidence-bars__symbol.symbol-1{border-radius:0}
  .symbol-2 i{border-radius:0;transform:translate(50%,-50%) rotate(45deg)}
  .evidence-bars__symbol.symbol-2{border-radius:0;transform:rotate(45deg)}
  output{color:var(--atlas-ink);text-align:right;font-variant-numeric:tabular-nums;font-size:.78rem}
  .evidence-bars__axis{position:relative;height:1.5rem;margin:.25rem calc(var(--score-width) + .65rem) 0 calc(var(--label-width) + .65rem);border-top:1px solid var(--atlas-rule-strong);font-size:.75rem;color:var(--atlas-muted);font-variant-numeric:tabular-nums}
  .evidence-bars__axis span{position:absolute;top:.3rem;transform:translateX(-50%)}
  .evidence-bars__axis span:first-child{transform:none}.evidence-bars__axis span:last-child{transform:translateX(-100%)}
  .evidence-bars__unit{margin:.5rem 0 0 calc(var(--label-width) + .65rem);font-size:.75rem;color:var(--atlas-muted)}
  @media(max-width:32rem){.evidence-bars{--label-width:6rem;--score-width:3rem}.evidence-bars__row{gap:.45rem;font-size:.75rem}.evidence-bars__axis{margin-inline:calc(var(--label-width) + .45rem) calc(var(--score-width) + .45rem)}.evidence-bars__unit{margin-left:0}.evidence-bars__symbol{display:none}}
</style>
