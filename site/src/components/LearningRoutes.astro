---
import { parse } from "yaml";

import {
  capabilitiesForLesson,
  type Curriculum,
} from "../../../scripts/curriculum/curriculum.js";
import curriculumSource from "../../../catalog/curriculum/tracks.yaml?raw";

interface Props {
  chinese?: boolean;
}

const { chinese = false } = Astro.props;
const curriculum = parse(curriculumSource) as Curriculum;
const lessonsByQualifiedId = new Map(
  curriculum.tracks.flatMap((track) =>
    track.lessons.map((lesson) => [
      `${track.id}/${lesson.id}`,
      { lesson, track },
    ]),
  ),
);
const lessonsById = new Map(
  curriculum.tracks.flatMap((track) =>
    track.lessons.map((lesson) => [lesson.id, { lesson, track }]),
  ),
);
const corePath = curriculum.learning_paths.find((path) => path.kind === "core");
const specialistPaths = curriculum.learning_paths.filter(
  (path) => path.kind === "specialist",
);
const labels = chinese
  ? {
      capabilities: "教学能力",
      core: "核心路径",
      externalPrerequisites: "路径外先修课程",
      lessonPrerequisites: "本课先修课程",
      open: "打开课程",
      specialist: "专题路径",
      step: "步骤",
    }
  : {
      capabilities: "Capabilities",
      core: "Core route",
      externalPrerequisites: "Prerequisites outside this route",
      lessonPrerequisites: "Lesson prerequisites",
      open: "Open lesson",
      specialist: "Specialist routes",
      step: "Step",
    };

const capabilityLabels = chinese
  ? {
      orientation: "导览",
      explanation: "讲解",
      "worked-example": "示例",
      exercise: "练习",
      runnable: "可运行",
    }
  : {
      orientation: "Orientation",
      explanation: "Explanation",
      "worked-example": "Worked example",
      exercise: "Exercise",
      runnable: "Runnable",
    };

function lessonHref(lessonId: string): string {
  return chinese ? `/zh-cn/learn/${lessonId}/` : `/learn/${lessonId}/`;
}

function lessonTitle(lessonId: string): string {
  const resolved = lessonsByQualifiedId.get(lessonId);
  if (!resolved) return lessonId;
  return chinese ? resolved.lesson.title_zh ?? resolved.lesson.title : resolved.lesson.title;
}

function lessonTrackTitle(lessonId: string): string {
  const resolved = lessonsByQualifiedId.get(lessonId);
  if (!resolved) return lessonId;
  return chinese ? resolved.track.title_zh : resolved.track.title;
}

function canonicalPrerequisites(lessonId: string): string[] {
  const resolved = lessonsByQualifiedId.get(lessonId);
  if (!resolved) return [];
  return resolved.lesson.prerequisites.flatMap((prerequisite) => {
    const prerequisiteLesson = lessonsById.get(prerequisite);
    return prerequisiteLesson
      ? [`${prerequisiteLesson.track.id}/${prerequisiteLesson.lesson.id}`]
      : [];
  });
}
---

<section class="learning-routes not-content" aria-label={chinese ? "学习路径" : "Learning routes"} data-learning-routes>
  {corePath && (
    <section class="learning-routes__group" id="core-route" aria-labelledby="core-route-title">
      <p class="learning-routes__eyebrow">{labels.core}</p>
      <article class="learning-routes__route" data-learning-path={corePath.id} id={`learning-route-${corePath.id}`}>
        <header class="learning-routes__route-heading"><span class="learning-routes__route-symbol" aria-hidden="true">C</span><div><h2 id="core-route-title">{chinese ? corePath.title_zh : corePath.title}</h2><span class="learning-routes__route-count">{corePath.lesson_ids.filter((id) => lessonsByQualifiedId.get(id)?.lesson.type !== "core-source-path").length} {chinese ? "个有序课程节点" : "ordered lesson nodes"}</span></div></header>
        <p>{chinese ? corePath.description_zh : corePath.description}</p>
        <ol class="learning-routes__steps">
          {corePath.lesson_ids.map((lessonId, index) => {
            const resolved = lessonsByQualifiedId.get(lessonId);
            if (!resolved || resolved.lesson.type === "core-source-path") return null;
            const prerequisites = canonicalPrerequisites(lessonId);
            const capabilities = capabilitiesForLesson(resolved.lesson);
            return (
              <li>
                <span class="learning-routes__step"><span>{String(index + 1).padStart(2, "0")}</span></span>
                <div>
                  <a href={lessonHref(lessonId)}>{lessonTitle(lessonId)}</a>
                  <p>{lessonTrackTitle(lessonId)}</p>
                  {prerequisites.length > 0 && (
                    <p>
                      <strong>{labels.lessonPrerequisites}.</strong>{" "}
                      {prerequisites.map((prerequisite, prerequisiteIndex) => (
                        <Fragment>
                          {prerequisiteIndex > 0 ? ", " : ""}
                          <a href={lessonHref(prerequisite)}>{lessonTitle(prerequisite)}</a>
                        </Fragment>
                      ))}
                    </p>
                  )}
                  {capabilities.length > 0 && (
                    <p><strong>{labels.capabilities}.</strong>{" "}{capabilities.map((capability) => capabilityLabels[capability]).join(", ")}</p>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </article>
    </section>
  )}

  <section class="learning-routes__group" id="specialist-routes" aria-labelledby="specialist-routes-title">
    <p class="learning-routes__eyebrow">{labels.specialist}</p>
    <h2 id="specialist-routes-title">{chinese ? "按问题进入专题学习" : "Specialist routes by question"}</h2>
    <div class="learning-routes__specialists">
      {specialistPaths.map((path) => (
        <article class="learning-routes__route" data-learning-path={path.id} id={`learning-route-${path.id}`}>
          <header class="learning-routes__route-heading"><span class="learning-routes__route-symbol" aria-hidden="true">↗</span><div><h3>{chinese ? path.title_zh : path.title}</h3><span class="learning-routes__route-count">{path.lesson_ids.filter((id) => lessonsByQualifiedId.get(id)?.lesson.type !== "core-source-path").length} {chinese ? "个有序课程节点" : "ordered lesson nodes"}</span></div></header>
          <p>{chinese ? path.description_zh : path.description}</p>
          {path.prerequisites.length > 0 && (
            <p class="learning-routes__external-prerequisites">
              <strong>{labels.externalPrerequisites}.</strong>{" "}
              {path.prerequisites.map((lessonId, index) => (
                <Fragment>
                  {index > 0 ? ", " : ""}
                  <a href={lessonHref(lessonId)}>{lessonTitle(lessonId)}</a>
                </Fragment>
              ))}
            </p>
          )}
          <ol class="learning-routes__steps">
            {path.lesson_ids.map((lessonId, index) => {
              const resolved = lessonsByQualifiedId.get(lessonId);
              if (!resolved || resolved.lesson.type === "core-source-path") return null;
              const prerequisites = canonicalPrerequisites(lessonId);
              const capabilities = capabilitiesForLesson(resolved.lesson);
              return (
                <li>
                  <span class="learning-routes__step"><span>{String(index + 1).padStart(2, "0")}</span></span>
                  <div>
                    <a href={lessonHref(lessonId)}>{lessonTitle(lessonId)}</a>
                    <p>{lessonTrackTitle(lessonId)}</p>
                    {prerequisites.length > 0 && (
                      <p>
                        <strong>{labels.lessonPrerequisites}.</strong>{" "}
                        {prerequisites.map((prerequisite, prerequisiteIndex) => (
                          <Fragment>
                            {prerequisiteIndex > 0 ? ", " : ""}
                            <a href={lessonHref(prerequisite)}>{lessonTitle(prerequisite)}</a>
                          </Fragment>
                        ))}
                      </p>
                    )}
                    {capabilities.length > 0 && (
                      <p><strong>{labels.capabilities}.</strong>{" "}{capabilities.map((capability) => capabilityLabels[capability]).join(", ")}</p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </article>
      ))}
    </div>
  </section>
  <p class="learning-routes__boundary">{chinese ? "编号表示课程源中的路径顺序；先修依赖另行列出。路径不表示已执行实验或已测得的学习成果。" : "Numbers indicate route order from the curriculum source; prerequisite dependencies are listed separately. Routes do not represent executed experiments or measured learning outcomes."}</p>
</section>

<style>
  .learning-routes { display: grid; gap: 1.5rem; margin-block: 1.5rem; color: var(--atlas-ink); }
  .learning-routes__group > h2, .learning-routes__route h2, .learning-routes__route h3 { margin: 0; line-height: 1.4; }
  .learning-routes__eyebrow { color: var(--atlas-teal-deep); font-size: .78rem; font-weight: 650; letter-spacing: .04em; margin: 0 0 .7rem; }
  .learning-routes__route { padding: 1rem 0; border: 0; border-top: 1px solid var(--atlas-rule-strong); background: transparent; min-width: 0; }
  .learning-routes__route-heading { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .9rem; align-items: center; }
  .learning-routes__route h2 { font-size: 1.35rem; }
  .learning-routes__route h3 { font-size: 1.1rem; }
  .learning-routes__route-count { display: block; margin-top: .4rem; font: .75rem var(--atlas-font-mono); color: var(--atlas-muted); }
  .learning-routes__route > p { margin: .8rem 0 1rem; font-size: .88rem; line-height: 1.6; color: var(--atlas-muted); }
  .learning-routes__route-symbol { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--atlas-rule-strong); border-radius: 50%; color: var(--atlas-teal-deep); font: 1.1rem var(--atlas-font-mono); }
  .learning-routes__specialists .learning-routes__steps { grid-template-columns: 1fr; }
  .learning-routes__specialists { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1rem; align-items: start; }
  .learning-routes__steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; row-gap: 0; margin: 1rem 0 0; padding: 0; list-style: none; counter-reset: none; }
  .learning-routes__steps li { position: relative; display: grid; grid-template-columns: 1.75rem minmax(0, 1fr); gap: .5rem; padding: .65rem 0; border-top: 1px solid var(--atlas-rule); }
  .learning-routes__step { position: relative; display: flex; flex-direction: column; align-items: center; gap: .3rem; color: var(--atlas-teal-deep); font: .75rem var(--atlas-font-mono); }
  .learning-routes__step::before { position: absolute; top: 1.75rem; bottom: -.7rem; left: 50%; content: ''; border-left: 1px solid var(--atlas-rule-strong); }
  .learning-routes__step::after { position: absolute; bottom: -.65rem; left: calc(50% - 2px); content: ''; width: 4px; height: 4px; border-right: 1px solid var(--atlas-muted); border-bottom: 1px solid var(--atlas-muted); transform: rotate(45deg); }
  .learning-routes__steps li:last-child .learning-routes__step::before, .learning-routes__steps li:last-child .learning-routes__step::after { display: none; }
  [data-learning-path="core"] .learning-routes__step::before, [data-learning-path="core"] .learning-routes__step::after { display: none; }
  .learning-routes__steps > li > div { min-width: 0; }
  .learning-routes__steps > li > div > a { display: inline-flex; align-items: center; min-height: 44px; }
  .learning-routes__steps a { font-weight: 650; font-size: .9rem; line-height: 1.5; overflow-wrap: anywhere; }
  .learning-routes__steps p, .learning-routes__external-prerequisites { margin: .3rem 0; color: var(--atlas-muted); font-size: .78rem; line-height: 1.6; }
  .learning-routes__steps p a, .learning-routes__external-prerequisites a { font-size: inherit; font-weight: 500; }
  .learning-routes__boundary { margin: 0; padding-top: .8rem; border-top: 1px dashed var(--atlas-rule); color: var(--atlas-muted); font-size: .75rem; line-height: 1.6; }
  @media (max-width: 48rem) { .learning-routes__specialists, .learning-routes__steps { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 30rem) { .learning-routes__steps li { grid-template-columns: 1.5rem minmax(0, 1fr); gap: .6rem; } .learning-routes__route h2 { font-size: 1.15rem; } .learning-routes__route-heading { gap: .6rem; } }
</style>
