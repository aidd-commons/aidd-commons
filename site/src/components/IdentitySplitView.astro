---
interface Props {chinese?:boolean; context?:"lineage"|"evaluation"}
const {chinese=false,context="lineage"}=Astro.props;
const t=(en:string,zh:string)=>chinese?zh:en;
const records=[{id:"r1",parent:"A",assay:"E",value:"100 nM",state:"exact"},{id:"r2",parent:"A",assay:"E",value:"1000 nM",state:"exact"},{id:"r3",parent:"B",assay:"E",value:"0.2 µM",state:"exact"},{id:"r4",parent:"C",assay:"E",value:"> 10 µM",state:"censored"},{id:"r5",parent:"D",assay:"F",value:"10 nM",state:"different-assay"},{id:"r1-copy",parent:"A",assay:"E",value:"100 nM",state:"duplicate"}];
---
<div class="identity-view" data-identity-view data-identity-context={context}>
  <p class="identity-view__mode">{t("Constructed example · no real assay measurements","构造示例 · 没有真实 assay 测量")}</p>
  {context==="lineage"&&<ol class="identity-lineage" aria-label={t("Record-to-target lineage","记录到目标值的谱系")}>
    <li><span class="identity-lineage__step">01</span><h4>{t("Resolve identity","解析身份")}</h4><div class="identity-lineage__records"><b>r1 <code>100 nM</code></b><b>r2 <code>1000 nM</code></b><s>r1-copy</s></div><p>parent A · assay E</p><small>{t("Export duplicate removed; two experiments remain","移除导出重复，保留两次实验")}</small></li>
    <li><span class="identity-lineage__step">02</span><h4>{t("Transform each endpoint","逐项变换终点")}</h4><div class="identity-lineage__transform"><span>100 nM <b>→ 7</b></span><span>1000 nM <b>→ 6</b></span></div><p>pIC50 = −log10(IC50 / M)</p><small>{t("Exact values in the same assay","同一 assay 中的精确值")}</small></li>
    <li><span class="identity-lineage__step">03</span><h4>{t("Aggregate the declared unit","聚合声明单位")}</h4><div class="identity-lineage__median"><span>6</span><strong>6.5</strong><span>7</span></div><p>pIC50 = median(7, 6) = 6.5</p><small>{t("One parent–assay target; retain both source rows","一个 parent–assay 目标，保留两行来源")}</small></li>
  </ol>}
  <div class="identity-comparison" aria-label={t("Compare split membership side by side","并排比较划分成员")}>
    <section class="identity-view__split identity-view__split--defect" data-identity-state="row"><h4><span>×</span> {t("Row split · defective control","按行划分 · 错误对照")}</h4><div class="identity-view__partition"><strong>{t("Training","训练")}</strong><span class="identity-view__token" data-parent="A">A · r1</span></div><div class="identity-view__boundary"><span>{t("same parent crosses","相同 parent 跨界")}</span><b aria-hidden="true">↓ A ↓</b></div><div class="identity-view__partition"><strong>{t("Evaluation","评估")}</strong><span class="identity-view__token" data-parent="A">A · r2</span><span class="identity-view__token identity-view__token--b" data-parent="B">B · r3</span></div><p>{t("Counting rows alone misses shared identity.","仅统计行数不能发现共享身份。")}</p></section>
    <section class="identity-view__split" data-identity-state="group"><h4><span>✓</span> {t("Parent-grouped split","按 parent 分组划分")}</h4><div class="identity-view__partition"><strong>{t("Training","训练")}</strong><span class="identity-view__token" data-parent="A">A · r1</span><span class="identity-view__token" data-parent="A">A · r2</span></div><div class="identity-view__boundary"><span>{t("parent boundary preserved","保留 parent 边界")}</span><b aria-hidden="true">A │ B</b></div><div class="identity-view__partition"><strong>{t("Evaluation","评估")}</strong><span class="identity-view__token identity-view__token--b" data-parent="B">B · r3</span></div><p>{t("A's records stay together. Membership disjointness does not establish independence or a complete scaffold split.","A 的记录放在同一集合。成员不重叠不证明独立性，也不表示完整 scaffold 划分。")}</p></section>
  </div>
  <div class="identity-exclusions"><span><b>r4</b> &gt; 10 µM → pIC50 &lt; 5 <em>{t("bound, not exact","界限而非精确值")}</em></span><span><b>r5</b> assay F <em>{t("different context","不同情境")}</em></span><span><b>r6</b> 50 nM <em>{t("unresolved structure","结构未解析")}</em></span></div>
  <details><summary>{t("Read the original constructed records","读取原始构造记录")}</summary><div class="identity-view__scroll" tabindex="0" role="region" aria-label={t("Constructed record table","构造记录表")}><table><caption>{t("Exact-value regression admits resolved exact measurements in the correct assay. A separate r6 has unresolved structure and 50 nM; it enters none of the resolved parents in this table.","精确值回归只接收正确 assay 中已解析的精确测量。另有 r6，结构未解析，50 nM，不进入表中的任何已解析 parent。")}</caption><thead><tr><th scope="col">{t("Record","记录")}</th><th scope="col">Parent</th><th scope="col">Assay</th><th scope="col">IC50</th><th scope="col">{t("State","状态")}</th></tr></thead><tbody>{records.map(record=><tr><th scope="row">{record.id}</th><td>{record.parent}</td><td>{record.assay}</td><td>{record.value}</td><td>{record.state}</td></tr>)}</tbody></table></div></details>
  {context==="evaluation"&&<div class="identity-view__frozen"><strong>{t("Real frozen ChEMBL scaffold partitions","真实冻结 ChEMBL scaffold 分区")}</strong><div><span>{t("Training","训练")} <b>634</b></span><span>{t("Validation","验证")} <b>136</b></span><span>{t("Evaluation","评估")} <b>132</b></span></div><p>{t("Parent counts preserve whole groups rather than forcing target percentages.","Parent 实际计数保留完整组，而不是强行匹配目标比例。")}</p></div>}
</div>
<style>
.identity-view{min-width:0;color:var(--atlas-ink);font-size:.8rem}.identity-view__mode{font-size:.75rem;color:var(--atlas-teal-deep);font-weight:600}.identity-lineage{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem;list-style:none;margin:.5rem 0 1.2rem!important;padding:0!important}.identity-lineage li{position:relative;min-width:0;padding:.75rem 0;border-top:2px solid var(--atlas-rule-strong)}.identity-lineage h4{font-size:.8rem;margin:0 0 1rem!important;padding-right:1rem}.identity-lineage__step{position:absolute;right:0;top:.75rem;font:.75rem var(--sl-font-mono,monospace);color:var(--atlas-muted)}.identity-lineage__records,.identity-lineage__transform{display:grid;gap:.4rem;min-height:5.3rem}.identity-lineage__records b{display:flex;justify-content:space-between;border-bottom:1px solid var(--atlas-rule);font-size:.75rem;padding:.25rem 0}.identity-lineage__records code{font-size:.75rem;background:none;padding:0}.identity-lineage__records s{color:var(--atlas-muted);font-size:.75rem;text-decoration-style:dashed}.identity-lineage__transform span{display:flex;justify-content:space-between;align-items:center;font:.77rem var(--sl-font-mono,monospace)}.identity-lineage__transform b{color:var(--atlas-teal-deep)}.identity-lineage p{font:.75rem var(--sl-font-mono,monospace);overflow-wrap:anywhere;margin:.75rem 0 .3rem!important}.identity-lineage small{font-size:.75rem;line-height:1.5;color:var(--atlas-muted)}.identity-lineage__median{display:flex;justify-content:space-between;align-items:center;height:5.3rem;background:linear-gradient(var(--atlas-rule),var(--atlas-rule)) center / 100% 1px no-repeat}.identity-lineage__median>*{background:var(--atlas-bg);padding:.4rem;font:.8rem var(--sl-font-mono,monospace)}.identity-lineage__median strong{border:1px solid var(--atlas-teal-deep);color:var(--atlas-teal-deep);font-size:1.2rem}
.identity-comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.identity-view__split{min-width:0;border-top:3px solid var(--atlas-teal-deep)}.identity-view__split--defect{border-top-style:dashed;border-color:var(--atlas-emphasis)}.identity-view__split h4{display:flex;align-items:center;gap:.5rem;font-size:.82rem;margin:.75rem 0!important}.identity-view__split h4 span{font:600 1rem var(--sl-font-mono,monospace);color:var(--atlas-teal-deep)}.identity-view__split--defect h4 span{color:var(--atlas-emphasis)}.identity-view__partition{display:flex;align-items:center;flex-wrap:wrap;gap:.4rem;min-height:3.1rem;padding:.4rem 0}.identity-view__partition>strong{width:100%;font-size:.75rem;color:var(--atlas-muted);font-weight:500}.identity-view__token{display:inline-block;padding:.4rem .6rem;border:1px solid var(--atlas-teal-deep);background:color-mix(in srgb,var(--atlas-teal) 8%,transparent);font:.75rem var(--sl-font-mono,monospace)}.identity-view__token--b{border-style:dashed;border-color:var(--atlas-muted);background:transparent}.identity-view__boundary{display:flex;justify-content:space-between;align-items:center;gap:.4rem;margin:.6rem 0;padding:.5rem 0;border-block:1px solid var(--atlas-rule);font-size:.75rem;color:var(--atlas-muted)}.identity-view__boundary b{font:600 .85rem var(--sl-font-mono,monospace);white-space:nowrap}.identity-view__split--defect .identity-view__boundary{color:var(--atlas-emphasis);border-block-style:dashed}.identity-view__split>p{font-size:.75rem;line-height:1.6;color:var(--atlas-muted);margin:.5rem 0!important}.identity-exclusions{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:1rem;margin:1rem 0;padding:.75rem 0;border-block:1px solid var(--atlas-rule);font:.75rem var(--sl-font-mono,monospace)}.identity-exclusions em{display:block;font:.75rem var(--sl-font);color:var(--atlas-muted);margin-top:.3rem}.identity-view details summary{cursor:pointer;min-height:44px;padding:.75rem 0;font-weight:600}.identity-view__scroll{max-height:24rem;max-width:100%;overflow:auto;overscroll-behavior:contain}.identity-view table{display:table;width:100%;font-size:.75rem;font-variant-numeric:tabular-nums}.identity-view caption{text-align:left;padding:.6rem 0;color:var(--atlas-muted);line-height:1.6}.identity-view th,.identity-view td{padding:.55rem;white-space:nowrap}.identity-view__scroll thead th{position:sticky;top:0;background:var(--atlas-bg)}.identity-view__frozen{border-top:1px solid var(--atlas-rule);margin-top:1rem;padding-top:.8rem}.identity-view__frozen>strong{font-size:.75rem}.identity-view__frozen>div{display:flex;flex-wrap:wrap;gap:1rem;margin:.6rem 0;font-size:.75rem}.identity-view__frozen b{margin-left:.4rem;font:600 1rem var(--sl-font-mono,monospace)}.identity-view__frozen p{font-size:.75rem;color:var(--atlas-muted)}.identity-view summary:focus-visible,.identity-view__scroll:focus-visible{outline:3px solid var(--atlas-teal-deep);outline-offset:3px}@container(max-width:34rem){.identity-lineage{grid-template-columns:1fr}.identity-lineage li{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:.3rem .8rem}.identity-lineage h4{grid-column:1}.identity-lineage__records,.identity-lineage__transform,.identity-lineage__median{grid-column:2;grid-row:1/4;min-height:0}.identity-lineage small{grid-column:1}.identity-comparison{gap:.8rem}.identity-view__partition{align-content:start;min-height:5rem}.identity-view__boundary{display:grid;min-height:3.5rem}.identity-exclusions{grid-template-columns:1fr}.identity-view__token{font-size:.75rem;padding:.35rem}.identity-view__split h4{min-height:2.6rem;font-size:.75rem}}
</style>
