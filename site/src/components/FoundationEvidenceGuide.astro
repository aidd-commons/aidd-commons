---
import ScientificIcon from "./ScientificIcon.astro";
interface Props { chinese?:boolean }
const { chinese=false }=Astro.props;
const t=(en:string,zh:string)=>chinese?zh:en;
const steps=[
  {icon:"cell",name:t("Disease context","疾病情境"),object:t("Population + phenotype","总体与表型"),evidence:t("Observed phenotype in a stated population","指定总体中的观测表型"),gap:t("Which competing explanation remains?","还保留哪种竞争解释？"),lesson:"mechanism-targets/disease-state-definition"},
  {icon:"data",name:t("Target hypothesis","靶点假设"),object:t("Gene / protein + intervention direction","基因 / 蛋白与干预方向"),evidence:t("Genetics or perturbation in context","情境匹配的遗传或扰动证据"),gap:t("What independent validation could change the hypothesis?","哪项独立验证可改变假设？"),lesson:"mechanism-targets/perturbation-to-target-validation"},
  {icon:"assay",name:t("Molecule + assay","分子与 assay"),object:t("Entity + endpoint + controls","实体、终点与对照"),evidence:t("Readout under named measurement conditions","指定测量条件下的读出"),gap:t("Could the detector explain the signal?","检测器能否解释该信号？"),lesson:"drug-discovery-foundations/assay-controls-dose-response"},
  {icon:"simulation",name:t("Exposure + constraints","暴露与约束"),object:t("Time course + selectivity + safety","时程、选择性与安全性"),evidence:t("Context-matched exposure and constraint evidence","情境匹配的暴露与约束证据"),gap:t("Which requirement is still unmeasured?","哪项要求仍未测量？"),lesson:"admet-pk/exposure-clearance-pkpd"},
  {icon:"data",name:t("Candidate dossier","候选档案"),object:t("Complete requirements + unknown fields","完整要求与未知字段"),evidence:t("Endpoint-specific evidence for every required gate","每项必要门槛的终点特异证据"),gap:t("What failed or missing field determines the next action?","哪项失败或缺失字段决定下一行动？"),lesson:"candidate-nomination/capstone-workbook"},
] as const;
---
<div class="foundation-guide" data-foundation-guide>
  <nav class="foundation-guide__objects" aria-label={t("Choose a discovery object","选择发现对象")}>
    {steps.map((step,index)=><button type="button" disabled data-foundation-select={index} aria-pressed={index===0} aria-controls={"foundation-evidence-"+index}><span class="foundation-guide__index">0{index+1}</span><ScientificIcon name={step.icon} size={58}/><strong>{step.name}</strong><span>{step.object}</span></button>)}
  </nav>
  {steps.map((step,index)=><section id={"foundation-evidence-"+index} data-foundation-panel={index} hidden={index>0} class="foundation-guide__evidence"><div><span>{t("Object","对象")}</span><strong>{step.object}</strong></div><div><span>{t("Evidence to inspect","待检查证据")}</span><strong>{step.evidence}</strong></div><div class="foundation-guide__gap"><span>{t("Open question","未决问题")}</span><strong>{step.gap}</strong></div><a href={(chinese?"/zh-cn":"")+"/learn/"+step.lesson+"/"}>{t("Inspect this decision","检查此决策")} ↗</a></section>)}
  <noscript><style>.foundation-guide [data-foundation-panel][hidden]{display:grid!important}.foundation-guide__objects button{pointer-events:none}</style></noscript>
</div>
<script>
function initializeFoundationGuides(){document.querySelectorAll<HTMLElement>("[data-foundation-guide]").forEach(root=>{if(root.dataset.initialized)return;root.dataset.initialized="true";const buttons=Array.from(root.querySelectorAll<HTMLButtonElement>("[data-foundation-select]"));buttons.forEach((button,index)=>{button.disabled=false;button.addEventListener("click",()=>{buttons.forEach(item=>item.setAttribute("aria-pressed",String(item===button)));root.querySelectorAll<HTMLElement>("[data-foundation-panel]").forEach(panel=>panel.hidden=panel.dataset.foundationPanel!==button.dataset.foundationSelect)});button.addEventListener("keydown",event=>{if(!["ArrowLeft","ArrowRight","Home","End"].includes(event.key))return;event.preventDefault();const next=event.key==="Home"?0:event.key==="End"?buttons.length-1:(index+(event.key==="ArrowRight"?1:-1)+buttons.length)%buttons.length;buttons[next].focus();buttons[next].click()})})})}initializeFoundationGuides();document.addEventListener("astro:page-load",initializeFoundationGuides);
</script>
<style>
.foundation-guide{min-width:0}.foundation-guide__objects{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0;border-block:1px solid var(--atlas-rule)}.foundation-guide__objects button{position:relative;display:grid;gap:.45rem;align-content:start;text-align:left;color:var(--atlas-ink);background:transparent;border:0;border-bottom:3px solid transparent;border-right:1px solid var(--atlas-rule);padding:.85rem .75rem;min-width:0;cursor:pointer;font:inherit}.foundation-guide__objects button:last-child{border-right:0}.foundation-guide__objects button[aria-pressed=true]{border-bottom-color:var(--atlas-teal-deep);background:color-mix(in srgb,var(--atlas-teal) 7%,transparent)}.foundation-guide__index{position:absolute;right:.75rem;top:.75rem;font:.75rem var(--sl-font-mono,monospace);color:var(--atlas-muted)}.foundation-guide__objects strong{font-size:.8rem;line-height:1.4}.foundation-guide__objects button>span:last-child{font-size:.75rem;line-height:1.5;color:var(--atlas-muted)}.foundation-guide__evidence{display:grid;grid-template-columns:1fr 1fr 1.3fr;gap:1rem;padding:1rem 0;align-items:start}.foundation-guide__evidence[hidden]{display:none}.foundation-guide__evidence>div{min-width:0}.foundation-guide__evidence span{display:block;font-size:.75rem;text-transform:uppercase;color:var(--atlas-muted);margin-bottom:.4rem}.foundation-guide__evidence strong{font-size:.8rem;font-weight:550;line-height:1.6}.foundation-guide__gap{padding-left:.8rem;border-left:2px dashed var(--atlas-emphasis)}.foundation-guide__evidence>a{grid-column:1/-1;font-size:.76rem;justify-self:end}.foundation-guide button:focus-visible,.foundation-guide a:focus-visible{outline:3px solid var(--atlas-teal-deep);outline-offset:3px}@container(max-width:35rem){.foundation-guide__objects{grid-template-columns:repeat(2,minmax(0,1fr))}.foundation-guide__objects button:last-child{grid-column:1/-1;grid-template-columns:auto 1fr;align-items:center}.foundation-guide__objects button:last-child strong{grid-column:2}.foundation-guide__evidence{grid-template-columns:1fr}.foundation-guide__objects button>span:last-child{display:none}}
</style>
