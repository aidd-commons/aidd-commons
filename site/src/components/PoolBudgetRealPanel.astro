---
import summary from "../../../labs/pool_budget/real-summary.json";
import ScientificPlot from "./ScientificPlot.astro";

const percent = (value: number) => `${(100 * value).toFixed(2)}%`;
const download = `data:application/json;charset=utf-8,${encodeURIComponent(JSON.stringify(summary, null, 2))}`;
const recoveryAxisMaximum = Math.ceil(Math.max(...Object.values(summary.assays).flatMap(assay => assay.policies.flatMap(policy => policy.recovery))) * 10) / 10;
---

<section class="real-pool-panel" aria-labelledby="real-campaign-title">
  <p class="panel-kicker">Retrospective assay replay · reading saved results</p>
  <h2 id="real-campaign-title">Real ChEMBL campaign results</h2>
  <p>Completed {summary.completed_on}. Two retrospective assay replays with fixed
    Morgan Ridge alpha=1; these are observed assay scores, not the artificial
    scores in the synthetic calculator.</p>
  <p><strong>MaxMin recovered fewer top-decile targets than every fixed random
    policy instance in both assays, with lower recovery AUC.</strong> Greater
    structural diversity did not imply better target recovery in this exercise.
    Final evaluation MAE did not consistently favor MaxMin.</p>
  {Object.entries(summary.assays).map(([id, assay], index) => (
    <section aria-labelledby={`real-${id}`}>
      <p class="panel-letter">({index === 0 ? "a" : "b"}) <span>{assay.budget.original_pool_parent_count} original-pool parents · {assay.budget.top_decile_size} top-decile targets</span></p>
      <h3 id={`real-${id}`}>{id}</h3>
      <p>Initial / pool / evaluation: {assay.partitions.initial.parents} / {assay.partitions.pool.parents} / {assay.partitions.evaluation.parents} parents;
        {" "}{assay.partitions.initial.groups} / {assay.partitions.pool.groups} / {assay.partitions.evaluation.groups} scaffold groups.</p>
      <p>Four batches of {assay.budget.batch_size} acquire {assay.budget.acquired_count} of {assay.budget.original_pool_parent_count} original-pool parents
        ({percent(assay.budget.actual_budget_fraction)}).
        Recovery denominator: {assay.budget.top_decile_size} top-decile pool targets.
        MAE denominator: {assay.partitions.evaluation.parents} evaluation parents.</p>
      <div class="campaign-view">
        <div class="campaign-curve">
          <ScientificPlot title={`${id}: every frozen recovery path`} xLabel="Acquired parents from the original pool" yLabel={`Top-decile recovery fraction · denominator ${assay.budget.top_decile_size}`} xMin={0} xMax={assay.budget.acquired_count} xTicks={assay.budget.checkpoints} yMin={0} yMax={recoveryAxisMaximum} yTicks={[0, .1, .2, recoveryAxisMaximum]} showTable={false} series={assay.policies.map((policy, policyIndex) => ({ name: policy.name, color: policyIndex === 0 ? "var(--atlas-teal-deep)" : "var(--atlas-muted)", marker: policyIndex, dashed: policyIndex !== 0, points: assay.budget.checkpoints.map((count, round) => ({ x: count, y: policy.recovery[round] })) }))} />
        </div>
        <aside class="campaign-denominators" aria-label={`${id} population and budget definitions`}>
          <h4>Read the denominators</h4>
          <dl><div><dt>Acquisition budget</dt><dd>{assay.budget.acquired_count} / {assay.budget.original_pool_parent_count}<small>parents · {percent(assay.budget.actual_budget_fraction)}</small></dd></div><div><dt>Recovery</dt><dd>{assay.budget.top_decile_size}<small>top-decile targets in the original pool</small></dd></div><div><dt>Predictive error</dt><dd>{assay.partitions.evaluation.parents}<small>held evaluation parents · MAE in pChEMBL</small></dd></div></dl>
          <p>Five fixed checkpoints; all six policy paths. The common recovery axis ends at {recoveryAxisMaximum.toFixed(2)}; complete recovery is 1.</p>
        </aside>
      </div>
      {assay.partitions.pool.groups === 1 && <p class="limitation">
        Its original pool contains one scaffold group. Every policy covers that
        group after the first batch, so scaffold coverage cannot distinguish the policies.
        The frozen partition was not changed after this observation.
      </p>}
      <div class="table-scroll" role="region" aria-label={`${id} final campaign scores`} tabindex="0">
        <table>
          <caption>Final checkpoint: {assay.budget.acquired_count} acquired parents; every policy shown</caption>
          <thead><tr>
            <th scope="col">Policy</th><th scope="col">Recovery AUC</th>
            <th scope="col">Final recovery</th><th scope="col">Scaffold coverage</th>
            <th scope="col">Evaluation MAE</th>
          </tr></thead>
          <tbody>{assay.policies.map(policy => <tr>
            <th scope="row">{policy.name}</th>
            <td title={String(policy.normalized_auc)}>{policy.normalized_auc.toFixed(8)}</td>
            <td title={String(policy.recovery[4])}>{percent(policy.recovery[4])}</td>
            <td title={String(policy.scaffold_fraction[4])}>{percent(policy.scaffold_fraction[4])}</td>
            <td title={String(policy.evaluation_mae[4])}>{policy.evaluation_mae[4].toFixed(6)}</td>
          </tr>)}</tbody>
        </table>
      </div>
      <details>
        <summary>All checkpoints for {id}</summary>
        <div class="table-scroll" role="region" aria-label={`${id} all checkpoint scores`} tabindex="0">
          <table>
            <caption>Five fixed checkpoints per policy; no omitted seeds or rounds</caption>
            <thead><tr>
              <th scope="col">Policy</th><th scope="col">Acquired parents</th>
              <th scope="col">Recovery</th><th scope="col">Scaffold coverage</th>
              <th scope="col">Evaluation MAE</th>
            </tr></thead>
            <tbody>{assay.policies.flatMap(policy => assay.budget.checkpoints.map((count, round) => <tr>
              <th scope="row">{policy.name}</th><td>{count}</td>
              <td title={String(policy.recovery[round])}>{percent(policy.recovery[round])}</td>
              <td title={String(policy.scaffold_fraction[round])}>{percent(policy.scaffold_fraction[round])}</td>
              <td title={String(policy.evaluation_mae[round])}>{policy.evaluation_mae[round].toFixed(6)}</td>
            </tr>))}</tbody>
          </table>
        </div>
      </details>
    </section>
  ))}
  <p>Recovery AUC integrates recovery at the declared acquired-count checkpoints,
    divided by the final acquired count; it is not ROC AUC. Scaffold coverage
    divides acquired groups by the original pool's groups. Initial labels are
    shared sunk costs, excluded from the incremental acquisition budget.</p>
  <ul>{summary.interpretation.map(note => <li>{note}</li>)}</ul>
  <p>Tables round for readability. <a href={download} download="pool-budget-real-summary.json">Download all aggregate scores (JSON)</a>
    {" "}for full precision. No compound identities, labels, predictions, or
    acquisition memberships are included.</p>
</section>

<style>
  .real-pool-panel { min-width: 0; padding-block: 1.5rem; margin-block: 2rem; border-block: 1px solid var(--atlas-rule-strong);color:var(--atlas-ink); }
  .real-pool-panel>h2{margin-top:.35rem}.panel-kicker{font-size:.75rem;color:var(--atlas-teal-deep);font-weight:700;letter-spacing:.06em;text-transform:uppercase}.real-pool-panel>p>strong{font-weight:650}
  .real-pool-panel section { min-width: 0; margin-block: 1.5rem;padding-top:1.2rem;border-top:1px solid var(--atlas-rule); }.real-pool-panel section>p{font-size:.82rem;color:var(--atlas-muted)}.real-pool-panel h3{font-size:1.1rem;margin-top:.4rem}
  .panel-letter{display:flex;justify-content:space-between;gap:.7rem;font-size:.75rem;color:var(--atlas-ink)!important;font-weight:700}.panel-letter span{font-weight:400;color:var(--atlas-muted)}
  .campaign-view{display:grid;grid-template-columns:minmax(0,2fr) minmax(11rem,1fr);gap:1.5rem;margin-block:1.25rem}.campaign-curve{min-width:0}.campaign-denominators{border-left:1px solid var(--atlas-rule);padding-left:1rem}.campaign-denominators h4{font-size:.8rem;margin:.6rem 0}.campaign-denominators dl{margin:0}.campaign-denominators dl>div{padding:.7rem 0;border-bottom:1px solid var(--atlas-rule)}.campaign-denominators dt{font-size:.75rem;color:var(--atlas-muted)}.campaign-denominators dd{margin:.25rem 0 0;font-size:1.25rem;font-variant-numeric:tabular-nums}.campaign-denominators small{display:block;font-size:.75rem;line-height:1.45;color:var(--atlas-muted);margin-top:.2rem}.campaign-denominators>p{font-size:.75rem;color:var(--atlas-muted)}
  .table-scroll { max-width: 100%; overflow-x: auto; }
  table { display: table; overflow: visible; width: 100%; font-variant-numeric: tabular-nums;font-size:.8rem; }
  th, td { padding: .6rem; white-space: nowrap; }
  caption { text-align: left; white-space: normal;padding-block:.65rem;color:var(--atlas-muted); }
  details { margin-top: .75rem; }
  summary { cursor: pointer; padding-block: .65rem;min-height:44px;font-size:.82rem;font-weight:600; }
  .limitation { padding: .75rem; border-left: 3px solid var(--atlas-emphasis); background: color-mix(in srgb,var(--atlas-emphasis) 8%,transparent); }
  .real-pool-panel>ul,.real-pool-panel>p:last-child{font-size:.82rem}.table-scroll:focus-visible,summary:focus-visible{outline:3px solid var(--atlas-teal-deep);outline-offset:3px}
  @media(max-width:54rem){.campaign-view{grid-template-columns:minmax(0,1fr)}.campaign-denominators{border-left:0;border-top:1px solid var(--atlas-rule);padding:0}.campaign-denominators dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}}
  @media(max-width:32rem){.campaign-denominators dl{grid-template-columns:minmax(0,1fr)}.panel-letter{flex-wrap:wrap}}
</style>
