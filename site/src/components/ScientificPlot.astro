---
import {plotFraction, valueAtPlotFraction} from "../lib/scientific-plot";
export interface PlotPoint { x: number; y: number; label?: string }
export interface PlotSeries {
  name: string;
  points: PlotPoint[];
  dashed?: boolean;
  color?: string;
  marker?: number;
  connect?: boolean;
}
interface Props {
  title: string;
  xLabel: string;
  yLabel: string;
  series: PlotSeries[];
  xMin?: number;
  xMax?: number;
  yMin?: number;
  yMax?: number;
  xTicks?: number[];
  xScale?: "linear" | "log";
  yTicks?: number[];
  yTickLabels?: string[];
  scatter?: boolean;
  chinese?: boolean;
  showTable?: boolean;
  /** Related plots inspect the nearest retained x together; their axes stay independent. */
  syncGroup?: string;
}
const { title, xLabel, yLabel, series, xMin = 0, xMax = 1, yMin = 0, yMax = 1, xTicks, yTicks, yTickLabels, xScale = "linear", scatter = false, chinese = false, showTable = true, syncGroup } = Astro.props;
if (![xMin, xMax, yMin, yMax].every(Number.isFinite) || xMax <= xMin || yMax <= yMin) {
  throw new Error("ScientificPlot requires finite, increasing axis limits: " + title);
}
if (series.some(line => line.points.some(point => !Number.isFinite(point.x) || !Number.isFinite(point.y)))) {
  throw new Error("ScientificPlot cannot display a non-finite source value: " + title);
}
const palette = ["var(--atlas-teal)", "var(--atlas-coral)", "var(--atlas-ink)", "var(--atlas-muted)", "var(--atlas-teal-deep)"];
const px = (x: number) => 100 * plotFraction(x, xMin, xMax, xScale);
const py = (y: number) => 100 * (y - yMin) / (yMax - yMin);
const fractions = [0, .25, .5, .75, 1];
const horizontalTicks = xTicks ?? fractions.map(fraction => valueAtPlotFraction(fraction, xMin, xMax, xScale));
const verticalTicks = yTicks ?? fractions.map(fraction => yMin + fraction * (yMax - yMin));
if (horizontalTicks.some(value => !Number.isFinite(value) || value < xMin || value > xMax) || verticalTicks.some(value => !Number.isFinite(value) || value < yMin || value > yMax)) {
  throw new Error("ScientificPlot ticks must lie inside their axis limits: " + title);
}
const tick = (value: number) => Number(value.toPrecision(3)).toString();
// Validate every source x even for a disconnected or single-point series.
series.forEach(line => line.points.forEach(point => px(point.x)));
const color = (line: PlotSeries, index: number) => line.color ?? palette[index % palette.length];
const marker = (line: PlotSeries, index: number) => ((line.marker ?? index) % 7 + 7) % 7;
// The table, initial download and marks share the same source series. Filtering is display-only.
const hasPointLabels = series.some(line => line.points.some(point => point.label));
const headers = [chinese ? "序列" : "Series", ...(hasPointLabels ? [chinese ? "点标签" : "Point label"] : []), xLabel, yLabel];
const rows = series.flatMap((line, index) => line.points.map((point, pointIndex) => ({
  index, pointIndex, cells: [line.name, ...(hasPointLabels ? [point.label ?? ""] : []), String(point.x), String(point.y)],
})));
const csvCell = (value: string) => '"' + value.replaceAll('"', '""') + '"';
const csv = [headers, ...rows.map(row => row.cells)].map(row => row.map(csvCell).join(",")).join("\r\n");
---
<div class="science-plot not-content" data-science-plot data-chinese={chinese ? "true" : "false"} data-plot-series={JSON.stringify(series)} data-x-label={xLabel} data-y-label={yLabel} data-x-min={xMin} data-x-max={xMax} data-x-scale={xScale} data-sync-group={syncGroup} style={yTickLabels?{"--plot-axis":"5.2rem"}:undefined}>
  <p class="science-plot__title">{title}</p>
  <div class="science-plot__workspace"><div class="science-plot__chart">
  <p class="science-plot__quantity">{yLabel}</p>
  <div class="science-plot__body" data-plot-surface role="group" aria-label={title + ". " + yLabel + "; " + xLabel}>
    <div class="science-plot__cursor" data-plot-cursor hidden aria-hidden="true" />
    {verticalTicks.map((value,index) => <div class="science-plot__grid" style={{ bottom: py(value) + "%" }}><span>{yTickLabels?.[index] ?? tick(value)}</span></div>)}
    {horizontalTicks.map(value => <div class="science-plot__vertical" style={{ left: px(value) + "%" }} />)}
    {series.map((line, index) => (
      <div class="science-plot__series" style={{ "--series-color": color(line, index) }} data-series={line.name} data-series-index={index}>
        {!scatter && line.connect !== false && line.points.slice(1).map((point, i) => {
          const previous = line.points[i];
          const dx = px(point.x) - px(previous.x);
          const dy = py(point.y) - py(previous.y);
          return <i class:list={["science-plot__line", { "is-dashed": line.dashed }]} data-from={previous.x + "," + previous.y} data-to={point.x + "," + point.y} style={{ left: px(previous.x) + "%", bottom: py(previous.y) + "%", width: "hypot(" + dx + "cqw," + dy + "cqh)", transform: "translateY(50%) rotate(atan2(" + (-dy) + "cqh," + dx + "cqw))" }} />;
        })}
        {line.points.map((point, pointIndex) => (
          <span class:list={["science-plot__point", "marker-" + marker(line, index)]} data-x={point.x} data-y={point.y} data-point-index={pointIndex} style={{ left: px(point.x) + "%", bottom: py(point.y) + "%" }}>
            {point.label && <b>{point.label}</b>}
          </span>
        ))}
      </div>
    ))}
  </div>
  <div class="science-plot__x-ticks">{horizontalTicks.map(value => <span style={{ left: px(value) + "%" }}>{tick(value)}</span>)}</div>
  <p class="science-plot__x-label">{xLabel}</p>
  </div><aside class="science-plot__inspector" data-plot-inspector hidden aria-label={title + (chinese ? "：所选数据点" : ": selected source points")}>
    <p class="science-plot__inspector-label">{chinese ? "检查保留的数据点" : "Inspect retained points"}</p>
    <p class="science-plot__coordinate"><span>{xLabel}</span><output data-plot-x></output></p>
    <ul data-plot-values></ul>
    <p class="science-plot__exact" data-plot-exact role="note"></p>
    <label class="science-plot__scrubber">{chinese ? "沿横轴选择数据点" : "Select a source x value"}<input type="range" data-plot-range min="0" max="0" value="0" step="1" /></label>
  </aside></div>
  <div class="science-plot__readout">
    <p class="science-plot__help" data-plot-help hidden>{chinese ? "点击图中位置或使用方向键检查数据点；图例切换序列，坐标范围不变。" : "Click the plot or use arrow keys to inspect points. Legend items filter series; axes stay fixed."}</p>
    <output data-plot-status role="status" aria-live="polite" aria-atomic="true" hidden></output>
  </div>
  <ul class="science-plot__legend" aria-label={chinese ? "序列图例" : "Series legend"}>
    {series.map((line, index) => <li style={{ "--series-color": color(line, index) }}><button type="button" disabled aria-pressed="true" data-series-toggle={index}><span class:list={["science-plot__key", { "is-dashed": line.dashed, "is-scatter": scatter || line.connect === false }]} aria-hidden="true"><i class={"marker-" + marker(line, index)} /></span><span>{line.name}</span></button></li>)}
  </ul>
  <div class="science-plot__actions">
    <button type="button" data-series-reset hidden>{chinese ? "显示全部序列" : "Show all series"}</button>
    {showTable && <a data-plot-download href={"data:text/csv;charset=utf-8," + encodeURIComponent("\ufeff" + csv)} download="displayed-plot-data.csv">{chinese ? "下载所示数据 CSV" : "Download displayed data CSV"}</a>}
  </div>
  {showTable && <details class="science-plot__table"><summary>{chinese ? "查看所示数据的表格" : "Read displayed data as a table"} <span data-plot-row-count>({rows.length})</span></summary><div class="science-table-scroll" tabindex="0" role="region" aria-label={title + (chinese ? "数据表" : " data table")}><table><caption>{title} · {chinese ? "与图中所示序列一致；保留源值精度" : "Matches the displayed series; source precision retained"}</caption><thead><tr>{headers.map(header => <th scope="col">{header}</th>)}</tr></thead><tbody>{rows.map(row => <tr data-series-row={row.index} data-point-row={row.pointIndex}>{row.cells.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div></details>}
</div>
<script>
  import {retainedXValues,nearestRetainedX,pointsAtNearestX,readablePlotValue,plotFraction,valueAtPlotFraction,type PlotScale} from "../lib/scientific-plot";
  interface SourcePoint { x: number; y: number; label?: string }
  interface SourceSeries { name: string; points: SourcePoint[] }
  function initializeScientificPlots() {
    document.querySelectorAll<HTMLElement>("[data-science-plot]").forEach(root => {
      if (root.dataset.plotReady) return;
      root.dataset.plotReady = "true";
      const chinese = root.dataset.chinese === "true";
      const series = JSON.parse(root.dataset.plotSeries ?? "[]") as SourceSeries[];
      const xs = retainedXValues(series);
      const toggles = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-series-toggle]"));
      const status = root.querySelector<HTMLOutputElement>("[data-plot-status]")!;
      const reset = root.querySelector<HTMLButtonElement>("[data-series-reset]")!;
      const download = root.querySelector<HTMLAnchorElement>("[data-plot-download]");
      const surface = root.querySelector<HTMLElement>("[data-plot-surface]")!;
      const cursor = root.querySelector<HTMLElement>("[data-plot-cursor]")!;
      const range = root.querySelector<HTMLInputElement>("[data-plot-range]")!;
      const values = root.querySelector<HTMLElement>("[data-plot-values]")!;
      let selectedX = xs[0];
      const csvCell = (value: string) => '"' + value.replaceAll('"', '""') + '"';
      const visible = () => new Set(toggles.filter(button => button.getAttribute("aria-pressed") === "true").map(button => Number(button.dataset.seriesToggle)));
      function inspect(x: number, announce = false) {
        const retained = nearestRetainedX(xs,x,root.dataset.xScale as PlotScale);
        if (retained === undefined) return;
        selectedX = retained;
        range.value = String(xs.indexOf(selectedX));
        range.setAttribute("aria-valuetext", `${root.dataset.xLabel}: ${readablePlotValue(selectedX)}`);
        const xOutput=root.querySelector<HTMLOutputElement>("[data-plot-x]")!;
        xOutput.textContent=readablePlotValue(selectedX);xOutput.title=String(selectedX);xOutput.dataset.exactValue=String(selectedX);
        const exact=root.querySelector<HTMLElement>("[data-plot-exact]")!;
        const exactValues=[`${root.dataset.xLabel}: ${selectedX}`];
        const shown = visible();
        cursor.hidden = !shown.size;
        cursor.style.left = `${100 * plotFraction(selectedX,Number(root.dataset.xMin),Number(root.dataset.xMax),root.dataset.xScale as PlotScale)}%`;
        values.replaceChildren();
        root.querySelectorAll<HTMLElement>("[data-point-index], [data-point-row]").forEach(node => node.classList.remove("is-inspected"));
        series.forEach((line,index) => {
          if (!shown.has(index) || !line.points.length) return;
          pointsAtNearestX(line.points,selectedX).forEach(({point,index:pointIndex}) => {
          root.querySelector(`[data-series-index="${index}"] [data-point-index="${pointIndex}"]`)?.classList.add("is-inspected");
          root.querySelector(`[data-series-row="${index}"][data-point-row="${pointIndex}"]`)?.classList.add("is-inspected");
          const item = document.createElement("li");
          const seriesNode = root.querySelector<HTMLElement>(`[data-series-index="${index}"]`);
          if (seriesNode) item.style.setProperty("--series-color", seriesNode.style.getPropertyValue("--series-color"));
          const keyNode = toggles[index]?.querySelector(".science-plot__key")?.cloneNode(true) as HTMLElement | undefined;
          const name = document.createElement("span"); name.textContent = line.name;
          if (keyNode) name.prepend(keyNode);
          const value = document.createElement("strong"); value.textContent = readablePlotValue(point.y);
          value.title=String(point.y);value.dataset.exactValue=String(point.y);
          value.setAttribute("aria-label",`${line.name}: ${point.y}`);
          exactValues.push(`${line.name}${point.label ? " · "+point.label : ""}: x=${point.x}; y=${point.y}`);
          const detail = document.createElement("small");
          detail.textContent = [point.label, point.x !== selectedX ? `${root.dataset.xLabel}: ${readablePlotValue(point.x)}` : ""].filter(Boolean).join(" · ");
          item.append(name, value); if (detail.textContent) item.append(detail);
          values.append(item);
          });
        });
        exact.textContent=(chinese?"精确来源值。":"Exact source values. ")+exactValues.join(". ");
        if (!shown.size) { const empty = document.createElement("li"); empty.textContent = chinese ? "没有显示的序列" : "No series shown"; values.append(empty); }
        if (announce) {
          root.dispatchEvent(new CustomEvent("science-plot-select", {bubbles:true, detail:{x:selectedX}}));
          if (root.dataset.syncGroup) document.querySelectorAll<HTMLElement>("[data-science-plot]").forEach(other => {
            if (other !== root && other.dataset.syncGroup === root.dataset.syncGroup) other.dispatchEvent(new CustomEvent("science-plot-select-x", {detail:{x:selectedX}}));
          });
        }
      }
      function update() {
        const shown = visible();
        root.querySelectorAll<HTMLElement>("[data-series-index]").forEach(line => { line.hidden = !shown.has(Number(line.dataset.seriesIndex)); });
        const rows = Array.from(root.querySelectorAll<HTMLTableRowElement>("[data-series-row]"));
        rows.forEach(row => { row.hidden = !shown.has(Number(row.dataset.seriesRow)); });
        const shownRows = rows.filter(row => !row.hidden);
        const count = root.querySelector("[data-plot-row-count]");
        if (count) count.textContent = `(${shownRows.length})`;
        status.textContent = chinese ? `显示 ${shown.size} / ${toggles.length} 个序列` : `${shown.size} of ${toggles.length} series shown`;
        reset.disabled = shown.size === toggles.length;
        if (download) {
          const headers = Array.from(root.querySelectorAll("thead th"), cell => cell.textContent ?? "");
          const cells = shownRows.map(row => Array.from(row.cells, cell => cell.textContent ?? ""));
          download.href = "data:text/csv;charset=utf-8," + encodeURIComponent("\ufeff" + [headers, ...cells].map(row => row.map(csvCell).join(",")).join("\r\n"));
        }
        inspect(selectedX);
      }
      toggles.forEach(button => {
        button.disabled = false;
        button.addEventListener("click", () => {
          button.setAttribute("aria-pressed", button.getAttribute("aria-pressed") === "true" ? "false" : "true");
          update();
        });
      });
      surface.tabIndex = 0;
      surface.setAttribute("aria-label", surface.getAttribute("aria-label") + (chinese ? "。方向键选择保留的数据点，Home 和 End 跳到两端。" : ". Arrow keys inspect retained x values; Home and End select the endpoints."));
      range.max = String(Math.max(0,xs.length-1));
      range.disabled = !xs.length;
      if (!xs.length) {root.querySelector<HTMLOutputElement>("[data-plot-x]")!.textContent="—";values.textContent=chinese?"没有保留的数据点":"No retained source points";surface.removeAttribute("tabindex");}
      range.addEventListener("input", () => inspect(xs[Number(range.value)], true));
      surface.addEventListener("keydown", event => {
        if (!["ArrowLeft","ArrowRight","ArrowUp","ArrowDown","Home","End"].includes(event.key)) return;
        event.preventDefault();
        const index = event.key === "Home" ? 0 : event.key === "End" ? xs.length-1 : xs.indexOf(selectedX) + (["ArrowRight","ArrowUp"].includes(event.key) ? 1 : -1);
        inspect(xs[Math.max(0,Math.min(xs.length-1,index))],true);
      });
      surface.addEventListener("click", event => {
        const bounds = surface.getBoundingClientRect();
        const x = valueAtPlotFraction((event.clientX-bounds.left)/bounds.width,Number(root.dataset.xMin),Number(root.dataset.xMax),root.dataset.xScale as PlotScale);
        inspect(x,true);
      });
      root.addEventListener("science-plot-select-x", event => inspect((event as CustomEvent<{x:number}>).detail.x));
      root.querySelector<HTMLElement>("[data-plot-inspector]")!.hidden = false;
      reset.hidden = false; status.hidden = false;
      root.querySelector<HTMLElement>("[data-plot-help]")!.hidden = false;
      reset.addEventListener("click", () => { toggles.forEach(button => button.setAttribute("aria-pressed", "true")); update(); });
      update();
    });
  }
  initializeScientificPlots();
  document.addEventListener("astro:page-load", initializeScientificPlots);
</script>
<style>
  .science-plot__workspace{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem}.science-plot__chart{min-width:0}.science-plot__inspector{min-width:0;padding:.75rem 0;border-block:1px solid var(--atlas-rule);align-self:start}.science-plot__inspector-label{font-size:.75rem;color:var(--atlas-teal-deep);font-weight:650;margin:0 0 .6rem!important}.science-plot__coordinate{display:flex;align-items:baseline;justify-content:space-between;gap:.6rem;margin:0!important;font-size:.75rem}.science-plot__coordinate span{max-width:75%;color:var(--atlas-muted)}.science-plot__coordinate output{font-size:1.2rem;font-weight:650;font-variant-numeric:tabular-nums}.science-plot__inspector ul{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,11rem),1fr));list-style:none;padding:0;margin:.6rem 0!important;gap:.25rem 1rem}.science-plot__inspector :global(li){display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.2rem .5rem;padding:.32rem 0;border-top:1px solid var(--atlas-rule);font-size:.74rem;overflow-wrap:anywhere}.science-plot__inspector :global(li > span){display:inline-flex;align-items:center;gap:.35rem;min-width:0}.science-plot__inspector :global(li .science-plot__key){flex:0 0 1.35rem;width:1.35rem}.science-plot__inspector :global(li .science-plot__key i){position:relative;display:block;width:.48rem;height:.48rem}.science-plot__inspector :global(li .science-plot__key i::before){content:"";display:block;box-sizing:border-box;width:100%;height:100%;background:var(--series-color);border:1px solid var(--sl-color-bg);border-radius:50%}.science-plot__inspector :global(li strong){overflow-wrap:anywhere;min-width:0;font-size:.78rem;font-variant-numeric:tabular-nums;font-weight:650;margin-left:auto}.science-plot__inspector :global(small){flex:1 1 100%;color:var(--atlas-muted)}.science-plot__scrubber{display:grid;gap:.3rem;font-size:.75rem;color:var(--atlas-muted)}.science-plot__scrubber input{min-height:32px;width:100%;margin:0;accent-color:var(--atlas-teal-deep)}.science-plot__cursor{position:absolute;inset-block:0;border-left:1px dashed var(--atlas-ink);pointer-events:none;z-index:3}.science-plot__point.is-inspected{z-index:4;filter:drop-shadow(0 0 2px var(--atlas-panel));outline:2px solid var(--series-color);outline-offset:3px;border-radius:50%}.science-table-scroll tr.is-inspected{background:color-mix(in srgb,var(--atlas-teal) 12%,var(--atlas-panel))!important}.science-plot__body[data-plot-surface]{cursor:crosshair}.science-plot__body:focus-visible,.science-plot__scrubber input:focus-visible{outline:3px solid var(--atlas-teal-deep);outline-offset:5px}@container(min-width:44rem){.science-plot__workspace{grid-template-columns:minmax(0,1fr) 13.5rem;gap:1.2rem}.science-plot__inspector ul{grid-template-columns:minmax(0,1fr)}}
  .science-plot__exact{position:absolute!important;width:1px;height:1px;padding:0!important;margin:-1px!important;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .science-plot { container-type:inline-size; min-width:0; padding:.8rem 0 .3rem; --plot-axis:2.8rem; --plot-edge:1.1rem; }
  .science-plot__title { font-size:.95rem; font-weight:650; line-height:1.45; margin:0 0 .6rem!important; }
  .science-plot__quantity { font-size:.75rem; line-height:1.5; color:var(--sl-color-gray-2); margin:0 var(--plot-edge) .7rem var(--plot-axis)!important; }
  .science-plot__body { position:relative; container-type:size; aspect-ratio:1.75; margin:0 var(--plot-edge) 0 var(--plot-axis); border-left:1px solid var(--sl-color-gray-3); border-bottom:1px solid var(--sl-color-gray-3); isolation:isolate; }
  .science-plot__grid { position:absolute; inset-inline:0; border-top:1px solid var(--sl-color-gray-5); }
  .science-plot__grid > span { position:absolute; right:calc(100% + .5rem); top:-.55rem; font:.75rem var(--sl-font-mono,monospace); line-height:1.2; color:var(--sl-color-gray-2); white-space:nowrap; }
  .science-plot__vertical { position:absolute; inset-block:0; border-left:1px dotted var(--sl-color-gray-6); z-index:-1; }
  .science-plot__line { position:absolute; display:block; height:1.8px; border:0; background:var(--series-color); transform-origin:left center; }
  .science-plot__line.is-dashed { background:repeating-linear-gradient(to right,var(--series-color) 0,var(--series-color) 5px,transparent 5px,transparent 8px); }
  .science-plot__point { position:absolute; width:.52rem; height:.52rem; transform:translate(-50%,50%); }
  .science-plot__point::before,.science-plot__legend i::before { content:""; display:block; box-sizing:border-box; width:100%; height:100%; background:var(--series-color); border:1px solid var(--sl-color-bg); border-radius:50%; }
  .marker-1::before { border-radius:0!important; }
  .marker-2::before { border-radius:0!important; transform:rotate(45deg); }
  .marker-3::before { background:var(--sl-color-bg)!important; border:2px solid var(--series-color)!important; }
  .marker-4::before { border:0!important; border-radius:0!important; clip-path:polygon(50% 0,100% 100%,0 100%); }
  .marker-5::before { border:0!important; border-radius:0!important; clip-path:polygon(35% 0,65% 0,65% 35%,100% 35%,100% 65%,65% 65%,65% 100%,35% 100%,35% 65%,0 65%,0 35%,35% 35%); }
  .marker-6::before { border-radius:0!important; background:var(--sl-color-bg)!important; border:2px solid var(--series-color)!important; transform:rotate(45deg); }
  .science-plot__point b { position:absolute; bottom:.85rem; left:.2rem; font:650 .75rem var(--sl-font); line-height:1.3; white-space:nowrap; color:var(--sl-color-text); }
  .science-plot__x-ticks { position:relative; height:1.35rem; margin:.45rem var(--plot-edge) 0 var(--plot-axis); font:.75rem var(--sl-font-mono,monospace); color:var(--sl-color-gray-2); }
  .science-plot__x-ticks span { position:absolute; transform:translateX(-50%); white-space:nowrap; }
  .science-plot__x-label { margin:.1rem var(--plot-edge) .7rem var(--plot-axis)!important; font-size:.78rem; line-height:1.5; text-align:center; }
  .science-plot__legend { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr)); gap:.4rem 1rem; list-style:none; margin:.8rem 0 0!important; padding:0!important; font-size:.75rem; line-height:1.5; }
  .science-plot__legend li { display:flex; align-items:center; gap:.6rem; margin:0; min-width:0; overflow-wrap:anywhere; }
  .science-plot [hidden] { display:none!important; }
  .science-plot__readout { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.25rem 1rem; font-size:.75rem; color:var(--sl-color-gray-2); }
  .science-plot__help { margin:.3rem 0!important; line-height:1.5; }
  .science-plot__readout output { align-self:center; font-variant-numeric:tabular-nums; }
  .science-plot__legend button { display:flex; align-items:center; gap:.6rem; width:100%; min-height:44px; padding:.35rem .5rem; border:1px solid transparent; background:transparent; color:inherit; text-align:left; font:inherit; line-height:1.4; cursor:pointer; }
