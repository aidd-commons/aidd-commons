---
import manifest from "../data/atlas-figures.json";
import { withSiteBase } from "../lib/site-paths";

/** The PNG and vector PDF are saved from the same native report figure. */
interface Props {
  id: string;
  chinese?: boolean;
}

interface FigureEntry {
  id: string;
  file: string;
  pdf: string;
  pptx?: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
  pages: string[];
}

const { id, chinese = Astro.url.pathname.includes("/zh-cn/") } = Astro.props;
const figure = (manifest.figures as FigureEntry[]).find((entry) => entry.id === id);
if (!figure) {
  throw new Error(`AtlasFigure: no figure is registered under the id "${id}".`);
}
const preview = withSiteBase(`/figures/${figure.file}`, import.meta.env.BASE_URL);
const pdf = withSiteBase(`/figures/${figure.pdf}`, import.meta.env.BASE_URL);
const pptx = figure.pptx ? withSiteBase(`/figures/${figure.pptx}`, import.meta.env.BASE_URL) : undefined;
---

<figure class="atlas-figure" data-atlas-figure={id}>
  <div class="atlas-figure__frame">
    <a class="atlas-figure__preview" href={pdf}>
      <img
        src={preview}
        width={figure.width}
        height={figure.height}
        alt={figure.alt}
        loading="lazy"
        decoding="async"
      />
      <span class="atlas-figure__open" aria-hidden="true">{chinese ? "打开矢量图" : "Open vector figure"} ↗</span>
    </a>
  </div>
  <figcaption class="atlas-figure__caption">
    <details class="atlas-figure__description"><summary>{chinese ? "阅读完整图注" : "Read the full caption"}</summary><p lang="en">{figure.caption}</p></details>
    <div class="atlas-figure__files"><a class="atlas-figure__download" href={pdf} download>{chinese ? "下载 PDF" : "Download PDF"}</a><a class="atlas-figure__download" href={preview} download>PNG</a>
    {pptx && <a class="atlas-figure__download" href={pptx} download>{chinese ? "可编辑示意图" : "Editable diagram"}</a>}</div>
  </figcaption>
</figure>

<style>
  .atlas-figure {
    min-width: 0;
    margin: 1.75rem 0;
  }

  .atlas-figure__frame {
    border: 1px solid var(--atlas-rule);
    /* The source palette and its non-colour encodings keep their measured contrast
       on this paper surface in both site themes. */
    background: #fffdf8;
    padding: clamp(.3rem, 1vw, .7rem);
  }

  .atlas-figure__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .atlas-figure__preview {
    position: relative;
    display: block;
  }

  .atlas-figure__open { position: absolute; right: .3rem; bottom: .3rem; padding: .3rem .5rem; color: #fff; background: #075e5c; font-size: .7rem; }
  .atlas-figure__preview:focus-visible, .atlas-figure__caption :is(a, summary):focus-visible { outline: 3px solid var(--atlas-focus); outline-offset: 4px; }

  .atlas-figure__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: .1rem 1rem;
    margin-top: 0.35rem;
    color: var(--atlas-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .atlas-figure__description { flex: 1 1 22rem; min-width: 0; }
  .atlas-figure__description summary { min-height: 44px; align-content: center; cursor: pointer; font-size: .78rem; }
  .atlas-figure__description p { margin: .3rem 0 .8rem; font-size: .8rem; }
  .atlas-figure__files { display: flex; flex-wrap: wrap; gap: .1rem .8rem; }

  .atlas-figure__download {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
    font-size: .75rem;
  }
</style>
