---
import { parse } from "yaml";
import type { Curriculum } from "../../../scripts/curriculum/curriculum.js";
import type { Resource } from "../data/resource.js";
import curriculumSource from "../../../catalog/curriculum/tracks.yaml?raw";
import resourceData from "../../public/data/resources.v1.json";
import { withoutSiteBase } from "../lib/site-paths";

interface Props { lessonId: string; }
const { lessonId } = Astro.props;
const chinese = withoutSiteBase(Astro.url.pathname, import.meta.env.BASE_URL).startsWith("/zh-cn/");
const curriculum = parse(curriculumSource) as Curriculum;
const resources = resourceData as Resource[];
const [trackId, localId] = lessonId.split("/");
const track = curriculum.tracks.find((item) => item.id === trackId);
const lesson = track?.lessons.find((item) => item.id === localId);
const sourceIds = [...new Set([
  ...(lesson?.source_ids ?? []),
  ...(track?.lessons.filter((item) => item.type === "core-source-path").flatMap((item) => item.source_ids) ?? []),
])];
const sources = sourceIds.map((id) => {
  const resource = resources.find((item) => item.id === id);
  if (!resource) throw new Error(`Unknown lesson resource: ${lessonId}: ${id}`);
  return resource;
});
---

{sources.length > 0 && (
  <details class="lesson-resources" data-lesson-resources>
    <summary>{chinese ? "本课与路径资源" : "Lesson and pathway resources"} ({sources.length})</summary>
    <p>{chinese ? "本课及核心阅读路径登记的资源。图谱使用中文界面，资源正文和来源证据保留英语原文，并列明访问与许可限制。" : "Registered reading for this lesson and its core-source path. Atlas entries collect source, paper and documentation links alongside access and licence notes."}</p>
    <ul>
      {sources.map((resource) => <li><a href={`${chinese ? "/zh-cn" : ""}/atlas/${resource.id}/`}>{resource.name}</a> · <a href={resource.canonical_url}>{chinese ? "访问资源" : "Visit resource"}</a></li>)}
    </ul>
  </details>
)}

<style>
  .lesson-resources {
    border: 1px solid var(--atlas-rule);
    background: var(--atlas-bg);
    padding: 0 0.75rem;
    font-size: 0.82rem;
  }
  .lesson-resources summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-weight: 650;
    color: var(--atlas-teal-deep);
  }
  .lesson-resources p {
    margin: 0 0 0.5rem;
    color: var(--atlas-muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .lesson-resources ul {
    margin: 0 0 0.65rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.25rem;
  }
  .lesson-resources a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
  }
</style>
