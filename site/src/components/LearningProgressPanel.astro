---
import { learningStepClosure, type LearningRoute, type LearningStep } from "../lib/learning-hub";

interface Props {
  chinese?: boolean;
  routes: LearningRoute[];
  lessons: LearningStep[];
  compact?: boolean;
  wide?: boolean;
}
const { chinese = false, routes, lessons, compact = false, wide = false } = Astro.props;
const steps = learningStepClosure(routes, lessons);
const first = steps.find((lesson) => lesson.id === routes[0]?.lessonIds[0]);
---

<learning-resume class:list={["learning-resume", { "learning-resume--compact": compact, "learning-resume--wide": wide }]} data-routes={JSON.stringify(routes)} data-lessons={JSON.stringify(steps)} data-chinese={String(chinese)}>
  <div class="learning-resume__heading">
    <span class="learning-resume__symbol" aria-hidden="true">↳</span>
    <div><p class="eyebrow">{chinese ? "你的学习工作区" : "Your learning workspace"}</p><h2>{chinese ? "从下一步继续" : "Pick up the next step"}</h2></div>
  </div>
  <div class="learning-resume__controls">
  {routes.length > 1 && <label class="learning-resume__selector" data-route-control hidden>{chinese ? "选择路径" : "Choose a route"}<select data-route-select>{routes.map((route) => <option value={route.id}>{route.title}</option>)}</select></label>}
  <div class="learning-resume__progress"><span data-progress-label>{chinese ? "启用 JavaScript 后可读取本机记录" : "Enable JavaScript to read this device’s progress"}</span><span data-progress-fraction aria-hidden="true">0 / {routes[0]?.lessonIds.length ?? 0}</span></div>
  <progress value="0" max={Math.max(routes[0]?.lessonIds.length ?? 0, 1)} aria-label={chinese ? "已自行标记完成的课程" : "Self-reported lesson completion"}></progress>
  </div>
  <div class="learning-resume__continuation">
  <p class="learning-resume__reason" data-next-reason aria-live="polite">{chinese ? "从路径的第一课开始。" : "Begin with the first lesson in this route."}</p>
  {first && <a class="learning-resume__next" data-next-link href={first.href}><span data-next-title>{first.title}</span><span aria-hidden="true">→</span></a>}
  </div>
  <p class="learning-resume__note">{chinese ? "自报进度，不是学习成效测量。完成标记仅保存在这个浏览器，不会上传到服务器。" : "Self-reported progress, not measured learning. Completion stays in this browser and is not sent to a server."}</p>
  <p class="learning-resume__storage" data-storage-status hidden>{chinese ? "浏览器存储不可用；你仍然可以打开全部课程。" : "Browser storage is unavailable. Every lesson remains available."}</p>
</learning-resume>

<script>
  import { readLessonProgress } from "../lib/atlas-state";
  import { learningProgress, nextLearningStep, type LearningRoute, type LearningStep } from "../lib/learning-hub";

  class LearningResume extends HTMLElement {
    private routes: LearningRoute[] = [];
    private lessons: LearningStep[] = [];
    private routeId = "";
    private onStorage = () => this.render();

    connectedCallback() {
      this.routes = JSON.parse(this.dataset.routes ?? "[]") as LearningRoute[];
      this.lessons = JSON.parse(this.dataset.lessons ?? "[]") as LearningStep[];
      const requested = new URL(location.href).searchParams.get("route");
      this.routeId = this.routes.find((route) => route.id === requested)?.id ?? this.routes[0]?.id ?? "";
      const select = this.querySelector<HTMLSelectElement>("[data-route-select]");
      if (select) {
        this.querySelector<HTMLElement>("[data-route-control]")?.removeAttribute("hidden");
        select.value = this.routeId;
        select.addEventListener("change", () => {
          this.routeId = select.value;
          const url = new URL(location.href);
          url.searchParams.set("route", this.routeId);
          history.replaceState(null, "", url);
          this.render();
        });
      }
      window.addEventListener("storage", this.onStorage);
      window.addEventListener("pageshow", this.onStorage);
      this.render();
    }

    disconnectedCallback() {
      window.removeEventListener("storage", this.onStorage);
      window.removeEventListener("pageshow", this.onStorage);
    }

    private render() {
      const route = this.routes.find((entry) => entry.id === this.routeId);
      if (!route) return;
      const chinese = this.dataset.chinese === "true";
      let completed: string[] = [];
      try { completed = readLessonProgress(localStorage); }
      catch { this.querySelector<HTMLElement>("[data-storage-status]")?.removeAttribute("hidden"); }
      const count = learningProgress(route.lessonIds, completed);
      const progress = this.querySelector("progress");
      if (progress) { progress.value = count.completed; progress.max = Math.max(1, count.total); }
      const label = this.querySelector("[data-progress-label]");
      if (label) label.textContent = chinese ? "本机已标记完成" : "Marked complete on this device";
      const fraction = this.querySelector("[data-progress-fraction]");
      if (fraction) fraction.textContent = `${count.completed} / ${count.total}`;
      const next = nextLearningStep(route, this.lessons, completed);
      const lesson = this.lessons.find((entry) => entry.id === next?.id);
      const link = this.querySelector<HTMLAnchorElement>("[data-next-link]");
      const reason = this.querySelector("[data-next-reason]");
      if (link && lesson) {
        link.hidden = false;
        link.href = lesson.href;
        const title = link.querySelector("[data-next-title]");
        if (title) title.textContent = lesson.title;
      } else if (link) link.hidden = true;
      if (reason) reason.textContent = !next
        ? (chinese ? "这条路径的课程均已标记完成。你可以回顾内容或选择另一条路径。" : "Every lesson in this route is marked complete. Revisit a lesson or choose another route.")
        : next.reason === "route-prerequisite"
          ? (chinese ? "先完成这条路径声明的先修课程。" : "Start with a declared prerequisite for this route.")
          : next.reason === "lesson-prerequisite"
            ? (chinese ? "下一课尚有未标记完成的先修课程。" : "The next lesson has a prerequisite you have not marked complete.")
            : (chinese ? "按规范路径顺序，这是下一节未完成课程。" : "This is the next unfinished lesson in the declared route.");
    }
  }
  if (!customElements.get("learning-resume")) customElements.define("learning-resume", LearningResume);
</script>

<style>
  .learning-resume { display: block; padding: 1.25rem; background: var(--atlas-panel); border: 1px solid var(--atlas-rule-strong); border-top: 3px solid var(--atlas-teal); min-width: 0; }
  .learning-resume__heading { display: flex; gap: .65rem; align-items: center; }
  .learning-resume__symbol { color: var(--atlas-teal-deep); font-size: 1.6rem; line-height: 1; }
  .learning-resume h2 { margin: 0; font-size: 1.15rem; line-height: 1.3; letter-spacing: -.025em; }
  .learning-resume .eyebrow { margin: 0 0 .25rem; font-size: .75rem; }
  .learning-resume__selector { display: grid; gap: .3rem; margin-top: .85rem; color: var(--atlas-muted); font-size: .875rem; }
  .learning-resume select { width: 100%; min-width: 0; min-height: 44px; padding: .5rem; border: 1px solid var(--atlas-rule-strong); background: var(--atlas-bg); color: var(--atlas-ink); font: inherit; font-size: 1rem; }
  .learning-resume__progress { display: flex; justify-content: space-between; align-items: center; gap: .75rem; margin-top: .8rem; color: var(--atlas-muted); font-size: .875rem; }
  .learning-resume__progress span:last-child { font-family: var(--atlas-font-mono); white-space: nowrap; }
  .learning-resume progress { display: block; width: 100%; height: .3rem; margin-top: .4rem; border: 0; accent-color: var(--atlas-teal); }
  .learning-resume progress::-webkit-progress-bar { background: var(--atlas-surface); }
  .learning-resume progress::-webkit-progress-value { background: var(--atlas-teal); }
  .learning-resume__reason { margin: .85rem 0 .15rem; color: var(--atlas-muted); font-size: .875rem; line-height: 1.5; }
  .learning-resume__next { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 44px; color: var(--atlas-teal-deep); font-weight: 650; font-size: 1rem; line-height: 1.5; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .learning-resume__note, .learning-resume__storage { margin: .7rem 0 0; color: var(--atlas-muted); font-size: .8125rem; line-height: 1.5; }
  .learning-resume__storage { color: var(--atlas-emphasis); }
  .learning-resume--compact { padding: 1rem; }
  .learning-resume--compact .learning-resume__heading { gap: .5rem; }
  .learning-resume--compact h2 { font-size: 1.05rem; }
  .learning-resume--compact .learning-resume__progress { margin-top: .65rem; }
  .learning-resume--compact .learning-resume__reason { margin-top: .65rem; }
  .learning-resume__controls, .learning-resume__continuation { min-width: 0; }
  [hidden] { display: none !important; }
  @media (min-width: 900px) {
    .learning-resume--wide { display: grid; grid-template-columns: minmax(10rem, .8fr) minmax(0, 1fr) minmax(0, 1.2fr); align-items: center; gap: 0 1.5rem; }
    .learning-resume--wide .learning-resume__selector, .learning-resume--wide .learning-resume__reason { margin-top: 0; }
    .learning-resume--wide .learning-resume__note, .learning-resume--wide .learning-resume__storage { grid-column: 1 / -1; margin-top: .75rem; padding-top: .6rem; border-top: 1px solid var(--atlas-rule); }
  }
</style>
