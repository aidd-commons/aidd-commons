---
import ScientificPlot from "./ScientificPlot.astro";
import ScientificIcon from "./ScientificIcon.astro";
import ScientificObjectView from "./ScientificObjectView.astro";
import IdentitySplitView from "./IdentitySplitView.astro";
import FoundationEvidenceGuide from "./FoundationEvidenceGuide.astro";
import ScienceStory from "./ScienceStory.astro";
import { teachingDesigns, screeningPopulation } from "../data/teaching-presentation";
import { teachingViews, localTeachingText } from "../data/teaching-views";
import molecules from "../data/teaching/molecules.json";
import chembl from "../../../labs/chembl_egfr/locked-summary.json";
import rmd17 from "../../../labs/rmd17_system_state/locked-summary.json";
import pool from "../../../labs/pool_budget/real-summary.json";
import uncertainty from "../../../labs/pool_budget/uncertainty-summary.json";
import biologics from "../../../labs/biologic_construct_audit/summary.json";
import paperqa from "../../../labs/paperqa_local/reviewed-example.json";
import pyridine from "../assets/teaching/pyridine.png";
import alanine1 from "../assets/teaching/alanine-one.png";
import alanine2 from "../assets/teaching/alanine-two.png";
import candidate1 from "../assets/teaching/generation-c01.png";
import candidate2 from "../assets/teaching/generation-c02.png";
import candidate3 from "../assets/teaching/generation-c03.png";
import retroProduct from "../assets/teaching/retro-product.png";
import retroAcid from "../assets/teaching/retro-acid.png";
import retroAmine from "../assets/teaching/retro-amine.png";
interface Props {track:string;chinese?:boolean;compact?:boolean}
const {track,chinese=false,compact=false}=Astro.props;
const view=teachingViews[track];
if(!view) throw new Error("No scientific teaching view for track: "+track);
const t=(en:string,zh:string)=>chinese?zh:en;
const tx=(field:keyof Pick<typeof view,"question"|"mechanism"|"worked"|"task"|"answer"|"limit"|"state">)=>localTeachingText(view[field],chinese);
const href=(path:string)=>chinese&&(/^\/(learn|labs)\//.test(path))?"/zh-cn"+path:path;
const moleculeAssets=[pyridine,alanine1,alanine2];
const moleculeIds=["pyridine","alanine-one","alanine-two"];
const representationMolecules=moleculeIds.map(id=>molecules.molecules.find(m=>m.id===id)!);
const descriptorDisplay=(value:number)=>String(Number(value.toPrecision(6)));
const modelNames={train_mean:t("Train mean","训练均值"),descriptor_ridge:"Descriptor Ridge",morgan_ridge:"Morgan Ridge"};
const assayLabels={primary_test:t("Primary assay · 132 parents","主要 assay · 132 个 parent"),assay_replication:t("Separate assay · 170 parents","独立 assay · 170 个 parent")};
const assayIds=Object.keys(chembl.results) as (keyof typeof chembl.results)[];
const poolIds=Object.keys(pool.assays) as (keyof typeof pool.assays)[];
const pip=[.44,.27,.16,.08,.05];
const domainFields=["modality","construct","expression_system","intended_function"] as const;
const domainLabels=[t("Modality","模态"),t("Construct","构造"),t("Host","宿主"),t("Intended function","预期功能")];
const dossier=[{id:"N1",potency:20,selectivity:8,exposure:4,safety:true},{id:"N2",potency:40,selectivity:30,exposure:2,safety:true},{id:"N3",potency:45,selectivity:25,exposure:3.5,safety:false}];
const checkpoints=[0,1,2,3,4];
const dosePoints = Array.from({ length:25 }, (_, i) => {
  const x = -2 + i * 3 / 24;
  return { x, residual: 2 + 96 / (1 + (10 ** x / 0.4) ** 1.2) };
});
const doseSeries = (mode:string) => [{
  name: mode === "residual" ? t("Calculated residual activity", "计算残余活性") : t("Calculated inhibition", "计算抑制率"),
  points: [...dosePoints, ...[0.4,0.8].map(concentration=>({x:Math.log10(concentration),residual:2+96/(1+(concentration/0.4)**1.2)}))].sort((a,b)=>a.x-b.x).map(point => ({x:point.x, y:mode === "residual" ? point.residual : 100 - point.residual})),
}];
const fingerprintBins = (m:typeof representationMolecules[number]) => Array.from({length:64}, (_,i) => ({
  count:m.morgan_on_bits.filter(bit => Math.floor(bit/32) === i).length,
  start:i*32,
  end:i*32+31,
}));
type ContextIcon = "cell" | "protein" | "molecule" | "assay" | "simulation" | "robot" | "data" | "model";
type ContextStage = [ContextIcon, string, string];
const contexts: Record<string, ContextStage[]> = {
  "data-governance": [["data", t("Source records", "来源记录"), t("Keep endpoint + provenance", "保留终点与来源")], ["molecule", t("Parent identity", "Parent 身份"), t("Resolve the grouping unit", "确定分组单位")], ["data", t("Model table", "模型数据表"), t("Keep lineage inspectable", "保持谱系可检查")]],
  representations: [["molecule", t("Molecular graph", "分子图"), t("Authored, label-free input", "构造、无标签输入")], ["data", t("Computed descriptors", "计算描述符"), t("Named quantities + units", "明确的量与单位")], ["model", t("Hashed bit vector", "哈希位向量"), t("Representation, not attribution", "表示而非归因")]],
  "mechanism-targets": [["data", t("Regional signal", "区域信号"), t("Conditional variant support", "条件性变异支持")], ["cell", t("Effector question", "效应基因问题"), t("Context remains necessary", "仍需情境证据")], ["data", t("Target hypothesis", "靶点假设"), t("Independent validation gap", "独立验证缺口")]],
  "qsar-properties": [["assay", t("Named assay", "指定 assay"), t("Endpoint defines the task", "终点定义任务")], ["model", t("Frozen comparison", "冻结比较"), t("Retain every baseline", "保留所有基线")], ["data", t("Held-out parents", "保留 parent"), t("Read the population first", "先读取评估总体")]],
  "admet-pk": [["molecule", t("Concentration", "浓度"), t("Total and unbound differ", "总浓度与游离浓度不同")], ["simulation", t("Elimination model", "消除模型"), t("Constructed first-order case", "构造一级消除案例")], ["data", t("Exposure readout", "暴露读出"), t("Keep units and context", "保留单位与情境")]],
  "dti-screening": [["molecule", t("Original library", "原始库"), t("Preserve the base rate", "保留基础阳性率")], ["model", t("Shortlist", "候选列表"), t("A ranking under a rule", "规则下的排序")], ["assay", t("Endpoint boundary", "终点边界"), t("Assay activity is contextual", "Assay 活性依赖情境")]],
  "structure-and-pockets": [["protein", t("Experimental coordinates", "实验坐标"), t("A retained structural state", "保留的结构状态")], ["molecule", t("Ligand context", "配体情境"), t("Inspect the source geometry", "检查来源几何")], ["data", t("Interpretation", "解释"), t("Geometry does not decide affinity", "几何不能决定亲和力")]],
  "physics-based-modeling": [["molecule", t("Molecular system", "分子系统"), t("Identity + physical state", "身份与物理状态")], ["simulation", t("Frame geometry", "帧几何"), t("Correlated configurations", "相关构型")], ["data", t("Energy evaluation", "能量评估"), t("Separate retained aggregates", "另行保留的汇总值")]],
  "molecular-generation": [["molecule", t("Authored graphs", "构造分子图"), t("A separate structure gallery", "独立的结构图库")], ["model", t("Constructed scores", "构造分数"), t("Two objectives to maximize", "两个最大化目标")], ["data", t("Hard constraint", "硬约束"), t("Eligibility precedes ranking", "先确定资格，再排序")]],
  "biologics-design": [["data", t("Construct record", "构造记录"), t("Identity, domains and host", "身份、结构域与宿主")], ["protein", t("Domain schematic", "结构域示意"), t("Identity only, not coordinates", "仅表示身份，非坐标")], ["assay", t("Function evidence", "功能证据"), t("Requires its own contrast", "需要独立功能对照")]],
  "synthesis-and-automation": [["molecule", t("Product graph", "产物图"), t("An authored graph-edit case", "构造图编辑案例")], ["data", t("Decomposition", "分解"), t("Recorded reactant graphs", "记录的反应物图")], ["robot", t("Laboratory requirements", "实验室要求"), t("Feasibility remains unassessed", "可行性仍未评估")]],
  "active-learning": [["data", t("Retained pool", "保留数据池"), t("Fixed original denominators", "固定的原始分母")], ["model", t("Acquisition policy", "获取策略"), t("Matched parent budgets", "匹配的 parent 预算")], ["data", t("Label lookup", "标签查询"), t("Retrospective, not live feedback", "回顾性查询，非实时反馈")]],
  "scientific-agents": [["data", t("Supplied sources", "给定来源"), t("A saved local corpus", "保留的本地语料")], ["robot", t("Typed return", "带类型返回"), t("Observation or failure", "观察或失败")], ["data", t("Source review", "来源审查"), t("Support remains claim-specific", "支持须对应具体主张")]],
  "evaluation-and-reproducibility": [["data", t("Observed rows", "观察行"), t("Membership is explicit", "明确成员归属")], ["molecule", t("Grouping unit", "分组单位"), t("Identity can cross a split", "身份可能跨越划分")], ["data", t("Allowed information", "允许的信息"), t("Fit transforms on training only", "仅在训练数据拟合变换")]],
  "candidate-nomination": [["molecule", t("Candidate record", "候选记录"), t("Endpoint-specific evidence", "终点特异证据")], ["assay", t("Required gates", "必要门槛"), t("Logical conditions, not averages", "逻辑条件而非平均值")], ["data", t("Complete dossier", "完整档案"), t("Missing evidence stays missing", "缺失证据仍为缺失")]],
};
const contextStages = contexts[track];
const trackNumber = String(Object.keys(teachingViews).indexOf(track) + 1).padStart(2, "0");
const energyScale = Math.max(...Object.values(rmd17.results).flatMap(result => [result.train_mean.mae, result.ridge.mae]));

---
<figure class:list={["teaching-view","not-content",{"teaching-view--compact":compact}]} id={"scientific-view-"+track} data-teaching-view={track} data-teaching-design={teachingDesigns[track]} data-chinese={chinese ? "true" : "false"}>
  <figcaption class="teaching-view__heading"><span class="teaching-view__eyebrow"><b>{t("TRACK", "专题")} {trackNumber}</b><span>{t("Scientific object view","科学对象视图")}</span><em>{tx("state")}</em></span><strong>{tx("question")}</strong></figcaption>
  <noscript>
    <p class="teaching-note">{t("Scripting is unavailable. All retained states and checkpoint tables are displayed below; controls do not perform computation.", "脚本不可用。下方显示所有保留状态与检查点表格；控件不执行计算。")}</p>
    <style is:global>[data-teaching-view] .teaching-control, [data-teaching-view] .science-object__toolbar, [data-teaching-view] .science-object__controls { display: none !important; } [data-teaching-view] [data-teaching-panel][hidden], [data-teaching-view] [data-budget-step][hidden], [data-teaching-view] [data-identity-state][hidden] { display: block !important; }</style>
  </noscript>
  <div class="teaching-view__composition">
    <div class="teaching-view__visual">
      {track==="foundations"&&<FoundationEvidenceGuide chinese={chinese}/>}
      {track==="drug-discovery-foundations"&&<div data-teaching-switch data-compare-panels class="teaching-comparison teaching-comparison--drug-discovery-foundations">
        <label class="teaching-control">{t("Emphasize a response definition","突出一种响应定义")}<select data-panel-select><option value="residual">{t("Residual activity, %","残余活性，%")}</option><option value="inhibition">{t("Inhibition, %","抑制率，%")}</option></select></label>
        {["residual","inhibition"].map(mode=><div data-teaching-panel={mode} class="teaching-comparison__panel"><ScientificPlot syncGroup={"dose-"+track+"-"+(chinese?"zh":"en")+"-"+compact} title={t("Constructed concentration-response curve","构造浓度响应曲线")} xLabel={t("log10(concentration / µM)","log10(浓度 / µM)")} yLabel={mode==="residual"?t("Residual activity, %","残余活性，%"):t("Inhibition, %","抑制率，%")} xMin={-2} xMax={1} yMin={0} yMax={100} chinese={chinese} series={doseSeries(mode)} /></div>)}
        <div class="linked-dose" data-linked-dose role="status" aria-live="polite"><span>{t("Same selected concentration","相同选定浓度")} <strong data-dose-concentration>0.40 µM</strong></span><span>{t("Residual activity","残余活性")} <b data-dose-residual>50.0%</b></span><span>{t("Inhibition","抑制率")} <b data-dose-inhibition>50.0%</b></span></div>
        <p class="teaching-note">{t("Top = 98%, Bottom = 2%, IC50 = 0.40 µM, Hill = 1.2. All points come from the displayed lesson's constructed equation, not an assay fit.","Top = 98%、Bottom = 2%、IC50 = 0.40 µM、Hill = 1.2。所有点均来自课程构造方程，不是实际 assay 拟合。")}</p>
        <div class="assay-context"><div><ScientificIcon name="molecule" size={76} /><strong>{t("Molecule + biological system","分子与生物系统")}</strong><span>{t("Define the measured context", "定义测量情境")}</span></div><b aria-hidden="true">→</b><div><ScientificIcon name="assay" size={76} /><strong>{t("Signal + controls","信号与对照")}</strong><span>{t("Name the response definition", "明确响应定义")}</span></div><b aria-hidden="true">→</b><div><ScientificIcon name="data" size={76} /><strong>{t("Normalized endpoint","归一化终点")}</strong><span>{t("Keep the denominator visible", "保留归一化分母")}</span></div></div>
      </div>}
      {track==="machine-learning"&&<div data-teaching-switch data-compare-panels class="teaching-comparison teaching-comparison--machine-learning">
        <label class="teaching-control">{t("Emphasize a declared candidate","突出一个声明候选")}<select data-panel-select><option value="alpha0">alpha = 0</option><option value="alpha2">alpha = 2</option></select></label>
        {[0,2].map(alpha=><div data-teaching-panel={"alpha"+alpha} class="teaching-comparison__panel"><div class="candidate-fit"><strong>alpha = {alpha}</strong><span>{alpha===0?"w = 2 · b = 1":"w = 1 · b = 2"}</span><b>ŷ(3) = {alpha===0?7:5} · |ŷ − 6| = 1</b></div><ScientificPlot title={t("Constructed Ridge fit and validation point","构造 Ridge 拟合与验证点")} xLabel={t("Feature x, arbitrary units","特征 x，任意单位")} yLabel={t("Target / prediction, arbitrary units","目标 / 预测，任意单位")} xMin={0} xMax={3} yMin={0} yMax={8} xTicks={[0,1,2,3]} chinese={chinese} series={[{name:t("Training observations","训练观察"),connect:false,points:[{x:0,y:1},{x:1,y:3},{x:2,y:5}]},{name:alpha===0?"ŷ = 1 + 2x":"ŷ = 2 + x",points:[{x:0,y:alpha===0?1:2},{x:3,y:alpha===0?7:5}],dashed:true},{name:t("Validation target, not fitted","验证目标，不参与拟合"),connect:false,points:[{x:3,y:6}]}]} /></div>)}
        <p class="teaching-note">{t("No test target is shown. The lesson's validation tie rule chooses smaller alpha; evaluation cannot resolve that tie.","不显示测试目标。课程的验证平局规则选择较小 alpha；不能用评估数据打破平局。")}</p>
        <div class="partition-strip"><div><ScientificIcon name="model" size={70} /><span><b>{t("Train", "训练")}</b>{t("Fit parameters + transforms", "拟合参数与变换")}</span></div><div><ScientificIcon name="data" size={70} /><span><b>{t("Validate", "验证")}</b>{t("Select declared candidate", "选择声明候选")}</span></div><div><ScientificIcon name="assay" size={70} /><span><b>{t("Evaluate", "评估")}</b>{t("Report once under protocol", "按协议报告一次")}</span></div></div>
      </div>}
      {track==="data-governance"&&<ScienceStory story="identity" chinese={chinese} compact={compact}/>}
      {(track==="data-governance"||track==="evaluation-and-reproducibility")&&<IdentitySplitView chinese={chinese} context={track==="data-governance"?"lineage":"evaluation"} />}
      {track==="representations"&&<div data-teaching-switch>
        <label class="teaching-control">{t("Authored molecular input","构造分子输入")}<select data-panel-select>{representationMolecules.map(m=><option value={m.id}>{m.id}</option>)}</select></label>
        {representationMolecules.map((m,index)=><div data-teaching-panel={m.id} hidden={index>0}>
          <div class="representation-workbench"><div class="molecule-encoding"><span class="representation-view-label">(a) {t("Molecular graph","分子图")}</span><img src={moleculeAssets[index].src} width="560" height="320" alt={t("RDKit 2D depiction of ","RDKit 二维结构图：")+m.id} loading="lazy"/></div><div class="representation-fields"><span class="representation-view-label">(b) {t("Serialization + descriptors","序列化与描述符")}</span><div><p class="meta-label">{t("Same graph, different objects","同一图，不同计算对象")}</p><code>{m.input_smiles}</code><dl><div><dt>{t("Formula","分子式")}</dt><dd>{m.formula}</dd></div><div><dt>{t("Graph","图")}</dt><dd>{m.atoms} {t("heavy atoms","重原子")} · {m.bonds} {t("bonds","键")}</dd></div><div><dt>{t("Computed molecular weight","计算分子量")}</dt><dd title={String(m.molecular_weight)+" g/mol"}>{descriptorDisplay(m.molecular_weight)} g/mol</dd></div><div><dt>TPSA</dt><dd title={String(m.tpsa)+" Å²"}>{descriptorDisplay(m.tpsa)} Å²</dd></div></dl></div></div>
          <div class="representation-fingerprint"><span class="representation-view-label">(c) {t("Hashed neighborhoods","哈希邻域")}</span><div class="encoding-heading"><strong>{t("Morgan bit occupancy", "Morgan 位占用")}</strong><span>{t("Consecutive bins · radius 2 · 2048 bits", "连续分箱 · radius 2 · 2048 bits")}</span></div>
          <div class="fingerprint-bins" role="img" aria-label={t("Occupied Morgan bits grouped in consecutive 32-bit bins; exact positions below","Morgan 占用位按连续 32-bit 分箱；下方列出精确位置")}>{fingerprintBins(m).map(bin => <span class:list={{occupied:bin.count>0}} title={"bits "+bin.start+"–"+bin.end+": "+bin.count}>{bin.count||"·"}</span>)}</div>
          <p class="teaching-note">{t("Each cell counts occupied hashed positions in one consecutive 32-bit bin. Empty cells are shown as dots. These are not atoms or attributed substructures.","每格计数一个连续 32-bit 分箱中的占用哈希位置；空格显示为点。这些不是原子，也不是归因到的子结构。")}</p>
          </div></div><details class="teaching-data"><summary>{t("Encoding values and exact occupied positions","编码值与精确占用位置")}</summary><p>{t("Descriptors above use up to 6 significant digits; this table retains the exact source values.","上方描述符最多显示 6 位有效数字；此表保留精确源值。")}</p><div class="teaching-scroll" tabindex="0" role="region" aria-label={t("Exact source descriptors","精确来源描述符")}><table><caption>{t("Exact retained descriptor values","精确保留的描述符值")}</caption><thead><tr><th scope="col">{t("Descriptor","描述符")}</th><th scope="col">{t("Source value","源值")}</th><th scope="col">{t("Unit","单位")}</th></tr></thead><tbody><tr><th scope="row">{t("Computed molecular weight","计算分子量")}</th><td>{m.molecular_weight}</td><td>g/mol</td></tr><tr><th scope="row">TPSA</th><td>{m.tpsa}</td><td>Å²</td></tr></tbody></table></div><dl><div><dt>Canonical isomeric SMILES</dt><dd><code>{m.canonical_smiles}</code></dd></div><div><dt>Morgan radius / bits / chirality</dt><dd>2 / 2048 / true</dd></div><div><dt>{t("Occupied bit positions","占用位位置")}</dt><dd><code>{m.morgan_on_bits.join(", ")}</code></dd></div></dl></details>
        </div>)}
      </div>}
      {track==="mechanism-targets"&&<div>
        <div class="variant-region"><div class="variant-region__heading"><strong>{t("Regional signal → conditional variant support","区域信号 → 条件性变异支持")}</strong><span>{t("Schematic candidate order; no genomic distances","候选顺序示意，无基因组距离")}</span></div><div class="variant-region__locus">{pip.map((value,i)=><div class:list={{"is-outside":i===4}}><b>v{i+1}</b><i style={{height:(value*7)+"rem"}}/><span>{value}</span></div>)}</div><div class="variant-mass" aria-label={t("PIP mass: first four 0.95; last 0.05","PIP 质量：前四项 0.95，末项 0.05")}>{pip.map((value,i)=><span class:list={{"is-outside":i===4}} style={{flex:value}} title={"v"+(i+1)+": "+value}>{i<4?"v"+(i+1):""}</span>)}</div><p>{t("95% credible set: v1–v4 · probability mass 0.95","95% 可信集：v1–v4 · 概率质量 0.95")}</p></div>
        <div class="evidence-questions"><div><span class="question-bridge">{t("Unresolved: variant → gene","未解决：变异 → 基因")}</span><strong>{t("Which effector in which context?","何种情境中的哪个效应基因？")}</strong><span>{t("Context + molecular link","情境与分子连接")}</span></div><div><span class="question-bridge">{t("Unresolved: gene → intervention","未解决：基因 → 干预")}</span><strong>{t("Which direction changes phenotype?","哪个方向能改变表型？")}</strong><span>{t("Direction + independent validation","方向与独立验证")}</span></div></div>
        <p class="teaching-note">{t("Dashed bridges mark unresolved questions, not causal arrows.","虚线连接表示未解决的问题，不是因果箭头。")}</p>
        <details class="teaching-data"><summary>{t("Conditional-support data and competing explanation","条件性支持数据与竞争解释")}</summary><div class="teaching-scroll" tabindex="0" role="region" aria-label={t("Conditional-support table","条件性支持表")}> <table><caption>{t("PIP, dimensionless; one causal variant assumed among these candidates","PIP，无量纲；假设这些候选中有一个因果变异")}</caption><thead><tr><th>{t("Variant","变异")}</th><th>PIP</th><th>{t("Cumulative mass","累计质量")}</th></tr></thead><tbody>{pip.map((value,i)=><tr><th scope="row">v{i+1}</th><td>{value}</td><td>{Number(pip.slice(0,i+1).reduce((a,b)=>a+b,0).toFixed(2))}</td></tr>)}</tbody></table></div><p>{t("An untested second effector gene, a context-specific molecular effect, or an incorrect single-causal assumption remains compatible with a regional signal. Neither this table nor proximity resolves those alternatives.","未测试的第二效应基因、情境特异分子效应或错误的单因果假设，均可能与区域信号相容。此表和邻近性都不能排除这些解释。")}</p></details>
      </div>}
      {track==="qsar-properties"&&<div data-teaching-switch data-compare-panels class="teaching-comparison teaching-comparison--qsar-properties">
        <label class="teaching-control">{t("Emphasize an evaluation population","突出一个评估总体")}<select data-panel-select>{assayIds.map(id=><option value={id}>{assayLabels[id]}</option>)}</select></label>
        {assayIds.map(id=>{const result=chembl.results[id];return <section data-teaching-panel={id} class="teaching-comparison__panel">
          <div class="readout-heading"><strong>{assayLabels[id]}</strong><span>{t("MAE in pChEMBL units, lower is better","MAE，pChEMBL 单位，越低越好")}</span></div>
          <div class="result-bars">{Object.entries(result.metrics).map(([key,value],i)=><div><strong>{modelNames[key as keyof typeof modelNames]}</strong><span class="result-bars__track"><span class={"result-bars__bar result-bars__bar--"+i} style={{width:(value.mae/3.5*100)+"%"}}/></span><code>{value.mae.toFixed(4)}</code></div>)}</div>
          <div class="result-axis" aria-hidden="true"><span>0</span><span>3.5</span></div>
