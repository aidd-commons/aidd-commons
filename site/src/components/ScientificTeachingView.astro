      {contextStages && <details class="teaching-context-disclosure"><summary>{t("Trace the scientific objects and evidence roles", "追踪科学对象与证据角色")}</summary><ol class="teaching-context">{contextStages.map(([, label, detail], index) => <li><span class="teaching-context__number">{String(index + 1).padStart(2, "0")}</span><div><strong>{label}</strong><span>{detail}</span></div></li>)}</ol></details>}
    </div>
    {!compact&&<div class="teaching-view__reading"><section><h3><span>(a)</span> {t("Mechanism","机制")}</h3><p>{tx("mechanism")}</p></section><section><h3><span>(b)</span> {t("Worked step","推演一步")}</h3><p>{tx("worked")}</p></section></div>}
