</figure>
<script>
  function initializeTeachingViews(){
    document.querySelectorAll<HTMLElement>("[data-teaching-view]").forEach(root=>{
      if(root.dataset.initialized)return;root.dataset.initialized="true";
      const select=root.querySelector<HTMLSelectElement>("[data-panel-select]");
      if(select){
        const apply=()=>root.querySelectorAll<HTMLElement>("[data-teaching-panel]").forEach(panel=>{const selected=panel.dataset.teachingPanel===select.value;panel.hidden=!!panel.closest("[data-teaching-switch]:not([data-compare-panels])")&&!selected;panel.classList.toggle("is-emphasized",selected);});
        const supplied=new URL(window.location.href).searchParams.get("teaching-view");
        if(supplied&&Array.from(select.options).some(option=>option.value===supplied))select.value=supplied;
        apply();
        select.addEventListener("change",()=>{apply();const url=new URL(window.location.href);url.searchParams.set("teaching-view",select.value);window.history.replaceState(null,"",url);});
      }
      const dose=root.querySelector<HTMLElement>("[data-linked-dose]");
      if(dose){requestAnimationFrame(()=>root.querySelectorAll("[data-science-plot]").forEach(plot=>plot.dispatchEvent(new CustomEvent("science-plot-select-x",{detail:{x:Math.log10(.4)}}))));root.addEventListener("science-plot-select",event=>{const x=(event as CustomEvent<{x:number}>).detail.x;const concentration=10**x;const residual=2+96/(1+(concentration/.4)**1.2);dose.querySelector("[data-dose-concentration]")!.textContent=concentration.toPrecision(3)+" µM";dose.querySelector("[data-dose-residual]")!.textContent=residual.toFixed(1)+"%";dose.querySelector("[data-dose-inhibition]")!.textContent=(100-residual).toFixed(1)+"%";});}
      root.querySelectorAll<HTMLElement>("[data-budget-panel]").forEach(panel=>{
        const range=panel.querySelector<HTMLInputElement>("[data-budget-range]")!;
        const applyBudget=()=>{
          const steps=Array.from(panel.querySelectorAll<HTMLElement>("[data-budget-step]"));
          steps.forEach(step=>step.hidden=step.dataset.budgetStep!==range.value);
          const value=steps.find(step=>!step.hidden)?.dataset.budgetCount ?? "";
          const output=panel.querySelector<HTMLOutputElement>("[data-budget-output]");
          if(output)output.textContent=value;
          range.setAttribute("aria-valuetext",value+(root.dataset.chinese==="true"?" 个已获取 parent":" acquired parents"));
          panel.querySelector("[data-science-plot]")?.dispatchEvent(new CustomEvent("science-plot-select-x",{detail:{x:Number(value)}}));
        };
        panel.addEventListener("science-plot-select",event=>{const values=JSON.parse(panel.dataset.budgetCheckpoints??"[]") as number[];const index=values.indexOf((event as CustomEvent<{x:number}>).detail.x);if(index>=0){range.value=String(index);applyBudget();const url=new URL(window.location.href);url.searchParams.set("teaching-budget",range.value);window.history.replaceState(null,"",url);}});
        range.addEventListener("input",()=>{
          applyBudget();
          const url=new URL(window.location.href);url.searchParams.set("teaching-budget",range.value);window.history.replaceState(null,"",url);
        });
        const supplied=new URL(window.location.href).searchParams.get("teaching-budget");
        if(supplied&&/^[0-4]$/.test(supplied))range.value=supplied;
        applyBudget();
        requestAnimationFrame(applyBudget);
      });
    });
  }
  initializeTeachingViews();document.addEventListener("astro:page-load",initializeTeachingViews);
</script>
