  .ranking-population { display:grid; grid-template-columns:1fr 1fr .75fr; gap:1rem; }
  .ranking-population div { display:flex; flex-direction:column; gap:.35rem; border-bottom:1px solid var(--sl-color-gray-4); padding:.6rem 0 .8rem; }
  .ranking-population span,.ranking-population small { font-size:.75rem; line-height:1.5; color:var(--sl-color-gray-2); }
  .ranking-population strong { font:600 clamp(1.15rem,2.5vw,1.6rem) var(--sl-font-mono,monospace); }
  .ranking-detail { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:1.4rem; align-items:center; margin:1rem 0; }
  .ranking-strip { display:grid; grid-template-columns:repeat(10,minmax(0,1fr)); gap:.3rem; }
  .ranking-strip span { display:grid; place-items:center; min-height:1.8rem; border:1px solid var(--sl-color-gray-5); color:var(--sl-color-gray-3); font-size:.8rem; }
  .ranking-strip .is-active { background:color-mix(in srgb,var(--atlas-teal) 12%,var(--sl-color-bg)); color:var(--sl-color-text-accent); border-color:var(--sl-color-text-accent); }
  .ranking-legend { display:grid; gap:.75rem; max-width:10rem; font-size:.75rem; line-height:1.5; }
  .ranking-legend b { display:inline-block; min-width:1rem; }
  .energy-comparison { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.2rem; margin:1rem 0; }
  .energy-comparison h4 { font-size:.85rem; margin:0 0 .7rem!important; font-weight:600; }
  .energy-comparison__row { display:grid; grid-template-columns:5.5rem minmax(0,1fr) 3.6rem; align-items:center; gap:.5rem; margin:.6rem 0; font-size:.75rem; }
  .constraint-strip { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem 1rem; border-bottom:1px solid var(--sl-color-gray-5); padding:.6rem 0 .85rem; font-size:.8rem; }
  .constraint-strip > strong { font:650 .95rem var(--sl-font-mono,monospace); }
  .constraint-strip > span { color:var(--sl-color-gray-2); margin-right:auto; }
  .constraint-strip > b { font:.8rem var(--sl-font-mono,monospace); }
  .constraint-strip .is-excluded { text-decoration:line-through; text-decoration-thickness:1px; color:var(--sl-color-gray-2); }
  .generation-case { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(11rem,1fr); gap:1.5rem; align-items:start; }
  .generation-case__scores,.generation-case__gallery { min-width:0; }
  .generation-case__gallery .encoding-heading { margin-top:.6rem; }
  .generation-case .candidate-gallery { grid-template-columns:minmax(0,1fr); gap:.75rem; }
  .generation-case .candidate-gallery figure { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:.4rem .7rem; align-items:center; }
  .generation-case .candidate-gallery__id { grid-column:1/-1; margin-bottom:0; }
  .generation-case .candidate-gallery img { max-height:8rem; object-fit:contain; }
  .candidate-gallery { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .candidate-gallery figure,.retrosynthesis-tree figure { margin:0!important; min-width:0; }
  .candidate-gallery__id { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.3rem; margin-bottom:.45rem; font:600 .8rem var(--sl-font-mono,monospace); }
  .candidate-gallery__id span { font:.75rem var(--sl-font); color:var(--sl-color-gray-2); }
  .candidate-gallery img,.retrosynthesis-tree img { display:block; width:100%; height:auto; margin:0; background:white; border:1px solid var(--sl-color-gray-5); }
  .candidate-gallery figcaption,.retrosynthesis-tree figcaption { font:.75rem var(--sl-font-mono,monospace); line-height:1.5; padding:.45rem 0; overflow-wrap:anywhere; }
  .construct-assembly { padding:.6rem 0 1rem; margin:.5rem 0; border-bottom:1px solid var(--sl-color-gray-5); }
  .construct-assembly__heading { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:.4rem; font-size:.85rem; }
  .construct-assembly__heading span { font-size:.75rem; color:var(--sl-color-gray-2); }
  .construct-assembly__pair { display:grid; gap:.4rem; width:min(100%,27rem); margin:1.5rem auto 1rem; position:relative; }
  .construct-assembly__chain { display:grid; grid-template-columns:1.2fr 2.4rem 1fr; align-items:center; }
  .construct-assembly__chain span { display:grid; place-items:center; min-height:3rem; padding:.55rem; font:.8rem var(--sl-font-mono,monospace); }
  .construct-assembly__receptor { border:1px solid var(--sl-color-text-accent); border-radius:45% 45% 25% 25%; background:color-mix(in srgb,var(--atlas-teal) 9%,var(--sl-color-bg)); }
  .construct-assembly__fc { border:1px solid var(--atlas-coral); border-radius:20% 20% 40% 40%; background:color-mix(in srgb,var(--atlas-coral) 9%,var(--sl-color-bg)); }
  .construct-assembly__chain i { height:1px; background:var(--sl-color-gray-3); }
  .construct-assembly > small { display:block; font-size:.75rem; text-align:center; color:var(--sl-color-gray-2); line-height:1.5; }
  .objective-evidence { display:grid; grid-template-columns:1fr auto 1fr auto 1fr auto 1fr; align-items:center; gap:.6rem; font-size:.78rem; line-height:1.5; padding:1rem 0; }
  .objective-evidence b { min-width:1rem; text-align:center; color:var(--sl-color-gray-3); border-bottom:1px dashed var(--sl-color-gray-3); }
  .evidence-matrix td { white-space:nowrap; }
  .evidence-matrix span { color:var(--sl-color-gray-2); }
  .evidence-matrix .stated { color:var(--sl-color-text); }
  .retrosynthesis-tree { display:grid; justify-items:center; padding:.5rem 0; }
  .retrosynthesis-tree__product { width:min(65%,22rem); }
  .object-role { display:block; font-size:.75rem; font-weight:600; margin-bottom:.4rem; }
  .retrosynthesis-tree__arrow { display:grid; gap:.2rem; text-align:center; font-size:.78rem; padding:.6rem; color:var(--sl-color-gray-2); }
  .retrosynthesis-tree__arrow b { font-size:1.65rem; font-weight:400; line-height:1.1; color:var(--sl-color-text-accent); }
  .retrosynthesis-tree__reactants { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:1rem; width:100%; }
  .retrosynthesis-tree__reactants > span { font-size:1.2rem; color:var(--sl-color-gray-3); }
  .feasibility-fields { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.8rem; margin:1rem 0; }
  .feasibility-fields span { font-size:.75rem; line-height:1.5; border-left:1px dashed var(--sl-color-gray-3); padding:.3rem .6rem; }
  .pool-denominators { display:grid; grid-template-columns:auto auto minmax(0,1fr); gap:1.5rem; align-items:center; margin:.6rem 0 1.2rem; }
  .pool-denominators > div { display:grid; gap:.3rem; }
  .pool-denominators span,.pool-denominators small { font-size:.75rem; color:var(--sl-color-gray-2); }
  .pool-denominators strong { font:600 1.45rem var(--sl-font-mono,monospace); }
  .pool-denominators p { font-size:.78rem; color:var(--sl-color-gray-2); line-height:1.6; margin:0!important; padding-left:1.2rem; border-left:1px solid var(--sl-color-gray-5); }
  .checkpoint-ruler { display:flex; justify-content:space-between; margin:-.65rem 0 1rem; font:.75rem var(--sl-font-mono,monospace); color:var(--sl-color-gray-2); }
  .budget-table__heading { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.4rem; font-size:.8rem; margin:.8rem 0!important; }
  .budget-table__heading span { font-size:.75rem; color:var(--sl-color-gray-2); }
  .agent-trace { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.2rem; list-style:none; padding:0!important; margin:1rem 0!important; }
  .agent-trace li { display:flex; flex-direction:column; gap:.6rem; padding:0 0 .8rem; border-bottom:1px solid var(--sl-color-gray-4); margin:0; min-width:0; }
  .agent-trace__step { font:.8rem var(--sl-font-mono,monospace); color:var(--sl-color-text-accent); }
  .agent-trace li div { display:grid; gap:.4rem; }
  .agent-trace li div > span { font-size:.75rem; color:var(--sl-color-gray-2); }
  .agent-trace strong { font-size:.85rem; line-height:1.5; }
  .agent-trace small { font-size:.75rem; line-height:1.55; color:var(--sl-color-gray-2); }
  .agent-failure { display:flex; gap:1rem; border-top:1px dashed var(--atlas-coral); border-bottom:1px dashed var(--atlas-coral); padding:.9rem 0; margin:1.2rem 0; }
  .agent-failure__mark { flex:0 0 2rem; width:2rem; height:2rem; display:grid; place-items:center; border:1px solid var(--atlas-coral); color:var(--atlas-coral); font-size:1.4rem; border-radius:50%; }
  .agent-failure > div { min-width:0; }
  .agent-failure div > span { display:block; font-size:.75rem; color:var(--sl-color-gray-2); }
  .agent-failure__return { display:flex; flex-wrap:wrap; gap:.4rem 1rem; margin:.5rem 0; font-size:.78rem; }
  .agent-failure strong { display:block; font-size:.82rem; line-height:1.5; }
  .dossier-rule { display:flex; align-items:center; flex-wrap:wrap; gap:.6rem; margin:1rem 0; padding:.8rem 0; border-top:1px solid var(--sl-color-gray-5); border-bottom:1px solid var(--sl-color-gray-5); font-size:.8rem; line-height:1.5; }
  .dossier-rule > span { padding:.25rem 0; }
  .dossier-rule b { font:.75rem var(--sl-font-mono,monospace); color:var(--sl-color-gray-3); }
  .nomination-actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin:1rem 0; }
  .nomination-actions > div { display:grid; gap:.4rem; padding:0 0 .65rem; border-bottom:1px dashed var(--sl-color-gray-3); }
  .nomination-actions strong { font:.9rem var(--sl-font-mono,monospace); }
  .nomination-actions span { font-size:.78rem; line-height:1.5; }
  .dossier-matrix td { min-width:4rem; }
  .dossier-matrix .is-fail { background:color-mix(in srgb,var(--atlas-coral) 10%,var(--sl-color-bg)); }
  .dossier-matrix .is-missing { outline:1px dashed var(--sl-color-gray-3); outline-offset:-3px; }
  .dossier-decision { border-left:3px solid var(--atlas-coral); padding:.7rem 1rem; font-size:.84rem; line-height:1.65; }
  @container(max-width:35rem){
    .teaching-context{gap:.8rem}
    .teaching-view__reading{grid-template-columns:1fr;gap:1rem}
    .decision-route{grid-template-columns:1fr 1fr}
    .decision-route li,.decision-route li:nth-child(n+4){grid-column:auto}
    .decision-route li:last-child{grid-column:1/-1}
    .molecule-encoding{grid-template-columns:1fr}
    .molecule-encoding img{max-height:15rem;object-fit:contain}
    .result-bars > div{grid-template-columns:7rem minmax(0,1fr) 3.6rem;gap:.4rem}
    .result-axis{margin-left:7.4rem;margin-right:4rem}
    .energy-comparison{grid-template-columns:1fr}
    .generation-case{grid-template-columns:1fr}
    .ranking-detail{grid-template-columns:1fr;gap:.8rem}
    .ranking-legend{max-width:none;display:flex;flex-wrap:wrap}
    .feasibility-fields{grid-template-columns:1fr 1fr}
    .pool-denominators{grid-template-columns:1fr 1fr;gap:1rem}
    .pool-denominators p{grid-column:1/-1;padding:.6rem 0 0;border-left:0;border-top:1px solid var(--sl-color-gray-5)}
    .objective-evidence{grid-template-columns:1fr auto 1fr}
    .objective-evidence b:nth-of-type(2){display:none}
  }
  @container(max-width:23rem){
    .teaching-context{grid-template-columns:1fr;gap:.8rem}
    .teaching-context li{grid-template-columns:4rem minmax(0,1fr);align-items:center;gap:.7rem;padding-right:1.4rem}
    .teaching-context li :global(.scientific-icon){width:4rem;height:4rem}
    .teaching-context__number{top:.2rem;right:0}
    .decision-route{grid-template-columns:1fr}
    .decision-route li,.decision-route li:last-child{grid-column:auto;grid-template-columns:4.7rem minmax(0,1fr);gap:.5rem .7rem;align-items:center;padding-right:1.3rem}
    .decision-route li :global(.scientific-icon){width:4.7rem;height:4.7rem;grid-row:1/3}
    .decision-route__number{right:0;top:.2rem}
    .decision-route small{grid-column:2;margin-top:0}
    .assay-context{grid-template-columns:1fr}
    .assay-context > div{grid-template-columns:4.3rem minmax(0,1fr);gap:.25rem .7rem;align-items:center}
    .assay-context :global(.scientific-icon){grid-row:1/3;width:4.3rem;height:4.3rem}
    .assay-context > b{display:none}
    .partition-strip{grid-template-columns:1fr;gap:.7rem}
    .partition-strip > div{grid-template-columns:4rem minmax(0,1fr);align-items:center;gap:.7rem}
    .partition-strip :global(.scientific-icon){width:4rem;height:4rem}
    .fingerprint-bins{grid-template-columns:repeat(8,minmax(0,1fr))}
    .evidence-questions{grid-template-columns:1fr}
    .pip-bars > div{grid-template-columns:1.4rem minmax(0,1fr) 2.5rem 4.5rem;gap:.4rem}
    .ranking-population{gap:.5rem}
    .ranking-population strong{font-size:1rem}
    .ranking-population span,.ranking-population small{font-size:.75rem}
    .quantity-chain{gap:1rem}
    .candidate-gallery{grid-template-columns:1fr}
    .candidate-gallery figure{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:.4rem .7rem;align-items:center}
    .candidate-gallery__id{grid-column:1/-1;margin-top:.4rem}
    .candidate-gallery img{max-height:9rem;object-fit:contain}
    .candidate-gallery figcaption{font-size:.75rem}
    .agent-trace{grid-template-columns:1fr;gap:.8rem}
    .agent-trace li{flex-direction:row;gap:.8rem}
    .agent-trace__step{flex:0 0 1.5rem}
    .nomination-actions{grid-template-columns:1fr;gap:.7rem}
    .nomination-actions > div{grid-template-columns:2rem minmax(0,1fr);align-items:center}
    .retrosynthesis-tree__product{width:85%}
    .retrosynthesis-tree__reactants{gap:.45rem}
    .teaching-control select{width:100%;min-width:0}
  }

  .teaching-context-disclosure { margin:.85rem 0 0; border-top:1px solid var(--sl-color-gray-5); }
  .teaching-context-disclosure > summary { cursor:pointer; min-height:44px; padding:.65rem 0; font-size:.78rem; font-weight:600; }
  .teaching-context-disclosure .teaching-context { margin:0 0 .2rem!important; padding:.3rem 0 .65rem!important; border:0; gap:.75rem 1rem; }
  .teaching-context-disclosure .teaching-context li { grid-template-columns:1.25rem minmax(0,1fr); gap:.45rem; }
  .teaching-context-disclosure .teaching-context__number { position:static; font-size:.7rem; padding-top:.1rem; }
  .teaching-context-disclosure .teaching-context strong { font-size:.78rem; }
  .teaching-context-disclosure .teaching-context div > span { margin-top:.15rem; }
  .teaching-budget-value { color:var(--sl-color-text); font-variant-numeric:tabular-nums; font-weight:600; }
  .teaching-scroll { max-height:27rem; overflow:auto; }
  .teaching-scroll thead th { position:sticky; top:0; z-index:2; background:var(--sl-color-bg); box-shadow:0 1px var(--sl-color-gray-4); }
  .teaching-scroll tbody tr:nth-child(even) { background:color-mix(in srgb,var(--sl-color-gray-6) 50%,transparent); }
  .teaching-scroll tbody tr:hover { background:var(--sl-color-gray-6); }
  .teaching-view summary,.teaching-view__next a,.teaching-view__sources a { min-height:44px; }
  .teaching-view__sources a,.teaching-view__next a { display:inline-flex; align-items:center; }
  .teaching-view summary:focus-visible,.teaching-view a:focus-visible,.teaching-scroll:focus-visible,.teaching-control select:focus-visible,.teaching-control input:focus-visible { outline:3px solid var(--sl-color-text-accent); outline-offset:3px; }
  .assay-context,.partition-strip { margin-top:1rem; border-top:1px solid var(--sl-color-gray-5); padding-top:.7rem; }
  .assay-context > div { grid-template-columns:2rem minmax(0,1fr); gap:.15rem .5rem; }
  .assay-context :global(.scientific-icon) { width:2rem; height:2rem; grid-row:1/3; }
  .assay-context strong { font-size:.76rem; }
  .assay-context div > span { font-size:.72rem; }
  .partition-strip { gap:.6rem; margin-bottom:0; }
  .partition-strip > div { grid-template-columns:2rem minmax(0,1fr); gap:.4rem; padding-bottom:.4rem; }
  .partition-strip :global(.scientific-icon) { width:2rem; height:2rem; }
  .partition-strip span { font-size:.73rem; }
  .partition-strip b { font-size:.78rem; margin-bottom:.15rem; }
  @container(min-width:40rem){
    .retrosynthesis-tree { grid-template-columns:minmax(0,1fr) auto minmax(0,1.4fr); gap:1rem; align-items:center; }
    .retrosynthesis-tree__product { width:100%; }
    .retrosynthesis-tree__arrow b { transform:rotate(-90deg); }
    .retrosynthesis-tree__reactants { gap:.65rem; }
  }

  /* Per-question compositions keep the scientific comparator visible. */
  .teaching-comparison { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem 1.3rem; align-items:start; }
  .teaching-comparison > .teaching-control,.teaching-comparison > .teaching-note,.teaching-comparison > .assay-context,.teaching-comparison > .partition-strip,.teaching-comparison > .linked-dose,.teaching-comparison > .quantity-chain { grid-column:1/-1; }
  .teaching-comparison > .teaching-control { margin:.2rem 0 .4rem; font-size:.75rem; }
  .teaching-comparison__panel { min-width:0; padding-top:.55rem; border-top:2px solid var(--atlas-rule); }
  .teaching-comparison__panel.is-emphasized { border-color:var(--atlas-teal-deep); }
  .teaching-comparison__panel :global(.science-plot) { margin-top:.4rem; }
  .candidate-fit { display:grid; grid-template-columns:1fr auto; align-items:baseline; gap:.35rem; font:.75rem var(--sl-font-mono,monospace); }
  .candidate-fit strong { font-size:.9rem; }
  .candidate-fit > span { color:var(--atlas-muted); }
  .candidate-fit > b { grid-column:1/-1; font-weight:500; color:var(--atlas-teal-deep); }
  .linked-dose { display:flex; flex-wrap:wrap; gap:.6rem 1.7rem; padding:.75rem 0; border-block:1px solid var(--atlas-rule); font-size:.75rem; }
  .linked-dose > span { display:flex; flex-wrap:wrap; align-items:baseline; gap:.45rem; color:var(--atlas-muted); }
  .linked-dose strong,.linked-dose b { color:var(--atlas-ink); font:.85rem var(--sl-font-mono,monospace); }
  .teaching-comparison--qsar-properties .result-bars > div { grid-template-columns:6.8rem minmax(0,1fr) 3.2rem; gap:.4rem; margin:.85rem 0; }
  .teaching-comparison--qsar-properties .result-bars strong { font-size:.75rem; }
  .teaching-comparison--qsar-properties .result-axis { margin-left:7.2rem; margin-right:3.6rem; }
  .teaching-comparison--qsar-properties .readout-heading { margin:.2rem 0; display:grid; gap:.3rem; }
  .representation-workbench { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1.1fr); gap:1rem; padding-top:.6rem; align-items:start; }
  .representation-workbench .molecule-encoding { display:block; }
  .representation-workbench .molecule-encoding img { border:0; }
  .representation-view-label { display:block; min-height:2rem; font-size:.75rem; font-weight:600; color:var(--atlas-teal-deep); padding-bottom:.6rem; border-bottom:1px solid var(--atlas-rule); margin-bottom:.6rem; }
  .representation-fields { min-width:0; }
  .representation-fields .meta-label { font-size:.75rem; color:var(--atlas-muted); margin:0 0 .4rem!important; }
  .representation-fields > div > code { display:block; min-height:2.7rem; overflow-wrap:anywhere; white-space:normal; font:.75rem var(--sl-font-mono,monospace); }
  .representation-fields dl { margin:.75rem 0 0; }
  .representation-fields dl > div { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.3rem; padding:.4rem 0; border-bottom:1px solid var(--atlas-rule); font-size:.75rem; }
  .representation-fields dt { color:var(--atlas-muted); }
  .representation-fields dd { margin:0; font-variant-numeric:tabular-nums; }
  .representation-fingerprint { min-width:0; }
  .representation-fingerprint .encoding-heading { margin:0; display:grid; gap:.25rem; }
  .representation-fingerprint .fingerprint-bins { grid-template-columns:repeat(8,minmax(0,1fr)); gap:.18rem; }
  .representation-fingerprint .fingerprint-bins span { min-height:1rem; aspect-ratio:1.1; font-size:.75rem; }
  .representation-fingerprint .teaching-note { font-size:.75rem; }
  .variant-region { border-block:1px solid var(--atlas-rule); padding:.8rem 0; }
  .variant-region__heading { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.3rem 1rem; font-size:.8rem; }
  .variant-region__heading > span { font-size:.75rem; color:var(--atlas-muted); }
  .variant-region__locus { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:1rem; padding:1rem 1rem .6rem; margin-bottom:.75rem; border-bottom:1px solid var(--atlas-rule-strong); }
  .variant-region__locus > div { display:flex; flex-direction:column; align-items:center; justify-content:end; min-height:5.3rem; gap:.3rem; font:.75rem var(--sl-font-mono,monospace); }
  .variant-region__locus i { display:block; width:.75rem; min-height:1px; background:var(--atlas-teal); border:1px solid var(--atlas-teal-deep); }
  .variant-region__locus .is-outside i { background:transparent; border-style:dashed; border-color:var(--atlas-muted); }
  .variant-region__locus span { color:var(--atlas-muted); }
  .variant-mass { display:flex; min-height:1.5rem; gap:2px; }
  .variant-mass span { display:grid; place-items:center; background:color-mix(in srgb,var(--atlas-teal) 15%,var(--atlas-bg)); border:1px solid var(--atlas-teal-deep); font:.75rem var(--sl-font-mono,monospace); }
  .variant-mass .is-outside { border:1px dashed var(--atlas-muted); background:transparent; }
  .variant-region > p { font-size:.75rem; margin:.4rem 0 0!important; color:var(--atlas-muted); }
  .variant-region ~ .pip-bars { display:none; }
  .screening-library { padding:.8rem 0; }
  .screening-library__label { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:.4rem; margin-bottom:.75rem; font-size:.8rem; }
  .screening-library__label span { font-size:.75rem; color:var(--atlas-muted); }
  .screening-library__population { padding:.8rem; border:1px solid var(--atlas-rule-strong); }
