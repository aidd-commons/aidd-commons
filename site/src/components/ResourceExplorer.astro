---
import type { Resource } from "../data/resource.js";
import { localizedAtlasLabel, buildAtlasIndex, emptyAtlasQuery } from "../lib/atlas-presentation.js";
import { sortAtlasResources } from "../lib/atlas-state.js";
import { withSiteBase } from "../lib/site-paths.js";
import AtlasResourceCard from "./AtlasResourceCard.astro";
import AtlasPagination from "./AtlasPagination.astro";
import "../styles/atlas-explorer.css";

import { localizedPath } from "../lib/site-locale.js";
interface Props { resources: Resource[]; chinese?: boolean; }
const { resources, chinese = false } = Astro.props;
const atlasLabel = (value: string) => localizedAtlasLabel(value, chinese);
const t = (en: string, zh: string) => chinese ? zh : en;
const local = (path: string) => localizedPath(path, chinese);
const index = buildAtlasIndex(resources);
const initial = sortAtlasResources(index, emptyAtlasQuery, "name").slice(0, 12);
const values = (items: string[]) => [...new Set(items)].sort();
const facets = [
  { name: "stage", label: t("Stage","阶段"), all: t("All stages","全部阶段"), values: values(resources.flatMap((resource) => resource.stages)) },
  { name: "kind", label: t("Kind","类型"), all: t("All kinds","全部类型"), values: values(resources.map((resource) => resource.kind)) },
  { name: "access", label: t("Access","访问"), all: t("All access levels","全部访问等级"), values: values(resources.map((resource) => resource.access_level.value)) },
  { name: "lifecycle", label: t("Lifecycle","生命周期"), all: t("All lifecycle states","全部生命周期状态"), values: values(resources.map((resource) => resource.status.value)) },
];
const base = import.meta.env.BASE_URL;
---

<resource-explorer data-locale={chinese ? "zh-cn" : "en"} data-index-url={withSiteBase("/data/atlas-index.json", base)} data-site-base={base}>
  <form class="atlas-controls" data-atlas-controls aria-label={t("Filter atlas resources","筛选图谱资源")} role="search" action={local("/atlas/browse/")}>
    <label class="atlas-search">
      <span>{t("Search","搜索")}</span>
      <input disabled name="q" type="search" placeholder={t("Name, purpose, identifier, task or modality","名称、用途、标识符、任务或模态")} autocomplete="off" aria-describedby="atlas-search-help" />
    </label>
    {facets.map((facet) => <label for={`atlas-${facet.name}`}>
      <span id={`atlas-${facet.name}-label`}>{facet.label}</span>
      <select disabled id={`atlas-${facet.name}`} name={facet.name} aria-labelledby={`atlas-${facet.name}-label`} data-all-label={facet.all}>
        <option value="">{facet.all}</option>
        {facet.values.map((value) => <option value={value}>{atlasLabel(value)}</option>)}
      </select>
    </label>)}
    <button disabled type="reset">{t("Clear filters","清除筛选")}</button>
  </form>
  <p id="atlas-search-help" class="atlas-help">{t("Search recorded purpose, task, modality and source identifiers. Filters combine. Record prose is canonical English.","搜索已记录的用途、任务、模态和来源标识符。筛选条件共同生效，记录正文为英语原文。")}</p>
  <div class="atlas-active" role="group" aria-label={t("Active filters","当前筛选")}>
    <span class="meta-label">{t("Selected","已选")}</span>
    <div data-active-filters><span class="atlas-help">{t("No active filters","未设置筛选")}</span></div>
  </div>
  <section id="compare" class="atlas-comparison" aria-labelledby="compare-title">
    <div class="atlas-comparison__heading">
      <div><p class="meta-label">{t("Reuse and evidence","复用与证据")}</p><h2 id="compare-title">{t("Compare resource records","比较资源记录")}</h2></div>
      <button type="button" data-compare-clear disabled>{t("Clear comparison","清空比较")}</button>
    </div>
    <p class="atlas-help">{t("Choose 2–4 resources. Compare scientific scope, licences and seven independent asset dimensions. These metadata do not establish a matched performance ranking.","选择 2–4 项资源，比较科学范围、许可与七个独立资产维度。这些元数据不构成同一评估方案下的性能排名。")}</p>
    <ul class="atlas-compare-tray" data-compare-tray aria-label={t("Selected resources","已选资源")}><li>{t("No resources selected","尚未选择资源")}</li></ul>
    <p data-compare-status role="status" aria-live="polite">{t("Select resources using the Compare controls in the results.","使用结果中的“比较”控件选择资源。")}</p>
    <div data-compare-panel></div>
  </section>
  <div class="atlas-result-bar">
    <p class="result-count" data-result-count aria-live="polite" aria-atomic="true">{chinese ? `共 ${resources.length} 项资源` : `${resources.length} of ${resources.length} resources`}</p>
    <a data-share-query href={local("/atlas/")}>{t("Link to these results","分享当前结果")}</a>
  </div>
  <div class="atlas-display-controls">
    <div class="atlas-view-buttons" role="group" aria-label={t("Result view","结果视图")}>
      {(["list", "table", "landscape"] as const).map((view) => <button disabled type="button" data-atlas-view={view} aria-pressed={view === "list"}>{atlasLabel(view)}</button>)}
    </div>
    <label class="atlas-sort">{t("Sort", "排序")}
      <select disabled name="sort" data-atlas-sort>
        <option value="relevance">{t("Text match, then name","文本相关度，然后按名称")}</option>
        <option value="name">{t("Name A–Z","名称 A–Z")}</option>
        <option value="checked">{t("Record check date, newest first","记录核查日期，从新到旧")}</option>
      </select>
    </label>
    <button type="button" data-atlas-export disabled>{t("Export matching records","导出匹配记录")}</button>
  </div>
  <p class="atlas-help" data-initial-preview>{t("Initial preview: ", "初始预览：")}{initial.length}{t(" records. ", " 条记录。")}<a href={local("/atlas/browse/")}>{chinese ? `无需交互筛选，浏览全部 ${resources.length} 条记录 →` : `Browse all ${resources.length} records without interactive filters →`}</a></p>
  <p class="notice" data-index-status role="status" hidden>{t("Loading the searchable catalogue…","正在加载可检索目录…")}</p>
  <button type="button" data-retry-index hidden>{t("Retry loading the search index","重新加载检索索引")}</button>
  <p class="notice" data-empty-state hidden>{t("No resources match this selection. Remove a filter or clear the search.","没有匹配当前条件的资源。请移除筛选或清空搜索。")}</p>
  <noscript><p>{t("Interactive search and comparison need JavaScript. ", "交互检索与比较需要 JavaScript。")}<a href={local("/atlas/browse/")}>{t("Browse the complete catalogue and open each evidence record","浏览完整目录并打开各条证据记录")}</a>.</p></noscript>
  <AtlasPagination position="top" chinese={chinese} />
  <ul class="atlas-results" data-atlas-results aria-label={t("Resource results","资源结果")}>
    {initial.map((resource) => <AtlasResourceCard resource={resource} selectable chinese={chinese} />)}
  </ul>
  <div data-atlas-table hidden></div>
  <div data-atlas-landscape hidden></div>
  <AtlasPagination position="bottom" chinese={chinese} />
</resource-explorer>

<script>
  import { ResourceExplorer } from "../lib/atlas-explorer.js";
  if (!customElements.get("resource-explorer")) customElements.define("resource-explorer", ResourceExplorer);
</script>
