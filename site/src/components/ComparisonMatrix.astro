---
import type {
  ComparisonProvider,
  ComparisonRow,
  CoverageDepth,
} from "../data/comparison.js";
import { comparisonTrackTitle } from "../data/comparison.js";

interface Props {
  chinese?: boolean;
  providers: ComparisonProvider[];
  rows: ComparisonRow[];
}

const { providers, rows, chinese = false } = Astro.props;
const t = (en: string, zh: string) => chinese ? zh : en;
const initialTrack = "foundations";
const label = (value: string) =>
  value
    .replaceAll("-", " ")
    .replaceAll("_", " ")
    .replace(/^./u, (character) => character.toUpperCase());
const tracks = [...new Set(rows.map(({ track_id }) => track_id))];
const topics = [
  ...new Map(
    rows.map((row) => [
      row.topic_id,
      {
        id: row.topic_id,
        order: row.topic_order,
        title: row.topic_title,
        track: row.track_id,
        trackOrder: row.track_order,
      },
    ]),
  ).values(),
].sort((left, right) =>
  left.trackOrder === right.trackOrder
    ? left.order - right.order
    : left.trackOrder - right.trackOrder,
);
const providerClasses = [
  ...new Set(providers.map(({ provider_class }) => provider_class)),
].sort();
const contentAccessValues = [
  ...new Set(providers.map(({ access }) => access.content.value)),
].sort();
const languages = [...new Set(providers.flatMap(({ languages }) => languages))].sort();
const reviewDates = [...new Set(providers.map(({ last_verified }) => last_verified))].sort();
const depths: CoverageDepth[] = [
  "assessed",
  "executable",
  "worked",
  "explained",
  "mentioned",
  "absent",
  "unverified",
];
const providersById = new Map(providers.map((provider) => [provider.id, provider]));
const initialCount = rows.filter(({ track_id }) => track_id === initialTrack).length;
const depthSymbols: Record<CoverageDepth,string> = {assessed:"A",executable:"X",worked:"W",explained:"E",mentioned:"M",absent:"–",unverified:"?"};
const rowsByCell = new Map(rows.map(row=>[`${row.provider_id}:${row.topic_id}`,row]));
---

<comparison-audit data-locale={chinese ? "zh-cn" : "en"}>
  <header class="comparison-heading"><p>{t("Topic-level evidence map","主题层面的证据图")}</p><h3 id="comparison-cells">{t("Inspect a provider, then open its source","检查提供方，再打开来源")}</h3><p>{t("Each mark is one recorded provider–topic claim. Teaching depth, direct review and uncertainty remain separate; the map does not rank performance.","每个标记表示一条已记录的提供方—主题主张。教学深度、直接审阅与不确定性分别记录；此图不对性能排名。")}</p></header>
  <form class="comparison-controls" data-comparison-controls aria-label={t("Filter comparison cells","筛选比较单元格")}>
    <div class="comparison-field">
      <label for="comparison-track">{t("Track","学习方向")}</label>
      <select id="comparison-track" name="track">
        {tracks.map((track) => (
          <option value={track} selected={track === initialTrack}>{comparisonTrackTitle(track)}</option>
        ))}
      </select>
    </div>
    <div class="comparison-field">
      <label for="comparison-topic">{t("Topic","主题")}</label>
      <select id="comparison-topic" name="topic">
        <option value="">{t("All topics in track","本方向全部主题")}</option>
        {topics.map((topic) => (
          <option
            value={topic.id}
            data-track={topic.track}
            hidden={topic.track !== initialTrack}
            disabled={topic.track !== initialTrack}
          >
            {topic.title}
          </option>
        ))}
      </select>
    </div>
    <div class="comparison-field">
      <label for="comparison-provider-class">{t("Provider class","提供方类型")}</label>
      <select id="comparison-provider-class" name="providerClass">
        <option value="">{t("All provider classes","全部提供方类型")}</option>
        {providerClasses.map((providerClass) => (
          <option value={providerClass}>{label(providerClass)}</option>
        ))}
      </select>
    </div>
    <div class="comparison-field">
      <label for="comparison-depth">{t("Coverage depth","覆盖深度")}</label>
      <select id="comparison-depth" name="depth">
        <option value="">{t("All depth states","全部深度状态")}</option>
        {depths.map((depth) => <option value={depth}>{label(depth)}</option>)}
      </select>
    </div>
    <div class="comparison-field">
      <label for="comparison-access">{t("Content access","内容访问")}</label>
      <select id="comparison-access" name="access">
        <option value="">{t("All content access states","全部内容访问状态")}</option>
        {contentAccessValues.map((access) => (
          <option value={access}>{label(access)}</option>
        ))}
      </select>
    </div>
    <div class="comparison-field">
      <label for="comparison-language">{t("Language","语言")}</label>
      <select id="comparison-language" name="language">
        <option value="">{t("All maintained languages","全部维护语言")}</option>
        {languages.map((language) => (
          <option value={language}>{language.toUpperCase()}</option>
        ))}
      </select>
    </div>
    <div class="comparison-field">
      <label for="comparison-review-after">{t("Reviewed on or after","审阅日期不早于")}</label>
      <input id="comparison-review-after" name="reviewAfter" type="date" max={reviewDates.at(-1)} />
    </div>
    <div class="check-control">
      <input id="comparison-direct" name="direct" type="checkbox" />
      <label for="comparison-direct">{t("Direct observations only","仅直接观察")}</label>
    </div>
    <button type="reset">{t("Reset filters","重置筛选")}</button>
  </form>

  <div class="comparison-key" aria-label={t("Coverage depth key","覆盖深度图例")}>
    {depths.map((depth) => (
      <span class={`depth-badge depth-badge--${depth}`}><i aria-hidden="true">{depthSymbols[depth]}</i>{label(depth)}</span>
    ))}
  </div>

  <p class="result-count" data-comparison-count aria-live="polite">
    {initialCount} {t("comparison cells shown", "个比较单元格已显示")}
  </p>
  <p class="notice" data-comparison-empty hidden>
    {t("No comparison cells match these filters. Reset one or more controls.", "没有符合这些筛选条件的比较单元格。请重置一个或多个控件。")}
  </p>

  <div class="comparison-workspace">
  <figure class="comparison-overview" data-comparison-overview>
    <figcaption><strong>{t("Read across topics, compare the evidence states","横跨主题，比较证据状态")}</strong><span>{t("Select a mark to open the matching source record below. D = direct review; ? = an explicit unknown default when no direct cell was encoded.","选择标记以打开下方对应的来源记录。D = 直接审阅；? = 未编码直接观察时的明确未知默认状态。")}</span></figcaption>
    <div class="comparison-overview__scroll" role="region" aria-label={t("Provider by topic evidence matrix","提供方与主题的证据矩阵")} tabindex="0">
      {tracks.filter(track=>track===initialTrack).map(track=>{
        const trackTopics=topics.filter(topic=>topic.track===track);
        return <table class="comparison-overview__matrix" data-overview-track={track} hidden={track!==initialTrack}><caption>{comparisonTrackTitle(track)} · {t("categorical teaching depth", "分类教学深度")}</caption><thead><tr><th scope="col">{t("Provider","提供方")}</th>{trackTopics.map(topic=><th scope="col" data-overview-topic={topic.id}>{topic.title}</th>)}</tr></thead><tbody>{providers.map(provider=><tr data-overview-provider={provider.id}><th scope="row">{provider.name}</th>{trackTopics.map(topic=>{
          const row=rowsByCell.get(`${provider.id}:${topic.id}`);
          if(!row) throw new Error(`Missing evidence-map cell ${provider.id}:${topic.id}`);
          return <td data-overview-cell={`${provider.id}:${topic.id}`} data-overview-topic={topic.id}><a class:list={["comparison-overview__mark",`depth-${row.depth}`,{"is-default":row.coverage_origin!=="direct"}]} href={`#comparison-cell-${provider.id}-${topic.id}`} data-comparison-focus aria-label={`${provider.name}, ${topic.title}: ${label(row.depth)}; ${row.coverage_origin==="direct"?"direct review":"explicit unknown default"}. Open the source record.`}><span aria-hidden="true">{depthSymbols[row.depth]}</span><small aria-hidden="true">{row.coverage_origin==="direct"?"D":"?"}</small></a><span class="comparison-overview__filtered" hidden aria-label={t("Filtered out","已筛除")}>·</span></td>;
        })}</tr>)}</tbody></table>;
      })}
    </div>
  </figure>
  <section class="comparison-inspector" data-comparison-inspector aria-labelledby="comparison-selected-title" hidden>
    <p class="comparison-inspector__eyebrow">{t("Selected evidence cell", "所选证据单元格")}</p>
    <h4 id="comparison-selected-title" data-comparison-selected-title tabindex="-1"></h4>
    <div data-comparison-selected-body></div>
  </section>
  </div>
  <noscript><p class="comparison-noscript">{t("The initial Foundations map and its source records are readable without JavaScript. Filter controls require scripting.","初始基础方向图及其来源记录无需 JavaScript 即可阅读。筛选控件需要脚本。")}</p></noscript>

  <details class="comparison-records" data-comparison-records open><summary>{t("Read the matching source records as a table", "以表格阅读匹配的来源记录")}</summary>
  <div class="comparison-table-wrap">
    <table class="comparison-table">
      <caption data-comparison-caption>
        {comparisonTrackTitle(initialTrack)}{t(" coverage cells. Bounds are evaluated at explained depth.", "覆盖单元格。上下界按解释深度计算。")}
      </caption>
      <thead>
        <tr>
          <th scope="col">{t("Provider","提供方")}</th>
          <th scope="col">{t("Topic","主题")}</th>
          <th scope="col">{t("Depth","深度")}</th>
          <th scope="col">{t("Explained bounds","解释深度上下界")}</th>
          <th scope="col">{t("Evidence","证据")}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => {
          const provider = providersById.get(row.provider_id);
          if (!provider) {
            throw new Error(`Missing provider metadata for ${row.provider_id}`);
          }
          return (
            <tr
              class="comparison-row"
              id={`comparison-cell-${row.provider_id}-${row.topic_id}`}
              tabindex="-1"
              data-track={row.track_id}
              data-provider-class={row.provider_class}
              data-depth={row.depth}
              data-origin={row.coverage_origin}
              data-provider-id={row.provider_id}
              data-topic-id={row.topic_id}
              data-topic-order={row.topic_order}
              data-content-access={provider.access.content.value}
              data-languages={provider.languages.join(",")}
              data-last-reviewed={provider.last_verified}
              hidden={row.track_id !== initialTrack}
            >
              <td data-column="provider" data-label={t("Provider","提供方")}>
                {provider.canonical_source.source_type === "url" ? (
                  <a href={provider.canonical_source.url}>{row.provider_name}</a>
                ) : (
                  <strong>{row.provider_name}</strong>
                )}
                <span class="cell-subline">
                  {label(row.provider_class)} · {t("content", "内容")} {label(provider.access.content.value)}<br />
                  {provider.languages.map((language) => language.toUpperCase()).join(", ")} · {t("reviewed", "审阅日期")} {provider.last_verified}
                </span>
              </td>
              <td data-column="topic" data-label={t("Topic","主题")}>
                <strong>{row.topic_title}</strong>
                <span class="cell-subline">
                  {row.topic_core ? t("Core topic", "核心主题") : t("Extended topic", "扩展主题")} · {row.topic_id}
                </span>
              </td>
              <td data-column="depth" data-label={t("Depth","深度")}>
                <span class={`depth-badge depth-badge--${row.depth}`}>{label(row.depth)}</span>
                <span class="cell-subline">{row.coverage_origin === "direct" ? t("Direct review", "直接审阅") : t("Explicit unknown default", "明确未知默认状态")}</span>
              </td>
              <td data-column="bounds" data-label={t("Explained bounds","解释深度上下界")}>
                <span class="bounds-pair"><span>{t("Lower", "下界")} {row.lower_at_explained}</span><span>{t("Upper", "上界")} {row.upper_at_explained}</span></span>
              </td>
              <td data-column="evidence" data-label={t("Evidence","证据")}>
                <details class="cell-evidence">
                  <summary>{row.evidence.length > 0 ? `${t("Evidence", "证据")} (${row.evidence.length})` : t("Evidence status", "证据状态")}</summary>
                  <p><strong>{t("Reviewed scope:","已审阅范围：")}</strong> {row.reviewed_scope}</p>
                  <p><strong>{t("Interpretation:","解读：")}</strong> {row.note}</p>
                  {row.evidence.length > 0 ? (
                    <ul class="evidence-source-list">
                      {row.evidence.map((source) => (
                        <li>
                          {source.source_type === "url" ? (
                            <a href={source.url}>{source.title}</a>
                          ) : (
                            <>
                              <strong>{source.title}</strong>
                              <code>{source.repository_path}</code>
                            </>
                          )}
                          <span class="cell-subline">
                            {label(source.access)} · {t("reviewed", "审阅日期")} {source.reviewed_on}
                            {source.version ? ` · ${source.version}` : ""}
                          </span>
                          <p>{source.observed_scope}</p>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="unknown-note">{t("No topic-specific source was encoded in this dated review.","这次带日期的评阅中未编码主题专属来源。")}</p>
                  )}
                </details>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  </details>
</comparison-audit>

<script>
  class ComparisonAudit extends HTMLElement {
    private form?: HTMLFormElement;
    private selectedCell = "";
    private t(en: string, zh: string) { return this.dataset.locale === "zh-cn" ? zh : en; }

    connectedCallback() {
      this.form =
        this.querySelector<HTMLFormElement>("[data-comparison-controls]") ??
        undefined;
      if (!this.form) return;
      this.selectedCell = location.hash.slice(1);
      this.restoreQuery();
      this.form.addEventListener("change", () => this.applyFilters(true));
      this.form.addEventListener("reset", () => {
        requestAnimationFrame(() => this.applyFilters(true));
      });
      this.addEventListener("click",event=>{
        const mark=event.target instanceof Element?event.target.closest<HTMLAnchorElement>("[data-comparison-focus]"):null;
        if(!mark)return;
        const row=this.querySelector<HTMLTableRowElement>(`#${CSS.escape(mark.hash.slice(1))}`);
        if(!row||row.hidden)return;
        event.preventDefault();
        this.selectCell(row);
        history.replaceState({}, "", `${location.pathname}${location.search}#${row.id}`);
        if (event.detail === 0) this.querySelector<HTMLElement>("[data-comparison-selected-title]")?.focus({preventScroll:true});
      });
      window.addEventListener("popstate", () => {
        this.form?.reset();
        this.selectedCell = location.hash.slice(1);
        this.restoreQuery();
        this.applyFilters(false);
      });
      this.applyFilters(false);
      const records = this.querySelector<HTMLDetailsElement>("[data-comparison-records]");
      if (records) records.open = false;
    }

    private selectCell(row: HTMLTableRowElement) {
      const inspector = this.querySelector<HTMLElement>("[data-comparison-inspector]");
      const body = this.querySelector<HTMLElement>("[data-comparison-selected-body]");
      const title = this.querySelector<HTMLElement>("[data-comparison-selected-title]");
      if (!inspector || !body || !title) return;
      this.selectedCell = row.id;
      inspector.hidden = false;
      title.textContent = row.querySelector('[data-column="topic"] strong')?.textContent ?? "";
      body.replaceChildren();
      const facts = document.createElement("dl");
      for (const [column, label] of [["provider", this.t("Provider", "提供方")], ["depth", this.t("Teaching depth", "教学深度")], ["bounds", this.t("Explained bounds", "解释深度上下界")]]) {
        const group = document.createElement("div");
        const term = document.createElement("dt"); term.textContent = label;
        const value = document.createElement("dd");
        const source = row.querySelector(`[data-column="${column}"]`);
        if (source) value.append(...[...source.childNodes].map(node => node.cloneNode(true)));
        group.append(term, value); facts.append(group);
      }
      body.append(facts);
      const evidence = row.querySelector<HTMLDetailsElement>("details")?.cloneNode(true) as HTMLDetailsElement | undefined;
      if (evidence) { evidence.open = true; body.append(evidence); }
      this.querySelectorAll<HTMLAnchorElement>("[data-comparison-focus]").forEach(mark => {
        if (mark.hash === `#${row.id}`) mark.setAttribute("aria-current", "true");
        else mark.removeAttribute("aria-current");
      });
    }

    private restoreQuery() {
      if (!this.form) return;
      const params = new URLSearchParams(location.search);
      for (const name of [
        "track",
        "providerClass",
        "depth",
        "access",
        "language",
      ] as const) {
        const value = params.get(name);
        const field = this.form.elements.namedItem(name);
        if (value && field instanceof HTMLSelectElement) {
          const hasOption = [...field.options].some((option) => option.value === value);
          if (hasOption) field.value = value;
        }
      }
      const track = this.form.elements.namedItem("track");
      if (track instanceof HTMLSelectElement) {
        this.syncTopicOptions(track.value);
      }
      const topicValue = params.get("topic");
      const topic = this.form.elements.namedItem("topic");
      if (topicValue && topic instanceof HTMLSelectElement) {
        const option = [...topic.options].find(
          (candidate) => candidate.value === topicValue && !candidate.disabled,
        );
        if (option) topic.value = topicValue;
      }
      const reviewAfter = this.form.elements.namedItem("reviewAfter");
      if (reviewAfter instanceof HTMLInputElement) {
        reviewAfter.value = params.get("reviewAfter") ?? "";
      }
      const direct = this.form.elements.namedItem("direct");
      if (direct instanceof HTMLInputElement) {
        direct.checked = params.get("direct") === "1";
      }
    }

    private syncTopicOptions(track: string) {
      if (!this.form) return;
      const topic = this.form.elements.namedItem("topic");
      if (!(topic instanceof HTMLSelectElement)) return;

      for (const option of topic.options) {
        if (!option.dataset.track) continue;
        const available = option.dataset.track === track;
        option.disabled = !available;
        option.hidden = !available;
      }
      const selected = topic.selectedOptions.item(0);
      if (selected?.dataset.track && selected.dataset.track !== track) {
        topic.value = "";
      }
    }

    /** Reuse the source rows instead of duplicating every track's evidence HTML. */
    private renderOverview(track: string) {
      const scroll=this.querySelector<HTMLElement>(".comparison-overview__scroll");
      if(!scroll||scroll.querySelector<HTMLElement>("[data-overview-track]")?.dataset.overviewTrack===track)return;
      const sourceRows=[...this.querySelectorAll<HTMLTableRowElement>("tbody .comparison-row")].filter(row=>row.dataset.track===track);
      const topics=new Map<string,{title:string;order:number}>();
      const providers=new Map<string,{name:string;rows:Map<string,HTMLTableRowElement>}>();
      const text=(element:Element|null)=>element?.textContent?.replace(/\s+/g," ").trim()??"";
      for(const row of sourceRows){
        const topicId=row.dataset.topicId!,providerId=row.dataset.providerId!;
        topics.set(topicId,{title:text(row.querySelector('[data-column="topic"] strong')),order:Number(row.dataset.topicOrder)});
        if(!providers.has(providerId))providers.set(providerId,{name:text(row.querySelector('[data-column="provider"] a, [data-column="provider"] strong')),rows:new Map()});
        providers.get(providerId)!.rows.set(topicId,row);
      }
      const orderedTopics=[...topics.entries()].sort((left,right)=>left[1].order-right[1].order);
      const makeCell=(tag:"th"|"td",value:string)=>{const cell=document.createElement(tag);cell.textContent=value;return cell;};
      const table=document.createElement("table");table.className="comparison-overview__matrix";table.dataset.overviewTrack=track;
      const caption=table.createCaption();
      const trackField=this.form?.elements.namedItem("track");
      caption.textContent=(trackField instanceof HTMLSelectElement?trackField.selectedOptions.item(0)?.textContent:track)+this.t(" · categorical teaching depth", " · 分类教学深度");
      const header=table.createTHead().insertRow();const providerHeading=makeCell("th",this.t("Provider", "提供方"));providerHeading.scope="col";header.append(providerHeading);
      for(const [id,topic] of orderedTopics){const cell=makeCell("th",topic.title);cell.scope="col";cell.dataset.overviewTopic=id;header.append(cell);}
      const body=table.createTBody();
      const symbols:Record<string,string>={assessed:"A",executable:"X",worked:"W",explained:"E",mentioned:"M",absent:"–",unverified:"?"};
      for(const [providerId,provider] of providers){
        const providerRow=body.insertRow();providerRow.dataset.overviewProvider=providerId;
        const providerCell=makeCell("th",provider.name);providerCell.scope="row";providerRow.append(providerCell);
        for(const [topicId,topic] of orderedTopics){
          const source=provider.rows.get(topicId);if(!source)continue;
          const direct=source.dataset.origin==="direct",depth=source.dataset.depth??"unverified";
          const cell=makeCell("td","");cell.dataset.overviewCell=`${providerId}:${topicId}`;cell.dataset.overviewTopic=topicId;
          const mark=document.createElement("a");mark.className=`comparison-overview__mark depth-${depth}${direct?"":" is-default"}`;mark.href=`#${source.id}`;mark.dataset.comparisonFocus="";
          mark.setAttribute("aria-label",this.t(`${provider.name}, ${topic.title}: ${depth}; ${direct?"direct review":"explicit unknown default"}. Open the source record.`, `${provider.name}，${topic.title}：${depth}；${direct?"直接审阅":"明确未知默认状态"}。打开来源记录。`));
          const symbol=document.createElement("span");symbol.textContent=symbols[depth]??"?";symbol.setAttribute("aria-hidden","true");
          const origin=document.createElement("small");origin.textContent=direct?"D":"?";origin.setAttribute("aria-hidden","true");
          mark.append(symbol,origin);const filtered=document.createElement("span");filtered.className="comparison-overview__filtered";filtered.textContent="·";filtered.hidden=true;filtered.setAttribute("aria-label",this.t("Filtered out", "已筛除"));
          cell.append(mark,filtered);providerRow.append(cell);
        }
      }
      // Dynamically assembled tracks use the same component-scoped visual rules.
      const scopeAttributes = [...scroll.attributes].filter(attribute => attribute.name.startsWith("data-astro-cid-"));
      for (const node of [table, ...table.querySelectorAll<HTMLElement>("*")]) {
        scopeAttributes.forEach(attribute => node.setAttribute(attribute.name, attribute.value));
      }
      scroll.replaceChildren(table);
    }

    private applyFilters(updateLocation: boolean) {
      if (!this.form) return;
      const trackField = this.form.elements.namedItem("track");
      const selectedTrack =
        trackField instanceof HTMLSelectElement ? trackField.value : "";
      this.syncTopicOptions(selectedTrack);
      const formData = new FormData(this.form);
      const track = String(formData.get("track") ?? "");
      const topic = String(formData.get("topic") ?? "");
      const providerClass = String(formData.get("providerClass") ?? "");
      const depth = String(formData.get("depth") ?? "");
      const access = String(formData.get("access") ?? "");
      const language = String(formData.get("language") ?? "");
      const reviewAfter = String(formData.get("reviewAfter") ?? "");
      const directOnly = formData.get("direct") === "on";
      let visible = 0;
      const visibleCells = new Set<string>();

      for (const row of this.querySelectorAll<HTMLTableRowElement>(
        "tbody .comparison-row",
      )) {
        const matches =
          row.dataset.track === track &&
          (!topic || row.dataset.topicId === topic) &&
          (!providerClass || row.dataset.providerClass === providerClass) &&
          (!depth || row.dataset.depth === depth) &&
          (!access || row.dataset.contentAccess === access) &&
          (!language ||
            (row.dataset.languages ?? "").split(",").includes(language)) &&
          (!reviewAfter || (row.dataset.lastReviewed ?? "") >= reviewAfter) &&
          (!directOnly || row.dataset.origin === "direct");
        row.hidden = !matches;
        if (matches) { visible += 1; visibleCells.add(`${row.dataset.providerId}:${row.dataset.topicId}`); }
      }

      this.renderOverview(track);
      this.querySelectorAll<HTMLTableElement>("[data-overview-track]").forEach(matrix=>{
        matrix.hidden=matrix.dataset.overviewTrack!==track;
        matrix.querySelectorAll<HTMLElement>("[data-overview-topic]").forEach(cell=>{cell.hidden=Boolean(topic&&cell.dataset.overviewTopic!==topic);});
        matrix.querySelectorAll<HTMLElement>("[data-overview-cell]").forEach(cell=>{
          const matches=visibleCells.has(cell.dataset.overviewCell??"");
          const mark=cell.querySelector<HTMLAnchorElement>("[data-comparison-focus]");
          if(mark)mark.hidden=!matches;
          const filtered=cell.querySelector<HTMLElement>(".comparison-overview__filtered");
          if(filtered)filtered.hidden=matches;
        });
        matrix.querySelectorAll<HTMLTableRowElement>("[data-overview-provider]").forEach(provider=>{
          provider.hidden=![...provider.querySelectorAll<HTMLElement>("[data-overview-cell]")].some(cell=>visibleCells.has(cell.dataset.overviewCell??""));
        });
      });
      const overview=this.querySelector<HTMLElement>("[data-comparison-overview]");
      if(overview)overview.hidden=visible===0;
      const sourceRows = [...this.querySelectorAll<HTMLTableRowElement>("tbody .comparison-row")].filter(row => !row.hidden);
      const selected = sourceRows.find(row => row.id === this.selectedCell) ?? sourceRows.find(row => row.dataset.providerId === "aidd-commons") ?? sourceRows[0];
      if (selected) this.selectCell(selected);
      else { const inspector = this.querySelector<HTMLElement>("[data-comparison-inspector]"); if (inspector) inspector.hidden = true; }

      const count = this.querySelector<HTMLElement>("[data-comparison-count]");
      const empty = this.querySelector<HTMLElement>("[data-comparison-empty]");
      const caption = this.querySelector<HTMLElement>("[data-comparison-caption]");
      if (count) count.textContent = this.t(`${visible} comparison ${visible === 1 ? "cell" : "cells"} shown`, `已显示 ${visible} 个比较单元格`);
      if (empty) empty.hidden = visible !== 0;
      if (caption) {
        const trackName =
          trackField instanceof HTMLSelectElement
            ? trackField.selectedOptions.item(0)?.textContent ?? track
            : track;
        const topicName = topic
          ? this.form.querySelector<HTMLOptionElement>(
              `select[name="topic"] option[value="${CSS.escape(topic)}"]`,
            )?.textContent
          : this.t("all topics", "全部主题");
        caption.textContent = this.t(`${trackName}: ${topicName ?? topic}. Bounds are evaluated at explained depth.`, `${trackName}：${topicName ?? topic}。上下界按解释深度计算。`);
      }

      if (updateLocation) {
        const params = new URLSearchParams();
        if (track && track !== "foundations") params.set("track", track);
        if (topic) params.set("topic", topic);
        if (providerClass) params.set("providerClass", providerClass);
        if (depth) params.set("depth", depth);
        if (access) params.set("access", access);
        if (language) params.set("language", language);
        if (reviewAfter) params.set("reviewAfter", reviewAfter);
        if (directOnly) params.set("direct", "1");
        const query = params.toString();
        history.replaceState({}, "", `${location.pathname}${query ? `?${query}` : ""}${selected ? `#${selected.id}` : ""}`);
      }
    }
  }

  if (!customElements.get("comparison-audit")) {
    customElements.define("comparison-audit", ComparisonAudit);
  }
</script>

