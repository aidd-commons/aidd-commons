---
import "../styles/global.css";
import { withoutSiteBase } from "../lib/site-paths";
import { languageAlternate } from "../lib/site-locale";
import WorkbenchSearch from "./WorkbenchSearch.astro";

interface Props {
  description: string;
  lang?: "en" | "zh-CN";
  title: string;
}

const { description, lang = "en", title } = Astro.props;
const chinese = lang === "zh-CN";
const pathname = withoutSiteBase(Astro.url.pathname, import.meta.env.BASE_URL);
const alternate = languageAlternate(pathname, "/", chinese);
const navigation = chinese
  ? [
      ["学习", "/zh-cn/learn/"],
      ["图谱", "/zh-cn/atlas/"],
      ["实验室", "/zh-cn/labs/"],
      ["审计", "/zh-cn/audit/"],
      ["报告", "/zh-cn/report/"],
      ["参与", "/zh-cn/contribute/"],
    ]
  : [
      ["Learn", "/learn/"],
      ["Atlas", "/atlas/"],
      ["Labs", "/labs/"],
      ["Audit", "/audit/"],
      ["Report", "/report/"],
      ["Contribute", "/contribute/"],
    ];

// The three states the toggle cycles through. "system" is the state Starlight calls auto: it
// keeps the key empty, which both implementations read as "follow the operating system".
const themeLabels = {
  auto: {
    short: chinese ? "跟随系统" : "System",
    label: chinese ? "颜色主题：跟随系统。切换到浅色。" : "Colour theme: system. Switch to light.",
  },
  light: {
    short: chinese ? "浅色" : "Light",
    label: chinese ? "颜色主题：浅色。切换到深色。" : "Colour theme: light. Switch to dark.",
  },
  dark: {
    short: chinese ? "深色" : "Dark",
    label: chinese ? "颜色主题：深色。切换到跟随系统。" : "Colour theme: dark. Switch to system.",
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | AIDD Commons</title>
    <script is:inline>
      // The bootstrap Starlight runs on its own pages, repeated here so that the custom shell
      // starts in the theme the reader already chose. The key and the attribute are the same
      // ones Starlight uses, so the two halves of the site never disagree. The script is
      // inline and sits in the head, so the attribute is set before the first paint.
      (() => {
        let stored = null;
        try {
          stored = window.localStorage.getItem("starlight-theme");
        } catch {
          stored = null;
        }
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{chinese ? "跳到主要内容" : "Skip to main content"}</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={chinese ? "/zh-cn/" : "/"}>AIDD Commons</a>
        <WorkbenchSearch chinese={chinese} />
        <site-navigation>
          <button class="nav-toggle" type="button" aria-label={chinese ? "打开导航" : "Open navigation"} aria-controls="primary-navigation" aria-expanded="false">
            <span aria-hidden="true">{chinese ? "导航" : "Menu"}</span>
          </button>
          <nav id="primary-navigation" class="primary-nav" aria-label={chinese ? "主要导航" : "Primary navigation"}>
            {navigation.map(([label, href]) => <a href={href} aria-current={pathname === href || (href !== "/" && pathname.startsWith(href)) ? "page" : undefined}>{label}</a>)}
            <a class="language-link" data-language-link href={alternate}>{chinese ? "English" : "中文"}</a>
          </nav>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            data-theme-labels={JSON.stringify(themeLabels)}
            aria-label={themeLabels.auto.label}
          >
            <span data-theme-toggle-text>{themeLabels.auto.short}</span>
          </button>
        </site-navigation>
      </div>
    </header>
    <script is:inline>
      // The theme control. It writes the same localStorage key Starlight writes and updates the
      // same attribute on the html element, so a reader who changes the theme here finds it
      // already changed on a lesson page.
      (() => {
        const button = document.querySelector("[data-theme-toggle]");
        if (!button) return;
        const labels = JSON.parse(button.dataset.themeLabels);
        const modes = ["auto", "light", "dark"];
        const text = button.querySelector("[data-theme-toggle-text]");
        const prefersLight = () => window.matchMedia("(prefers-color-scheme: light)").matches;
        const effective = (mode) => (mode === "auto" ? (prefersLight() ? "light" : "dark") : mode);
        const read = () => {
          try {
            const stored = window.localStorage.getItem("starlight-theme");
            return stored === "light" || stored === "dark" ? stored : "auto";
          } catch {
            return "auto";
          }
        };
        const apply = (mode) => {
          document.documentElement.dataset.theme = effective(mode);
          button.dataset.themeMode = mode;
          button.setAttribute("aria-label", labels[mode].label);
          if (text) text.textContent = labels[mode].short;
        };
        button.addEventListener("click", () => {
          const next = modes[(modes.indexOf(read()) + 1) % modes.length];
          try {
            window.localStorage.setItem("starlight-theme", next === "auto" ? "" : next);
          } catch {
            // A reader without storage still gets the theme for this page.
          }
          apply(next);
        });
        window.matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
          if (read() === "auto") apply("auto");
        });
        apply(read());
      })();
    </script>
    <main id="main-content" class="page-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>{chinese ? "英语内容为规范版本；课程与实验说明提供中文译文。图谱原始记录、科学图表和下载文件保留原始语言或格式。" : "English is canonical. Lessons and lab guides have Chinese translations. Source records, scientific panels and downloads retain their original language or format."}</p>
        <a href={chinese ? "/zh-cn/contribute/" : "/contribute/"}>{chinese ? "参与与纠错" : "Contribute a correction"}<span aria-hidden="true">↗</span></a>
      </div>
    </footer>
    <script>
      // Read the current URL at activation because explorer controls update history in place.
      document.querySelector<HTMLAnchorElement>("[data-language-link]")?.addEventListener("click", (event) => {
        const link = event.currentTarget as HTMLAnchorElement;
        const target = new URL(link.href);
        target.search = location.search;
        target.hash = location.hash;
        link.href = target.href;
      });
      class SiteNavigation extends HTMLElement {
        connectedCallback() {
          const button = this.querySelector("button");
          if (!button) return;
          this.dataset.enhanced = "true";
          const close = () => {
            this.dataset.open = "false";
            button.setAttribute("aria-expanded", "false");
          };
          button.addEventListener("click", () => {
            const open = this.dataset.open === "true";
            this.dataset.open = String(!open);
            button.setAttribute("aria-expanded", String(!open));
          });
          this.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && this.dataset.open === "true") {
              close();
              button.focus();
            }
          });
          this.addEventListener("focusout", (event) => {
            if (!this.contains(event.relatedTarget as Node | null)) close();
          });
        }
      }

      if (!customElements.get("site-navigation")) {
        customElements.define("site-navigation", SiteNavigation);
      }
    </script>
  </body>
</html>
