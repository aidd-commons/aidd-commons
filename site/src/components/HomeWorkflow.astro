---
import { withSiteBase } from "../lib/site-paths";
import egfrStructure from "../assets/teaching/egfr-1m17.png";
import ScientificIcon from "./ScientificIcon.astro";
interface Props { chinese?: boolean; }
const { chinese = false } = Astro.props;
const local = (path: string) => withSiteBase(`${chinese ? "/zh-cn" : ""}${path}`, import.meta.env.BASE_URL);
const atlas = (path: string) => withSiteBase(path, import.meta.env.BASE_URL);
const stages = [
  {
    id: "target", label: chinese ? "靶点证据" : "Target evidence", subtitle: chinese ? "为什么是这个靶点？" : "Why this target?", kind: chinese ? "生物学问题" : "Biological question",
    title: chinese ? "从疾病语境形成可检验的靶点假设" : "Make a target hypothesis in its disease context",
    description: chinese ? "连接疾病表型、遗传学与扰动证据，检查替代解释，再决定需要哪一种独立验证。证据关联本身不构成因果证明。" : "Connect disease phenotype, genetics and perturbation evidence. Check competing explanations before choosing independent validation. An association alone does not establish causality.",
    objects: chinese ? [["语境", "疾病 · 细胞状态"], ["证据", "遗传学 + 扰动"], ["产物", "可被推翻的靶点假设"]] : [["Context", "Disease · cell state"], ["Evidence", "Genetics + perturbation"], ["Output", "Falsifiable target hypothesis"]],
    track: "mechanism-targets", lesson: "/learn/mechanism-targets/genetics-to-target-evidence/", lessonLabel: chinese ? "阅读靶点证据" : "Read target evidence", resource: "/atlas/?stage=target-discovery", resourceLabel: chinese ? "靶点资源 · 英文记录" : "Target resources",
  },
  {
    id: "structure", label: chinese ? "结构与表示" : "Structure & representation", subtitle: chinese ? "模型看到了什么对象？" : "What object does the model see?", kind: chinese ? "结构假设" : "Structural hypothesis",
    title: chinese ? "把序列、构建体和口袋状态放在同一语境" : "Keep sequence, construct and pocket state together",
    description: chinese ? "以 EGFR 为例，先识别蛋白、链与配体，再阅读结构条件和可信度。预测出的结构或接触不能直接证明亲和力与功能。" : "For an EGFR example, identify the protein, chain and ligand before reading structural conditions and confidence. A predicted structure or contact does not establish affinity or function.",
    objects: chinese ? [["对象", "EGFR · CHEMBL203"], ["表示", "序列 · 结构 · 口袋"], ["检查", "状态与构建体是否匹配？"]] : [["Object", "EGFR · CHEMBL203"], ["Representation", "Sequence · structure · pocket"], ["Check", "Do state and construct match?"]],
    track: "structure-and-pockets", lesson: "/learn/structure-and-pockets/pocket-states-and-confidence/", lessonLabel: chinese ? "阅读口袋与状态" : "Read pockets and states", resource: "/atlas/db-rcsb-pdb/", resourceLabel: chinese ? "RCSB PDB · 英文记录" : "RCSB PDB record",
  },
  {
    id: "activity", label: chinese ? "活性与筛选" : "Activity & screening", subtitle: chinese ? "这个分数能回答什么？" : "What can this score answer?", kind: chinese ? "端点与比较" : "Endpoint and comparison",
    title: chinese ? "先固定测定和化学单位，再比较表示" : "Fix the assay and chemical unit before comparing representations",
    description: chinese ? "从 ChEMBL 测定记录构造 parent 分子表，在相同划分和评价规则下比较基线。对接评分、测定活性与临床效果是不同的量。" : "Build a parent-molecule table from ChEMBL assay records and compare baselines under the same split and evaluation rules. Docking score, measured activity and clinical effect are different quantities.",
    objects: chinese ? [["输入", "分子 parent + 测定"], ["端点", "IC50 → pChEMBL"], ["比较", "基线 · 划分 · 误差"]] : [["Input", "Molecular parent + assay"], ["Endpoint", "IC50 → pChEMBL"], ["Comparison", "Baseline · split · error"]],
    track: "qsar-properties", lesson: "/learn/qsar-properties/regression-classification-errors/", lessonLabel: chinese ? "理解预测误差" : "Understand prediction error", resource: "/atlas/db-chembl-37/", resourceLabel: chinese ? "ChEMBL 37 · 英文记录" : "ChEMBL 37 record",
  },
  {
    id: "design", label: chinese ? "设计与反馈" : "Design & feedback", subtitle: chinese ? "下一次该测什么？" : "What should be measured next?", kind: chinese ? "约束下的决策" : "Constrained decision",
    title: chinese ? "把性质、合成约束和失败反馈带回设计" : "Bring properties, synthesis constraints and failed feedback back to design",
    description: chinese ? "候选分子的多目标分数需要与可测量性、预算和反馈延迟一起解释。一个更高的预测值，只有在明确的比较与限制下才有决策含义。" : "Interpret multiple objectives alongside measurability, budget and feedback delay. A higher predicted value becomes decision-relevant only within a declared comparison and its limits.",
    objects: chinese ? [["约束", "性质 · 合成 · 预算"], ["选择", "候选集 + 不确定性"], ["反馈", "测量 · 失败 · 更新"]] : [["Constraints", "Properties · synthesis · budget"], ["Selection", "Candidate set + uncertainty"], ["Feedback", "Measure · fail · update"]],
    track: "active-learning", lesson: "/learn/active-learning/experiment-pools-and-budgets/", lessonLabel: chinese ? "阅读实验池与预算" : "Read experiment pools and budgets", resource: "/atlas/?stage=lead-optimization", resourceLabel: chinese ? "优化资源 · 英文记录" : "Optimization resources",
  },
  {
    id: "nomination", label: chinese ? "候选决策" : "Candidate decision", subtitle: chinese ? "证据够支持哪一步？" : "Which next step does the evidence support?", kind: chinese ? "证据整合" : "Evidence integration",
    title: chinese ? "提交有边界的决策，而不把一个分数当成药物" : "Make a bounded decision with the missing evidence visible",
    description: chinese ? "把效力、选择性、暴露与安全性放进同一证据包，保留缺失字段和反证。综合项目训练的是决策推理，不声称已经发现或验证了新药。" : "Bring potency, selectivity, exposure and safety into one evidence package. Retain missing fields and counterevidence. The capstone teaches decision reasoning; it does not claim a newly discovered or validated drug.",
    objects: chinese ? [["证据包", "效力 · 选择性 · ADMET"], ["未解决", "缺失值 + 反证"], ["产物", "有条件的下一步决策"]] : [["Evidence package", "Potency · selectivity · ADMET"], ["Unresolved", "Missing values + counterevidence"], ["Output", "Conditional next-step decision"]],
    track: "candidate-nomination", lesson: "/learn/candidate-nomination/capstone-workbook/", lessonLabel: chinese ? "打开五案例工作簿" : "Open the five-case workbook", resource: "/atlas/?stage=candidate-nomination", resourceLabel: chinese ? "候选决策资源 · 英文记录" : "Candidate decision resources",
  },
];
const stageIcons = ["cell", "protein", "assay", "robot", "data"] as const;
const objectIcons = [
  ["cell", "data", "model"],
  ["protein", "molecule", "data"],
  ["molecule", "assay", "model"],
  ["molecule", "model", "robot"],
  ["assay", "data", "model"],
] as const;
---

<workflow-navigator class="discovery-workflow not-content" aria-labelledby="discovery-workflow-title">
  <div class="discovery-workflow__heading"><div><p class="eyebrow">{chinese ? "发现问题 → 可检查的决策" : "Discovery question → inspectable decision"}</p><h2 id="discovery-workflow-title">{chinese ? "在完整流程中定位你的问题" : "Put your question in the whole workflow"}</h2></div><span class="discovery-workflow__edition">{chinese ? "概念导览 · 可选步骤" : "Conceptual guide · select a step"}</span></div>
  <ol class="discovery-workflow__steps" aria-label={chinese ? "药物发现步骤" : "Drug discovery steps"}>
    {stages.map((stage, index) => <li><a href={`#workflow-${stage.id}`} data-workflow-tab={stage.id} id={`workflow-tab-${stage.id}`}><span class="discovery-workflow__number">{String(index + 1).padStart(2, "0")}</span><span class="discovery-workflow__stage-object"><ScientificIcon name={stageIcons[index]} size={82} /></span><span class="discovery-workflow__stage-label"><strong>{stage.label}</strong><small>{stage.subtitle}</small></span>{index < stages.length - 1 && <span class="discovery-workflow__step-arrow" aria-hidden="true">→</span>}</a></li>)}
  </ol>
  <div class="discovery-workflow__panels">
    {stages.map((stage, index) => <section id={`workflow-${stage.id}`} data-workflow-panel={stage.id} aria-labelledby={`workflow-tab-${stage.id}`} class="discovery-workflow__panel" tabindex="-1">
      <div class="discovery-workflow__explanation"><p class="discovery-workflow__kind"><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>{stage.kind}</p><h3>{stage.title}</h3><p>{stage.description}</p><div class="discovery-workflow__links"><a href={local(stage.lesson)}>{stage.lessonLabel}<span aria-hidden="true">↗</span></a><a href={local(`/learn/tracks/${stage.track}/`)}>{chinese ? "进入学习轨道" : "Open the learning track"}<span aria-hidden="true">→</span></a></div></div>
      <div class="discovery-workflow__object-view">{stage.id === "structure" && <figure class="discovery-workflow__structure"><img src={withSiteBase(egfrStructure.src, import.meta.env.BASE_URL)} width={egfrStructure.width} height={egfrStructure.height} alt={chinese ? "1M17 保留坐标的静态投影，显示 EGFR Cα 骨架与 erlotinib AQ4 重原子。" : "Static projection of retained 1M17 coordinates showing the EGFR Cα trace and erlotinib AQ4 heavy atoms."} loading="lazy" decoding="async" /><figcaption>{chinese ? "1M17 坐标投影；配体连线由几何启发式得到，不表示键级，也不是结合或功能验证。" : "1M17 coordinate projection. Ligand lines use a geometric heuristic, not bond orders; this is not binding or functional validation."}</figcaption></figure>}<p class="discovery-workflow__reading-label">{chinese ? "对象 → 检查 → 决策" : "Read the object → check → decision"}</p><ol aria-label={chinese ? "本步骤的对象与决策" : "Objects and decision in this step"}>{stage.objects.map(([label, object], position) => <li><span class="discovery-workflow__object-label">{label}</span><ScientificIcon name={objectIcons[index][position]} size={64} /><strong>{object}</strong>{position < stage.objects.length - 1 && <span class="discovery-workflow__object-arrow" aria-hidden="true">→</span>}</li>)}</ol><a class="discovery-workflow__resource" href={atlas(stage.resource)}>{stage.resourceLabel}<span aria-hidden="true">↗</span></a></div>
    </section>)}
  </div>
  <p class="discovery-workflow__boundary">{chinese ? "箭头表示阅读顺序，概念插图不代表实验观测。这是课程与资源的导航关系，不是已经执行或验证的药物发现流水线。各步骤保留自身的数据、协议与评价边界。" : "Arrows show reading order; conceptual illustrations are not observations. These are navigation relationships between lessons and resources, not an executed or validated discovery pipeline. Each step keeps its own data, protocol and evaluation boundary."}</p>
</workflow-navigator>

<script>
  class WorkflowNavigator extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLAnchorElement>("[data-workflow-tab]")];
      const panels = [...this.querySelectorAll<HTMLElement>("[data-workflow-panel]")];
      if (!tabs.length || tabs.length !== panels.length) return;
      const list = this.querySelector(".discovery-workflow__steps");
      list?.setAttribute("role", "tablist");
      list?.setAttribute("aria-orientation", matchMedia("(max-width: 580px)").matches ? "vertical" : "horizontal");
      const select = (tab: HTMLAnchorElement, focus = false, updateLocation = false) => {
        tabs.forEach((entry) => {
          const selected = entry === tab;
          entry.setAttribute("aria-selected", String(selected));
          entry.tabIndex = selected ? 0 : -1;
        });
        panels.forEach((panel) => { panel.hidden = panel.dataset.workflowPanel !== tab.dataset.workflowTab; });
        if (focus) tab.focus();
        if (updateLocation) {
          const url = new URL(location.href);
          url.hash = tab.hash;
          history.replaceState(null, "", url);
        }
      };
      tabs.forEach((tab, index) => {
        tab.setAttribute("role", "tab");
        tab.setAttribute("aria-controls", `workflow-${tab.dataset.workflowTab}`);
        tab.parentElement?.setAttribute("role", "presentation");
        tab.addEventListener("click", (event) => { event.preventDefault(); select(tab, false, true); });
        tab.addEventListener("keydown", (event) => {
          const direction = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : event.key === "ArrowLeft" || event.key === "ArrowUp" ? -1 : 0;
          const nextIndex = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : direction ? (index + direction + tabs.length) % tabs.length : -1;
          if (nextIndex < 0) return;
          event.preventDefault();
          select(tabs[nextIndex], true, true);
        });
      });
      panels.forEach((panel) => panel.setAttribute("role", "tabpanel"));
      this.dataset.enhanced = "true";
      const requested = tabs.find((tab) => tab.hash === location.hash);
      select(requested ?? tabs[0]);
    }
  }
  if (!customElements.get("workflow-navigator")) customElements.define("workflow-navigator", WorkflowNavigator);
</script>

<style>
  .discovery-workflow { display: block; color: var(--atlas-ink); background: var(--atlas-panel); border-block: 1px solid var(--atlas-rule-strong); }
  .discovery-workflow__heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.2rem 1.5rem; }
  .discovery-workflow .eyebrow { margin: 0 0 .4rem; font-size: .75rem; }
  .discovery-workflow h2 { margin: 0; font-size: clamp(1.15rem, 2vw, 1.5rem); letter-spacing: -.03em; }
  .discovery-workflow__edition { color: var(--atlas-muted); font-size: .75rem; text-align: right; }
  .discovery-workflow__steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; list-style: none; padding: .4rem 1rem 0; margin: 0; border-bottom: 1px solid var(--atlas-rule-strong); }
  .discovery-workflow__steps li { min-width: 0; position: relative; }
  .discovery-workflow__steps a { position: relative; display: grid; grid-template-rows: auto 88px 1fr; justify-items: center; gap: .35rem; height: 100%; padding: .65rem .7rem 1rem; border-bottom: 3px solid transparent; text-decoration: none; color: var(--atlas-ink); text-align: center; }
  .discovery-workflow__steps a[aria-selected="true"] { border-bottom-color: var(--atlas-teal); background: color-mix(in srgb, var(--atlas-teal) 5%, transparent); }
  .discovery-workflow__steps a:hover { background: var(--atlas-surface); }
  .discovery-workflow__steps a:focus-visible { outline: 3px solid var(--atlas-teal); outline-offset: -3px; }
  .discovery-workflow__number { font-family: var(--atlas-font-mono); color: var(--atlas-teal-deep); font-size: .75rem; }
  .discovery-workflow__stage-object { display: grid; align-items: center; }
  .discovery-workflow__steps strong { display: block; font-size: .82rem; line-height: 1.4; }
  .discovery-workflow__steps small { display: block; margin-top: .3rem; color: var(--atlas-muted); font-size: .75rem; line-height: 1.5; }
  .discovery-workflow__step-arrow { position: absolute; right: -.55rem; top: 4rem; z-index: 1; color: var(--atlas-ink); font-size: 1.2rem; }
  .discovery-workflow__panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 2rem; padding: 1.8rem 1.5rem; align-items: center; }
  .discovery-workflow__panel + .discovery-workflow__panel { border-top: 1px solid var(--atlas-rule); }
  .discovery-workflow[data-enhanced] .discovery-workflow__panel { border-top: 0; }
  .discovery-workflow__kind { display: flex; gap: .65rem; align-items: center; margin: 0 0 .9rem; color: var(--atlas-teal-deep); font-size: .75rem; font-weight: 650; letter-spacing: .05em; }
  .discovery-workflow__kind span { border-bottom: 1px solid var(--atlas-teal); padding: .18rem .2rem; font-family: var(--atlas-font-mono); }
  .discovery-workflow h3 { max-width: 28ch; margin: 0; font-size: clamp(1.25rem, 2.1vw, 1.7rem); font-weight: 650; letter-spacing: -.035em; line-height: 1.25; }
  .discovery-workflow__explanation > p:not(.discovery-workflow__kind) { max-width: 61ch; margin: 1rem 0; color: var(--atlas-muted); font-size: .87rem; line-height: 1.7; }
  .discovery-workflow__links { display: flex; gap: .5rem 1.25rem; flex-wrap: wrap; }
  .discovery-workflow__links a, .discovery-workflow__resource { display: inline-flex; justify-content: space-between; align-items: center; gap: .75rem; min-height: 44px; font-size: .78rem; font-weight: 650; }
  .discovery-workflow__object-view { min-width: 0; padding-left: 1.5rem; border-left: 1px solid var(--atlas-rule); }
  .discovery-workflow__reading-label { color: var(--atlas-muted); font-size: .75rem; margin: 0 0 .8rem; }
  .discovery-workflow__structure { margin: 0 0 1rem; }
  .discovery-workflow__structure img { display: block; width: 100%; height: 180px; object-fit: contain; background: #fffdf8; }
  .discovery-workflow__structure figcaption { margin-top: .4rem; color: var(--atlas-muted); font-size: .75rem; line-height: 1.5; }
  .discovery-workflow__object-view ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .discovery-workflow__object-view li { display: grid; position: relative; justify-items: center; align-content: start; gap: .45rem; min-width: 0; padding: .65rem 0; border-top: 1px solid var(--atlas-rule-strong); text-align: center; }
  .discovery-workflow__object-view li:last-child { border-top: 2px solid var(--atlas-teal); }
  .discovery-workflow__object-label { color: var(--atlas-muted); font-size: .75rem; letter-spacing: .04em; }
  .discovery-workflow__object-view strong { font-size: .8rem; font-weight: 600; line-height: 1.5; }
  .discovery-workflow__object-arrow { position: absolute; right: -1rem; top: 3rem; color: var(--atlas-ink); font-size: 1rem; }
  .discovery-workflow__resource { margin-top: .7rem; font-size: .75rem; }
  .discovery-workflow__boundary { margin: 0; padding: .85rem 1.5rem; border-top: 1px dashed var(--atlas-rule-strong); color: var(--atlas-muted); font-size: .75rem; line-height: 1.6; }
  [hidden] { display: none !important; }
  @media (max-width: 800px) { .discovery-workflow__panel { grid-template-columns: 1fr; gap: 1rem; } .discovery-workflow__object-view { border-left: 0; padding: 1rem 0 0; border-top: 1px solid var(--atlas-rule); } .discovery-workflow__structure img { height: 220px; } }
  @media (max-width: 580px) {
    .discovery-workflow__heading { align-items: flex-start; padding: 1rem; }
    .discovery-workflow__edition { max-width: 11ch; }
    .discovery-workflow__steps { grid-template-columns: 1fr; padding: 0; }
    .discovery-workflow__steps li + li { border-top: 1px solid var(--atlas-rule); }
    .discovery-workflow__steps a { grid-template-columns: 1.5rem 48px 1fr; grid-template-rows: auto; gap: .5rem; padding: .45rem 1rem; text-align: left; border-bottom: 0; border-left: 3px solid transparent; align-items: center; justify-items: start; }
    .discovery-workflow__steps a[aria-selected="true"] { border-left-color: var(--atlas-teal); }
    .discovery-workflow__stage-object { width: 48px; height: 48px; }
    .discovery-workflow__stage-object :global(.scientific-icon) { width: 48px; height: 48px; }
    .discovery-workflow__steps small { margin-top: .1rem; }
    .discovery-workflow__step-arrow { display: none; }
    .discovery-workflow__panel { padding: 1.25rem 1rem; }
    .discovery-workflow h3 { font-size: 1.4rem; }
    .discovery-workflow__object-view ol { gap: .75rem; }
    .discovery-workflow__object-arrow { right: -.8rem; }
    .discovery-workflow__boundary { padding: .8rem 1rem; }
  }
</style>
