---
import egfr from "../data/teaching/egfr-coordinates.json";
import rmd17 from "../data/teaching/rmd17-geometry.json";
import egfr1 from "../assets/teaching/egfr-1m17.png";
import egfr2 from "../assets/teaching/egfr-4hjo.png";
import egfr3 from "../assets/teaching/egfr-1xkk.png";
import frame0 from "../assets/teaching/rmd17-ethanol-0.png";
import frame50 from "../assets/teaching/rmd17-ethanol-50.png";
import frame100 from "../assets/teaching/rmd17-ethanol-100.png";
interface Props { kind: "egfr" | "rmd17"; chinese?:boolean }
const { kind, chinese = false } = Astro.props;
const structure = kind === "egfr";
const previews = structure ? [egfr1,egfr2,egfr3] : [frame0,frame50,frame100];
const states = structure ? egfr.entries.map((entry,i) => ({ id:entry.id, label:entry.id + " · " + entry.ligand_name, atoms:entry.atoms, links:entry.links, contacts:entry.contacts, preview:previews[i].src })) : rmd17.frames.map((frame,i)=>({id:String(frame.source_row),label:(chinese ? "源行 " : "Source row ") + frame.source_row,atoms:frame.atoms,links:frame.links,contacts:[],preview:previews[i].src}));
const prefix = "object-" + kind + "-" + crypto.randomUUID().slice(0, 8);
const scaleAngstrom = structure ? 10 : 1;
const staticScale = (atoms: typeof states[number]["atoms"]) => {
  const projected = atoms.map(atom => { const [x,y,z]=atom.xyz; const zz=-x*Math.sin(.65)+z*Math.cos(.65); return [x*Math.cos(.65)+z*Math.sin(.65),y*Math.cos(-.35)-zz*Math.sin(-.35)]; });
  const xs=projected.map(point=>point[0]),ys=projected.map(point=>point[1]);
  return Math.min(660/Math.max(Math.max(...xs)-Math.min(...xs),1),370/Math.max(Math.max(...ys)-Math.min(...ys),1));
};
const metadata = structure ? egfr.entries.map(entry=>`${entry.resolution_angstrom} Å · X-ray · RCSB PDB ${entry.id} · ${entry.retrieved_on}`) : rmd17.frames.map(frame=>(chinese?"乙醇 · 源行 ":"Ethanol · source row ")+frame.source_row+(chinese?" · 坐标单位 Å":" · coordinates in Å"));
---
<div class="science-object" data-science-object data-object-states={JSON.stringify(states.map((state,index)=>({...state,metadata:metadata[index],previewScalePercent:staticScale(state.atoms)*scaleAngstrom/760*100})))} data-object-kind={kind} data-scale-angstrom={scaleAngstrom} data-chinese={chinese ? "true":"false"}>
  <header class="science-object__heading"><p>{chinese?"实际来源坐标 · 几何检查":"Source-derived coordinates · geometry inspection"}</p><h3 data-object-title>{states[0].label}</h3><p data-object-metadata>{metadata[0]}</p></header>
  <div class="science-object__toolbar" hidden>
    <label>{structure ? (chinese ? "实验结构" : "Experimental entry") : (chinese ? "乙醇坐标帧" : "Ethanol coordinate frame")} <select data-object-select>{states.map((state,i)=><option value={i}>{state.label}</option>)}</select></label>
    <button type="button" data-object-enable aria-controls={prefix+"-controls"}>{chinese ? "开启坐标旋转" : "Enable coordinate rotation"}</button>
  </div>
  <div class:list={["science-object__stage", {"science-object__stage--structure":structure}]}>
    <img data-object-preview src={states[0].preview} width="760" height="440" alt={structure ? (chinese ? "1M17 的 EGFR Cα 主链轨迹和 erlotinib 配体重原子坐标的正交投影" : "Orthographic projection of the EGFR C-alpha trace and erlotinib heavy-atom coordinates in 1M17") : (chinese ? "rMD17 乙醇源行 0 的原子坐标正交投影" : "Orthographic projection of atomic coordinates in rMD17 ethanol source row 0")} loading="lazy" />
    <canvas data-object-canvas hidden width="1140" height="660" tabindex="0" role="img" aria-label={chinese ? "可旋转的实际坐标投影。方向键旋转，Home 重置；下方保留坐标滑块和数据表。" : "Rotatable projection of actual coordinates. Arrow keys rotate; Home resets. Degree sliders and data tables remain below."}></canvas>
    <div class="science-object__scale" data-object-scale style={`width:${staticScale(states[0].atoms)*scaleAngstrom/760*100}%`}><span>{scaleAngstrom} Å</span></div>
    <p class="science-object__projection">{chinese?"正交投影":"Orthographic projection"}</p>
  </div>
  {structure && <div class="science-object__contact-inspector" data-object-contact-inspector hidden>
    <p><span>{chinese ? "口袋局部 · 最短距离原子对" : "Pocket detail · nearest heavy-atom pair"}</span><strong data-object-distance></strong></p>
    <p data-object-pair></p>
    <div class="science-object__contact-list" data-object-contact-list role="group" aria-label={chinese ? "选择来源残基" : "Select a retained residue"}></div>
  </div>}
  <div id={prefix+"-controls"} class="science-object__controls" data-object-controls hidden>
    <div class="science-object__camera-row"><label for={prefix+"-yaw"}>{chinese ? "水平旋转，度" : "Horizontal rotation, degrees"}<output data-object-yaw-output for={prefix+"-yaw"}>35°</output></label><input id={prefix+"-yaw"} data-object-yaw type="range" min="-180" max="180" value="35" /></div>
    <div class="science-object__camera-row"><label for={prefix+"-pitch"}>{chinese ? "垂直旋转，度" : "Vertical rotation, degrees"}<output data-object-pitch-output for={prefix+"-pitch"}>−20°</output></label><input id={prefix+"-pitch"} data-object-pitch type="range" min="-90" max="90" value="-20" /></div>
    {structure && <label>{chinese ? "突出显示邻近残基" : "Highlight a nearby residue"} <select data-object-residue><option value="">{chinese ? "不突出显示残基" : "No residue highlighted"}</option>{egfr.entries[0].contacts.map((residue)=><option value={residue.chain+":"+residue.author_seq}>{residue.residue} {residue.reference_seq} · {residue.chain}</option>)}</select></label>}
    <label class="science-object__check"><input type="checkbox" data-object-labels checked={!structure} />{chinese?"显示原子名称":"Show atom names"}</label>
    <button type="button" data-object-reset>{chinese?"重置观察方向":"Reset view"}</button>
    <p class="science-object__interaction-help">{chinese?"拖动坐标图或使用滑块；整体与局部使用相同观察方向。方向键旋转，Home 重置；没有自动播放。":"Drag the projection or use the sliders; context and detail share one camera. Arrow keys rotate; Home resets. The view does not autoplay."}</p>
  </div>
  <ul class="science-object__element-key" aria-label={chinese?"元素图例":"Element key"}><li><i class="element-c" />C · {chinese?"碳":"carbon"}</li>{structure&&<li><i class="element-n" />N · {chinese?"氮":"nitrogen"}</li>}<li><i class="element-o" />O · {chinese?"氧":"oxygen"}</li>{!structure&&<li><i class="element-h" />H · {chinese?"氢":"hydrogen"}</li>}</ul>
  <p class="science-object__key">{structure ? (chinese ? "细线：实验模型中的 Cα 轨迹，缺失区段断开。圆点：配体重原子；连线采用既有检查器的几何启发式，不显示键级。N 为蓝色，O 为红色，C 为灰色。" : "Thin lines: the experimental model's C-alpha trace, with missing stretches left open. Dots: ligand heavy atoms; connections use the existing inspector's geometric heuristic without bond orders. N is blue, O red and C gray.") : (chinese ? "坐标单位为 Å。源行号没有时间单位，图中未显示能量或预测；灰线仅连接距离小于 1.7 Å 的原子对，是距离辅助线。" : "Coordinates are in Å. Source row numbers carry no time unit; no energies or predictions are shown. Gray lines are distance guides between atom pairs less than 1.7 Å apart.")}</p>
  {!structure && <p class="science-object__source"><a href="https://doi.org/10.6084/m9.figshare.12672038.v4">rMD17 version 4</a> · CC0 · {chinese?"准备日期":"prepared"} {rmd17.prepared_on}. {chinese?"三帧仅作几何示例；不声明分区成员或时间间隔。":"The three frames illustrate geometry; no partition membership or time spacing is declared."}</p>}
  <p data-object-status role="status" class="science-object__status">{chinese ? "静态投影可直接阅读。旋转只改变观察方向。" : "The static projection is readable without scripting. Rotation changes only the viewing direction."}</p>
  <details class="science-object__fallback">
    <summary>{chinese ? "结构、来源与数据表" : "Structures, sources and data tables"}</summary>
    {structure ? egfr.entries.map((entry)=><section><h4>{entry.id} · {entry.ligand_name}</h4><p>{chinese ? "X 射线结构分辨率" : "X-ray resolution"}: {entry.resolution_angstrom} Å · <a href={entry.source_url}>RCSB PDB {entry.id}</a> · {entry.retrieved_on} · CC0</p><p>{entry.primary_citation.title} {entry.primary_citation.year}. {entry.primary_citation.pdbx_database_id_PubMed && <a href={"https://pubmed.ncbi.nlm.nih.gov/"+entry.primary_citation.pdbx_database_id_PubMed+"/"}>PubMed</a>}</p><div class="science-object__scroll" tabindex="0" role="region" aria-label={entry.id+(chinese ? "接触距离表":" contact-distance table")}><table><caption>{chinese ? "任意配体重原子至残基重原子的最短距离 ≤ 5 Å。距离不是氢键或亲和力。" : "Minimum distance from any ligand heavy atom to a residue heavy atom ≤ 5 Å. Distance is not a hydrogen bond or affinity."}</caption><thead><tr><th scope="col">{chinese ? "残基" : "Residue"}</th><th scope="col">{chinese ? "链 / 作者编号" : "Chain / author number"}</th><th scope="col">P00533</th><th scope="col">{chinese ? "最短距离，Å" : "Minimum distance, Å"}</th></tr></thead><tbody>{entry.contacts.map((contact)=><tr data-contact-row={entry.id+":"+contact.chain+":"+contact.author_seq}><th scope="row">{contact.residue}</th><td>{contact.chain} / {contact.author_seq}</td><td>{contact.reference_seq}</td><td>{contact.minimum_distance_angstrom.toFixed(3)}</td></tr>)}</tbody></table></div><div class="science-object__scroll" tabindex="0" role="region" aria-label={entry.id+(chinese?"配体原子坐标表":" ligand atom-coordinate table")}><table><caption>{chinese?"配体重原子的实际坐标，Å；几何辅助线不指派键级。":"Actual ligand heavy-atom coordinates, Å; geometric guides do not assign bond orders."}</caption><thead><tr><th scope="col">{chinese?"原子":"Atom"}</th><th scope="col">x, Å</th><th scope="col">y, Å</th><th scope="col">z, Å</th></tr></thead><tbody>{entry.atoms.filter(atom=>atom.kind==="ligand").map(atom=><tr><th scope="row">{atom.element} · {atom.name}</th>{atom.xyz.map(value=><td>{value}</td>)}</tr>)}</tbody></table></div></section>) : rmd17.frames.map((frame)=><section><h4>{chinese ? "源行" : "Source row"} {frame.source_row}</h4><table><caption>{chinese ? "实际源坐标，Å；仅作几何示例，与冻结的分区成员表无关。" : "Actual source coordinates, Å; geometry illustration, separate from frozen partition membership."}</caption><thead><tr><th scope="col">{chinese ? "原子" : "Atom"}</th><th scope="col">x, Å</th><th scope="col">y, Å</th><th scope="col">z, Å</th></tr></thead><tbody>{frame.atoms.map((atom)=><tr><th scope="row">{atom.element}{atom.name}</th>{atom.xyz.map(value=><td>{value}</td>)}</tr>)}</tbody></table></section>)}
  </details>
</div>
<script>
  import { initializeScientificObjects } from "../scripts/scientific-objects";
  function initializeObjectViews() {
    initializeScientificObjects();
    document.querySelectorAll<HTMLElement>("[data-science-object] .science-object__toolbar").forEach(toolbar => { toolbar.hidden = false; });
  }
  initializeObjectViews();
  document.addEventListener("astro:page-load", initializeObjectViews);
</script>
<style>
  .science-object [hidden]{display:none!important}
  .science-object__scroll tr.is-selected{background:color-mix(in srgb,var(--atlas-teal) 14%,var(--atlas-panel))!important;box-shadow:inset 3px 0 var(--atlas-teal-deep)}
  .science-object__scroll{max-height:24rem;overscroll-behavior:contain}
  .science-object__scroll thead th{position:sticky;top:0;z-index:2;background:var(--atlas-bg);box-shadow:0 1px var(--atlas-rule)}
  .science-object__scroll tbody tr:nth-child(even){background:color-mix(in srgb,var(--atlas-rule) 24%,transparent)}
  .science-object__fallback>section{padding-bottom:.7rem;border-bottom:1px solid var(--atlas-rule)}
  .science-object{min-width:0;color:var(--atlas-ink)}.science-object__heading{padding:.75rem 0;border-top:1px solid var(--atlas-rule)}.science-object__heading>p:first-child{font-size:.75rem;color:var(--atlas-teal-deep);font-weight:650;margin:0 0 .35rem}.science-object__heading h3{font-size:1.1rem;margin:0}.science-object__heading>p:last-child{font-size:.75rem;color:var(--atlas-muted);margin:.35rem 0 0;overflow-wrap:anywhere}
  .science-object__toolbar{display:flex;flex-wrap:wrap;align-items:end;gap:.6rem;margin:.75rem 0}.science-object label{display:flex;flex-direction:column;gap:.4rem;font-size:.78rem;min-width:0}.science-object__toolbar label{flex:1}.science-object select,.science-object button{font:inherit;min-height:44px;max-width:100%;border:1px solid var(--atlas-rule-strong);border-radius:0;background:var(--atlas-bg);color:var(--atlas-ink);padding:.45rem .65rem}.science-object button{cursor:pointer;font-size:.78rem}.science-object button:focus-visible,.science-object select:focus-visible,.science-object input:focus-visible,.science-object canvas:focus-visible,.science-object summary:focus-visible,.science-object__scroll:focus-visible{outline:3px solid var(--atlas-teal-deep);outline-offset:3px}
  .science-object__contact-inspector{padding:.75rem 0;border-bottom:1px solid var(--atlas-rule)}.science-object__contact-inspector>p{display:flex;justify-content:space-between;gap:.5rem;margin:0;font-size:.76rem;line-height:1.5}.science-object__contact-inspector>p:first-child span{color:var(--atlas-muted)}.science-object__contact-inspector strong{font-size:1.15rem;white-space:nowrap;font-variant-numeric:tabular-nums}.science-object__contact-inspector>p:nth-child(2){color:var(--atlas-muted);margin-top:.25rem;overflow-wrap:anywhere}.science-object__contact-list{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.7rem}.science-object__contact-list :global(button){min-height:44px;font:inherit;font-size:.75rem;padding:.3rem .5rem;background:var(--atlas-bg);color:var(--atlas-ink);border:1px solid var(--atlas-rule);border-radius:0;cursor:pointer;white-space:nowrap}.science-object__contact-list :global(button[aria-pressed="true"]){background:var(--atlas-ink);color:var(--atlas-panel);border-color:var(--atlas-ink)}
  .science-object__stage{position:relative;background:var(--atlas-panel);aspect-ratio:760/440;overflow:hidden;border-block:1px solid var(--atlas-rule)}.science-object__stage img,.science-object__stage canvas{display:block;width:100%;height:100%;object-fit:contain;margin:0}.science-object__stage [hidden]{display:none}.science-object__stage canvas{touch-action:none;cursor:grab}.science-object__stage canvas:active{cursor:grabbing}.science-object__scale{position:absolute;right:1rem;bottom:1.3rem;border-bottom:2px solid #344653;height:.4rem;border-inline:1px solid #344653;pointer-events:none}.science-object__scale span{position:absolute;right:0;bottom:.45rem;white-space:nowrap;font:600 12px system-ui;color:#263c49;background:#f8fafb;padding:0 2px}.science-object__projection{position:absolute;top:.6rem;right:.75rem;margin:0;color:#485e6b;font:12px system-ui;pointer-events:none}
  .science-object__controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem .8rem;align-items:end;padding:.7rem 0;border-bottom:1px solid var(--atlas-rule)}.science-object__controls[hidden]{display:none}.science-object__camera-row{min-width:0}.science-object__camera-row label{display:flex;flex-direction:row;justify-content:space-between;gap:.7rem;font-size:.75rem;margin-bottom:.4rem}.science-object__camera-row output{white-space:nowrap;font-variant-numeric:tabular-nums}.science-object input[type=range]{width:100%;min-height:24px;accent-color:var(--atlas-teal-deep);margin:0}.science-object__controls .science-object__check{flex-direction:row;align-items:center;gap:.6rem;min-height:44px}.science-object__check input{width:1rem;height:1rem;accent-color:var(--atlas-teal-deep)}.science-object__interaction-help{grid-column:1/-1;font-size:.75rem;margin:.1rem 0;color:var(--atlas-muted)}
  .science-object__element-key{display:flex;flex-wrap:wrap;gap:.5rem 1rem;list-style:none;margin:.8rem 0!important;padding:0!important;font-size:.75rem}.science-object__element-key li{display:flex;align-items:center;gap:.4rem;margin:0}.science-object__element-key i{width:.65rem;height:.65rem;border-radius:50%;border:1px solid #344653}.element-c{background:#4b606c}.element-n{background:#345f9e}.element-o{background:#b94e54}.element-h{background:#eef2f4}
  .science-object__key,.science-object__source,.science-object__status{font-size:.75rem;color:var(--atlas-muted);line-height:1.6;margin:.6rem 0}.science-object__status{padding:.6rem 0;border-block:1px solid var(--atlas-rule);color:var(--atlas-ink);min-height:2.6rem}.science-object__fallback{font-size:.8rem}.science-object__fallback summary{font-weight:600;cursor:pointer;min-height:44px;padding:.7rem 0}.science-object__fallback h4{font-size:.95rem;margin:1rem 0 .4rem}.science-object__fallback table{display:table;font-size:.75rem;width:100%;font-variant-numeric:tabular-nums}.science-object__fallback caption{text-align:left;margin:.6rem 0;color:var(--atlas-muted)}.science-object__fallback th,.science-object__fallback td{padding:.55rem;white-space:nowrap}.science-object__scroll{overflow:auto;max-width:100%}
  .science-object__contact-list :global(button:focus-visible){outline:3px solid var(--atlas-teal-deep);outline-offset:2px}
  @media(max-width:36rem){.science-object__stage--structure.is-interactive{aspect-ratio:760/1000}.science-object__contact-list{flex-wrap:nowrap;overflow-x:auto;padding:.3rem .2rem .6rem;scroll-snap-type:x proximity;overscroll-behavior-x:contain}.science-object__contact-list :global(button){flex:0 0 auto;scroll-snap-align:start}}

  @media(max-width:30rem){.science-object__controls{grid-template-columns:minmax(0,1fr)}.science-object__interaction-help{grid-column:auto}.science-object__toolbar button{width:100%}.science-object__projection{font-size:12px}.science-object__scale{right:.7rem;bottom:1rem}}
</style>
