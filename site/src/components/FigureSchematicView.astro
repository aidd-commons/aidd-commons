---
import type {ImageMetadata} from 'astro';
import {withSiteBase} from '../lib/site-paths';
import type {FigureData} from '../lib/figure-detail';
interface Props{data:FigureData;chinese?:boolean}
const {data:d,chinese=false}=Astro.props;const t=(en:string,zh:string)=>chinese?zh:en;
const assets=import.meta.glob<{default:ImageMetadata}>('../assets/editorial/*.png',{eager:true});
const image=(id:string)=>assets[`../assets/editorial/${id}.png`]?.default.src;
const href=(path:string)=>withSiteBase(`${chinese?'/zh-cn':''}${path}`,import.meta.env.BASE_URL);
const dims=d.dimensionNames??['Inference code','Training code','Weights','Architecture','Data recipe','Training data','Evaluation code'];
---
<div class={`figure-schematic figure-schematic--${d.key}`}>
 {d.key==='S1'&&<><div class="figure-schematic__artifacts">{d.artifacts.map((a:any,i:number)=><section data-figure-step-item={i}><span class="figure-schematic__number">0{i+1}</span>{i===1||i===2?<img src={image(i===1?'data':'model')} alt="" loading="lazy"/>:<div class="figure-schematic__document" aria-hidden="true"><i/><i/><i/></div>}<h3><a href={href(`/${['learn','atlas','labs','report'][i]}/`)}>{a.name}</a></h3><p>{a.role}</p><small>Shared resource identity</small></section>)}</div><div class="figure-schematic__rail"><strong>Shared resource ID</strong><span>↔ Learn ↔ Atlas ↔ Labs ↔ Report</span></div><p class="figure-schematic__relation">↶ {t('Source-backed correction → every affected artifact','有来源支持的纠错 → 每个受影响产物')}</p></>}
 {d.key==='S2'&&<div class="figure-schematic__classes">{d.statementClasses.map((c:any,i:number)=><section class:list={[{'is-unresolved':i>1}]}><span class="figure-schematic__number">({String.fromCharCode(97+i)})</span><h3>{c.name}</h3><strong>{c.status}</strong><p>{c.source}</p></section>)}</div>}
 {(d.key==='S3'||d.key==='S4')&&<><nav class="figure-schematic__stage-nav" aria-label={t('Discovery stages','发现阶段')}>{d.stages.map((s:any,i:number)=><a href={`#stage-${i+1}`}>{i+1}<span>{s.name}</span></a>)}</nav><ol class="figure-schematic__stages">{d.stages.map((s:any,i:number)=><li id={`stage-${i+1}`} data-figure-step-item={i}>
 <div class="figure-schematic__stage-header"><span class="figure-schematic__number">{String(i+1).padStart(2,'0')}</span><h3>{s.name}</h3></div>
 {d.key==='S3'&&image(s.asset)&&<img src={image(s.asset)} alt="" loading="lazy"/>}
 {d.key==='S3'?<><p class="figure-schematic__decision">{s.decision}</p><dl><dt>Strong cheap baseline</dt><dd>{s.baseline}</dd><dt class="failure">Frequent failure</dt><dd class="failure">{s.failure}</dd></dl></>:<><p>{s.decision}</p><ul class="figure-schematic__fields">{s.fields.map((f:string)=><li><span aria-hidden="true">□</span>{f}</li>)}</ul><p class="figure-schematic__required">Required records · not completed measurements</p></>}
 </li>)}</ol></>}
 {d.key==='S5'&&<div data-schematic-selector><label class="figure-schematic__selector" data-schematic-filter-control hidden>{t('Focus a learning route','聚焦学习路径')}<select data-schematic-filter><option value="all">{t('All routes','所有路径')}</option>{d.routes.map((r:any)=><option value={r.id}>{r.id}</option>)}</select></label><div class="figure-schematic__routes">{d.routes.map((r:any)=><section data-schematic-route={r.id}><h3><a href={href(`/learn/#learning-route-${r.id}`)}>{r.id}</a><span>{r.count} lessons</span></h3>{r.prerequisites.length?<ul>{d.prerequisiteLessons.filter((l:any)=>r.prerequisites.includes(l.id)).map((l:any)=><li><a href={href(`/learn/${l.id}/`)}>{l.alias}</a>{l.inCore&&<small>Also included in core</small>}</li>)}</ul>:<p>No stated prerequisites</p>}</section>)}</div></div>}
 {d.key==='S6'&&<div class="figure-schematic__openness">{d.resources.map((r:any,i:number)=><section><div class="figure-schematic__record"><img src={image(i===0?'model':'data')} alt="" loading="lazy"/><div><h3><a href={href(`/atlas/${r.id}/`)}>{r.name??r.id}</a></h3><p>{r.kind} · {r.lifecycle} · {r.access}</p><small>Source record reviewed {r.last_verified}</small></div></div><dl>{r.states.map((state:string,j:number)=><div><dt>{dims[j]}</dt><dd data-openness-state={state}><span aria-hidden="true">{{available:'+',not_available:'×',not_applicable:'–',unverified:'?'}[state]}</span>{state.replaceAll('_',' ')}</dd></div>)}</dl><div class="figure-schematic__source"><p>{r.source}</p>{r.dimensions?.map((dim:any)=><details><summary>{dim.name} · {t('source evidence','来源证据')}</summary><ul>{dim.evidence.map((e:any)=><li>{e.url?<a href={e.url}>{e.label??e.title??e.url}</a>:<span>{e.title??e.repository_path??e.evidence_id}</span>}</li>)}</ul></details>)}</div></section>)}</div>}
 {d.key==='S7'&&<><ol class="figure-schematic__lifecycle">{d.lifecycle.map((s:any,i:number)=><li data-figure-step-item={i}><span class="figure-schematic__number">{s.order}</span><h3>{s.name}</h3><p>{[t('Fix the protocol before evaluation','评估前固定协议'),t('Check structure using training and validation data','使用训练与验证数据检查结构'),t('Confirm finite outputs before test opening','测试开启前确认输出有限'),t('Open the test set once','仅开启测试集一次'),t('Retain observations and limitations','保留观察结果与限制')][i]}</p>{i<4&&<span class="figure-schematic__arrow" aria-hidden="true">→</span>}</li>)}</ol><div class="figure-schematic__boundary"><p>↶ {t('Pretests → development only before test opening','预检 → 仅在测试开启前返回开发')}</p><p>× {t('Bug found after opening → protocol-invalidating error; no result-driven retuning','开启后发现错误 → 协议失效；禁止按结果重新调参')}</p></div></>}
 <p class="figure-schematic__conceptual">{t('Illustrations are conceptual. Native diagram labels and relations are retained in the source table and original figure.','插图为概念图。原生图件的标签与关系完整保留在来源表和原图中。')}</p>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-schematic-selector]').forEach(root=>{const select=root.querySelector<HTMLSelectElement>('[data-schematic-filter]')!;root.querySelector<HTMLElement>('[data-schematic-filter-control]')!.hidden=false;select.addEventListener('change',()=>root.querySelectorAll<HTMLElement>('[data-schematic-route]').forEach(r=>r.hidden=select.value!=='all'&&r.dataset.schematicRoute!==select.value));});
</script>
<style>
.figure-schematic{min-width:0}.figure-schematic h3{font-size:1rem;line-height:1.4;margin:.4rem 0}.figure-schematic p{font-size:.85rem;line-height:1.6}.figure-schematic img{width:100%;height:100px;object-fit:contain;margin:.5rem 0}.figure-schematic__document{height:100px;width:72px;border:2px solid var(--atlas-teal-deep);padding:1rem .6rem;margin:.5rem auto;display:grid;align-content:center;gap:.5rem}.figure-schematic__document i{height:3px;width:100%;background:var(--atlas-teal-deep)}.figure-schematic__document i:last-child{width:65%}.figure-schematic__number{color:var(--atlas-teal-deep);font-size:.8rem;font-weight:700;font-variant-numeric:tabular-nums}.figure-schematic__artifacts,.figure-schematic__classes{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,12rem),1fr));gap:1rem}.figure-schematic__artifacts>section,.figure-schematic__classes>section{border-top:3px solid var(--atlas-teal-deep);padding:.7rem 0}.figure-schematic__artifacts small{color:var(--atlas-muted);font-size:.75rem}.figure-schematic__rail{display:flex;justify-content:center;flex-wrap:wrap;gap:.5rem 1rem;padding:.75rem;border-block:1px solid var(--atlas-teal-deep);margin:1rem 0;font-size:.8rem}.figure-schematic__relation{border-bottom:1px dashed var(--atlas-coral);padding-bottom:.5rem}.figure-schematic__classes .is-unresolved{border-top-style:dashed}.figure-schematic__classes strong{font-size:.8rem;color:var(--atlas-teal-deep)}.figure-schematic__stage-nav{display:flex;gap:.3rem;overflow-x:auto;padding:.5rem 0 1rem;margin-bottom:.5rem}.figure-schematic__stage-nav a{position:relative;min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;border:1px solid var(--atlas-rule);font-size:.8rem}.figure-schematic__stage-nav span{position:absolute;left:0;top:0;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.figure-schematic__stages{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr));gap:1.2rem}.figure-schematic__stages>li{border-top:2px solid var(--atlas-teal-deep);padding:.6rem .25rem;scroll-margin-top:6rem;min-width:0}.figure-schematic__stage-header{display:flex;gap:.6rem;align-items:baseline}.figure-schematic__decision{font-weight:650}.figure-schematic dl{font-size:.8rem;margin:.5rem 0;line-height:1.6}.figure-schematic dt{font-weight:650}.figure-schematic dd{margin:0 0 .6rem}.failure{color:color-mix(in srgb,var(--atlas-emphasis) 85%,var(--atlas-ink))}.figure-schematic__fields{list-style:none;margin:.5rem 0;padding:0;display:grid;gap:.5rem}.figure-schematic__fields li{display:flex;gap:.4rem;font-size:.85rem}.figure-schematic__fields span{color:var(--atlas-teal-deep)}.figure-schematic__required,.figure-schematic__conceptual,.figure-schematic__source{font-size:.75rem!important;color:var(--atlas-muted);overflow-wrap:anywhere}.figure-schematic__selector{display:grid;gap:.5rem;font-size:.8rem;margin-bottom:1rem}.figure-schematic select{min-height:44px;max-width:100%;background:var(--atlas-panel);color:var(--atlas-ink);border:1px solid var(--atlas-rule);padding:.5rem}.figure-schematic__routes{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr));gap:1rem}.figure-schematic__routes>section{border-top:2px solid var(--atlas-teal-deep);padding-top:.5rem}.figure-schematic__routes h3{display:flex;justify-content:space-between;gap:.5rem}.figure-schematic__routes h3 span{font-size:.75rem;font-weight:400;white-space:nowrap}.figure-schematic__routes ul{padding-left:1.2rem;font-size:.85rem;line-height:1.6}.figure-schematic__routes small{display:block;color:var(--atlas-muted);font-size:.7rem}.figure-schematic__openness{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));gap:1.5rem}.figure-schematic__record{display:flex;align-items:center;gap:.75rem}.figure-schematic__record img{width:70px;height:70px}.figure-schematic__record p,.figure-schematic__record small{font-size:.75rem;overflow-wrap:anywhere}.figure-schematic__openness dl>div{display:flex;justify-content:space-between;gap:.6rem;border-top:1px solid var(--atlas-rule);padding:.5rem 0}.figure-schematic__openness dd{display:flex;gap:.4rem;margin:0;text-align:right}.figure-schematic__openness dd>span{width:1.1rem;text-align:center;font-weight:700}.figure-schematic__lifecycle{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,10rem),1fr));gap:1rem;margin:0;padding:0}.figure-schematic__lifecycle>li{position:relative;border-top:2px solid var(--atlas-teal-deep);padding:.7rem .25rem}.figure-schematic__arrow{display:block;color:var(--atlas-teal-deep);font-size:1.5rem}.figure-schematic__boundary{border-top:1px dashed var(--atlas-coral);margin-top:1rem}.figure-schematic :global(.is-current-step){outline:2px solid var(--atlas-teal-deep);outline-offset:5px;background:color-mix(in srgb,var(--atlas-teal) 7%,transparent)}
</style>
